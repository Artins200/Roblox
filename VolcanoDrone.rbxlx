		Color3.fromRGB(30, 32, 42))
	backBtn.Position = UDim2.fromScale(0.42, 0.77)
	backBtn.MouseButton1Click:Connect(function()
		self:showRolePicker(false)
	end)

	self:selectRole("auto")

	-- ------------------------------------------------------------- верхняя панель
	local top = Instance.new("Frame")

		Enum.Font.GothamBlack)
	self.topTimer.Position = UDim2.fromScale(0.69, 0.06)
	self.topInfo = label(top, "", UDim2.fromScale(0.94, 0.3), MUTED, Enum.Font.GothamMedium)
	self.topInfo.Position = UDim2.fromScale(0.03, 0.56)

	-- ------------------------------------------------------------- итоги раунда
	local result = Instance.new("Frame")
	result.Name = "Result"
	result.Size = UDim2.fromScale(1, 0.28)
	result.Position = UDim2.fromScale(0, 0.36)
	result.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
	result.BackgroundTransparency = 0.25
	result.BorderSizePixel = 0
	result.Visible = false
	result.Parent = gui
	self.resultFrame = result
	local rGrad = Instance.new("UIGradient")
	rGrad.Rotation = 90
	rGrad.Color = ColorSequence.new(Color3.fromRGB(60, 20, 12), Color3.fromRGB(12, 12, 16))
	rGrad.Parent = result

	self.resultText = label(result, "ПОБЕДА", UDim2.fromScale(0.9, 0.5), TEXT,
		Enum.Font.GothamBlack)
	self.resultText.Position = UDim2.fromScale(0.05, 0.1)
	self.resultSub = label(result, "", UDim2.fromScale(0.9, 0.22), MUTED,
		Enum.Font.GothamMedium)
	self.resultSub.Position = UDim2.fromScale(0.05, 0.66)

	-- ------------------------------------------------------------- таблица счёта
	local score = Instance.new("Frame")
	score.Name = "Scoreboard"
	score.Size = UDim2.fromScale(0.6, 0.6)
	score.Position = UDim2.fromScale(0.2, 0.18)
	score.BackgroundColor3 = Color3.fromRGB(10, 10, 16)
	score.BackgroundTransparency = 0.08
	score.BorderSizePixel = 0
	score.Visible = false
	score.Parent = gui
	corner(score, 14)
	stroke(score, ACCENT2, 2, 0.4)
	self.scoreFrame = score

	local scoreTitle = label(score, "ТАБЛИЦА", UDim2.new(1, -20, 0, 34), ACCENT2,
		Enum.Font.GothamBlack)
	scoreTitle.Position = UDim2.fromOffset(10, 8)

	local header = label(score, "ИГРОК              РОЛЬ        К   С   ОЧКИ",
		UDim2.new(1, -20, 0, 22), MUTED, Enum.Font.Code)
	header.Position = UDim2.fromOffset(10, 44)

	local rows = Instance.new("Frame")
	rows.BackgroundTransparency = 1
	rows.Size = UDim2.new(1, -20, 1, -76)
	rows.Position = UDim2.fromOffset(10, 70)
	rows.Parent = score
	local rowsLayout = Instance.new("UIListLayout")
	rowsLayout.Padding = UDim.new(0, 3)
	rowsLayout.Parent = rows
	self.scoreRows = rows

	return self
end

-- --------------------------------------------------------------------------- --
function MenuUI:selectRole(roleId)
	self.selectedRole = roleId
	for id, card in pairs(self.roleCards) do
		local active = (id == roleId)
		card.stroke.Color = active and ACCENT or ACCENT2
		card.stroke.Thickness = active and 3 or 2
		card.button.BackgroundColor3 = active and Color3.fromRGB(40, 26, 18)
			or Color3.fromRGB(18, 19, 26)
	end
end

function MenuUI:showRolePicker(value)
	self.roleFrame.Visible = value
	self.backdrop.Visible = not value
end

function MenuUI:votingVisible(value)
	self.cardsFrame.Visible = value
	self.voteHint.Visible = value
end

-- --------------------------------------------------------------------------- --
function MenuUI:update(snap, mine)
	if not snap then
		return
	end
	self.snapshot = snap
	self.mine = mine
	local mode = modeById(snap.mode)
	local map = mapById(snap.mapId)

	-- верхняя панель
	local phaseName = "МЕНЮ"
	if snap.phase == "Vote" then
		phaseName = "ГОЛОСОВАНИЕ"
	elseif snap.phase == "Round" then
		phaseName = mode.Title
	elseif snap.phase == "End" then
		phaseName = "ИТОГИ"
	end
	self.topPhase.Text = phaseName
	self.topTimer.Text = formatTime(snap.timeLeft)
	self.topTimer.TextColor3 = (snap.timeLeft or 0) &lt;= 10 and Color3.fromRGB(255, 120, 110) or TEXT
	self.topInfo.Text = "КАРТА: " .. map.Title .. "    •    ИГРОКОВ: " .. tostring(#snap.players)

	-- карточки режимов
	local total = math.max(1, snap.voteTotal or 0)
	for modeId, card in pairs(self.modeCards) do
		local count = (snap.votes and snap.votes[modeId]) or 0
		card.votesText.Text = tostring(count)
		card.bar.Size = UDim2.fromScale(math.clamp(count / total, 0, 1), 1)
		-- подсветка своего голоса
		local voted = false
		for _, p in ipairs(snap.players or {}) do
			if p.userId == Players.LocalPlayer.UserId and p.vote == modeId then
				voted = true
			end
		end
		card.stroke.Color = voted and Color3.fromRGB(255, 255, 255) or card.mode.Color
		card.stroke.Thickness = voted and 3 or 2
	end

	-- что показываем
	local inRound = (snap.phase == "Round")
	local playing = inRound and mine and mine.role and mine.role ~= "spectator"
	local waiting = inRound and not playing

	if playing then
		self.backdrop.Visible = false
		self.roleFrame.Visible = false
	else
		self.backdrop.Visible = not self.roleFrame.Visible
		self:showRolePicker(self.roleFrame.Visible)
	end

	-- итоги
	if snap.phase == "End" and snap.result and snap.result ~= "" then
		self.resultFrame.Visible = true
		self.resultText.Text = snap.result
		self.resultSub.Text = "СЛЕДУЮЩЕЕ ГОЛОСОВАНИЕ ЧЕРЕЗ " .. formatTime(snap.timeLeft) ..
			"   •   НОВАЯ КАРТА БУДЕТ СЛУЧАЙНОЙ"
	else
		self.resultFrame.Visible = false
	end

	-- статус под кнопкой
	if waiting then
		self.statusLabel.Text = "РАУНД ИДЁТ: " .. mode.Title .. "  •  НАЖМИТЕ «НАЧАТЬ ИГРУ», ЧТОБЫ ВОЙТИ"
		self.startBtn.Text = "ВОЙТИ В РАУНД"
	elseif snap.phase == "Vote" then
		self.statusLabel.Text = "ВЫБЕРИТЕ РЕЖИМ ГОЛОСОМ  •  КАРТА: " .. map.Title ..
			"  •  ГОЛОСОВ: " .. tostring(snap.voteTotal or 0)
		self.startBtn.Text = "НАЧАТЬ ИГРУ"
	else
		self.statusLabel.Text = "ИГРОКОВ В ИГРЕ: " .. tostring(#(snap.players or {})) ..
			"  •  РЕЖИМ: " .. mode.Title
		self.startBtn.Text = "НАЧАТЬ ИГРУ"
	end

	self:votingVisible(snap.phase == "Vote")

	-- таблица счёта
	if self.scoreFrame.Visible then
		self:renderScore(snap)
	end
end

function MenuUI:renderScore(snap)
	for _, child in ipairs(self.scoreRows:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local sorted = table.clone(snap.players or {})
	table.sort(sorted, function(a, b)
		if (a.kills or 0) ~= (b.kills or 0) then
			return (a.kills or 0) &gt; (b.kills or 0)
		end
		return (a.score or 0) &gt; (b.score or 0)
	end)
	local roleName = {
		drone = "ДРОН",
		survivor = "ВЫЖИВШИЙ",
		spectator = "—",
	}
	for index, p in ipairs(sorted) do
		if index &gt; 12 then
			break
		end
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 26)
		row.BackgroundColor3 = (index % 2 == 0) and Color3.fromRGB(20, 22, 30)
			or Color3.fromRGB(15, 16, 22)
		row.BorderSizePixel = 0
		row.Parent = self.scoreRows
		corner(row, 6)
		local text = string.format("%-18s %-10s %2d  %2d  %5d", string.sub(p.name, 1, 18),
			roleName[p.role] or "—", p.kills or 0, p.deaths or 0, p.score or 0)
		local l = label(row, text, UDim2.new(1, -12, 1, 0), (p.role == "drone") and ACCENT2 or TEXT,
			Enum.Font.Code)
		l.Position = UDim2.fromOffset(6, 0)
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextScaled = false
		l.TextSize = 15
	end
end

function MenuUI:toggleScoreboard()
	self.scoreFrame.Visible = not self.scoreFrame.Visible
	if self.scoreFrame.Visible and self.snapshot then
		self:renderScore(self.snapshot)
	end
	return self.scoreFrame.Visible
end

function MenuUI:setScoreboard(value)
	self.scoreFrame.Visible = value
	if value and self.snapshot then
		self:renderScore(self.snapshot)
	end
end

function MenuUI:setVisible(value)
	self.gui.Enabled = value
end

return MenuUI
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3594">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source">--!nonstrict
--[[
	Effects -- все «спецэффекты» клиента в одном месте:
	трассеры, взрывы, вспышки выстрелов, попадания, тряска камеры,
	всплывающие числа урона и экранные вспышки.
]]

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Effects = {}

local folder = Instance.new("Folder")
folder.Name = "ClientFX"
folder.Parent = Workspace

local shakeAmount = 0
local shakeSeed = math.random() * 100

function Effects.addShake(amount)
	shakeAmount = math.min(math.max(shakeAmount, amount), 0.16)
	shakeSeed = math.random() * 100
end

function Effects.shakeCFrame(dt)
	if shakeAmount &lt;= 0.0005 then
		shakeAmount = 0
		return CFrame.new()
	end
	local t = os.clock()
	local cf = CFrame.Angles(
		math.noise(shakeSeed, t * 22) * shakeAmount,
		math.noise(shakeSeed + 5, t * 19) * shakeAmount,
		math.noise(shakeSeed + 9, t * 17) * shakeAmount * 0.6)
	shakeAmount *= math.clamp(1 - dt * 6, 0, 1)
	return cf
end

function Effects.folder()
	return folder
end

-- --------------------------------------------------------------------------- --
-- Трассер
-- --------------------------------------------------------------------------- --
function Effects.tracer(origin, target, color, thickness)
	local delta = target - origin
	local dist = delta.Magnitude
	if dist &lt; 0.8 then
		return
	end
	local beam = Instance.new("Part")
	beam.Name = "Tracer"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = color or Color3.fromRGB(255, 220, 120)
	beam.Size = Vector3.new(thickness or 0.22, thickness or 0.22, dist)
	beam.CFrame = CFrame.lookAt(origin + delta / 2, target)
	beam.Transparency = 0.05
	beam.Parent = folder
	TweenService:Create(beam, TweenInfo.new(0.09), { Transparency = 1 }):Play()
	Debris:AddItem(beam, 0.14)

	local flash = Instance.new("PointLight")
	flash.Color = color or Color3.fromRGB(255, 220, 120)
	flash.Brightness = 4
	flash.Range = 24
	flash.Parent = beam
end

-- --------------------------------------------------------------------------- --
-- Вспышка выстрела
-- --------------------------------------------------------------------------- --
function Effects.muzzle(origin, color)
	local spark = Instance.new("Part")
	spark.Shape = Enum.PartType.Ball
	spark.Size = Vector3.new(1.6, 1.6, 1.6)
	spark.Material = Enum.Material.Neon
	spark.Color = color or Color3.fromRGB(255, 220, 150)
	spark.Anchored = true
	spark.CanCollide = false
	spark.CanQuery = false
	spark.CastShadow = false
	spark.CFrame = CFrame.new(origin)
	spark.Parent = folder
	local light = Instance.new("PointLight")
	light.Color = color or Color3.fromRGB(255, 200, 120)
	light.Brightness = 6
	light.Range = 22
	light.Parent = spark
	TweenService:Create(spark, TweenInfo.new(0.07), {
		Size = Vector3.new(4.4, 4.4, 4.4),
		Transparency = 1,
	}):Play()
	Debris:AddItem(spark, 0.1)
end

-- --------------------------------------------------------------------------- --
-- Взрыв
-- --------------------------------------------------------------------------- --
function Effects.explosion(position, radius, color)
	color = color or Color3.fromRGB(255, 150, 60)
	radius = radius or 18

	local sphere = Instance.new("Part")
	sphere.Shape = Enum.PartType.Ball
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.CanQuery = false
	sphere.CastShadow = false
	sphere.Material = Enum.Material.Neon
	sphere.Color = color
	sphere.Size = Vector3.new(4, 4, 4)
	sphere.CFrame = CFrame.new(position)
	sphere.Transparency = 0.1
	sphere.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 14
	light.Range = radius * 4
	light.Parent = sphere

	local sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 0
	sparks.Lifetime = NumberRange.new(0.4, 1.2)
	sparks.Speed = NumberRange.new(radius * 1.4, radius * 3.2)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Size = NumberSequence.new(1.9, 0)
	sparks.Color = ColorSequence.new(color, Color3.fromRGB(70, 16, 0))
	sparks.LightEmission = 1
	sparks.Acceleration = Vector3.new(0, -42, 0)
	sparks.Parent = sphere
	sparks:Emit(46)

	local smoke = Instance.new("ParticleEmitter")
	smoke.Rate = 0
	smoke.Lifetime = NumberRange.new(1.2, 2.6)
	smoke.Speed = NumberRange.new(6, 20)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Size = NumberSequence.new(radius * 0.5, radius * 1.9)
	smoke.Color = ColorSequence.new(Color3.fromRGB(56, 44, 40), Color3.fromRGB(20, 16, 16))
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Parent = sphere
	smoke:Emit(20)

	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Size = Vector3.new(0.6, 6, 6)
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.15
	ring.Parent = folder
	TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.6, radius * 3, radius * 3),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.55)

	TweenService:Create(sphere, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(radius * 2.2, radius * 2.2, radius * 2.2),
		Transparency = 1,
	}):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(sphere, 0.62)

	local cam = Workspace.CurrentCamera
	if cam then
		local dist = (cam.CFrame.Position - position).Magnitude
		Effects.addShake(math.clamp(radius / math.max(dist, 24) * 0.05, 0, 0.07))
	end
end

-- --------------------------------------------------------------------------- --
-- Попадание
-- --------------------------------------------------------------------------- --
function Effects.impact(position, normal, color)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.7, 0.7, 0.7)
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.fromRGB(255, 226, 160)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.CFrame = CFrame.new(position + (normal or Vector3.yAxis) * 0.2)
	p.Parent = folder
	local burst = Instance.new("ParticleEmitter")
	burst.Rate = 0
	burst.Lifetime = NumberRange.new(0.15, 0.4)
	burst.Speed = NumberRange.new(8, 22)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Size = NumberSequence.new(0.42, 0)
	burst.Color = ColorSequence.new(color or Color3.fromRGB(255, 226, 160))
	burst.LightEmission = 1
	burst.Parent = p
	burst:Emit(7)
	Debris:AddItem(p, 0.42)
end

-- --------------------------------------------------------------------------- --
-- Всплывающий урон
-- --------------------------------------------------------------------------- --
function Effects.damageNumber(position, amount, color)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.CFrame = CFrame.new(position)
	part.Parent = folder

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(6, 3)
	gui.AlwaysOnTop = true
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "+" .. tostring(math.floor(amount))
	label.TextColor3 = color or Color3.fromRGB(255, 236, 180)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextStrokeTransparency = 0.4
	label.Parent = gui

	TweenService:Create(part, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(position + Vector3.new(0, 12, 0)),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(part, 0.75)
end

return Effects
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3595">
        <Properties>
          <string name="Name">FpsWeapon</string>
          <string name="Source">--!nonstrict
--[[
	FpsWeapon -- оружие выжившего от первого лица.

	Собранный кодом «вид от первого лица»: винтовка, руки, нож. Никаких
	загруженных анимаций -- всё процедурное: покачивание при шаге, инерция
	мыши, отдача, перезарядка с провалом ствола, замах ножом по дуге,
	вспышка выстрела, трассер и искры.

	Стрельба: клиент рисует эффекты и отправляет направление на сервер,
	сервер считает попадание (античит: клиент не может наносить урон сам).
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Effects = require(script.Parent:WaitForChild("Effects"))

local FpsWeapon = {}
FpsWeapon.__index = FpsWeapon

local SKIN = Color3.fromRGB(226, 178, 140)
local SLEEVE = Color3.fromRGB(58, 74, 62)
local GUN_BODY = Color3.fromRGB(46, 48, 54)
local GUN_METAL = Color3.fromRGB(96, 100, 110)
local GUN_WOOD = Color3.fromRGB(96, 66, 40)
local NEON = Color3.fromRGB(120, 235, 255)

-- --------------------------------------------------------------------------- --
local function makePart(name, size, color, material, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.Metal
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- --------------------------------------------------------------------------- --
function FpsWeapon.new(cfg, remotes, callbacks)
	local self = setmetatable({}, FpsWeapon)
	self.cfg = cfg
	self.rifle = remotes.GunFire
	self.meleeRemote = remotes.Melee
	self.reloadRemote = remotes.Reload
	self.callbacks = callbacks or {}
	self.model = nil
	self.parts = {}          -- { part = Part, cf = CFrame, group = "gun"|"knife" }
	self.ammo = cfg.Magazine
	self.magazine = cfg.Magazine
	self.lastFire = 0
	self.recoil = 0
	self.bob = 0
	self.sway = Vector2.zero
	self.reloadT = -1
	self.meleeT = -1
	self.muzzle = nil
	self.muzzleLight = nil
	self.enabled = false
	return self
end

function FpsWeapon:build()
	if self.model then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Viewmodel"
	model.Parent = camera
	self.model = model

	local function add(name, size, offset, color, material, rot, group)
		local part = makePart(name, size, color, material, model)
		local cf = CFrame.new(offset) * (rot or CFrame.new())
		table.insert(self.parts, { part = part, cf = cf, group = group or "gun" })
		return part
	end

	-- корпус винтовки
	add("Body", Vector3.new(0.46, 0.56, 2.3), Vector3.new(0.86, -0.86, -1.5), GUN_BODY)
	add("Foregrip", Vector3.new(0.4, 0.34, 1.1), Vector3.new(0.86, -0.72, -2.6), GUN_METAL)
	add("Barrel", Vector3.new(0.15, 0.15, 1.9), Vector3.new(0.86, -0.74, -3.6), GUN_METAL)
	add("Muzzle", Vector3.new(0.3, 0.3, 0.44), Vector3.new(0.86, -0.74, -4.5), GUN_BODY)
	add("Stock", Vector3.new(0.32, 0.46, 1.1), Vector3.new(0.86, -0.92, -0.2), GUN_WOOD)
	add("Mag", Vector3.new(0.32, 1.0, 0.46), Vector3.new(0.86, -1.3, -1.2), GUN_BODY)
	add("Grip", Vector3.new(0.28, 0.66, 0.36), Vector3.new(0.86, -1.18, -0.86), GUN_WOOD,
		CFrame.Angles(math.rad(-14), 0, 0))
	add("Scope", Vector3.new(0.24, 0.28, 1.0), Vector3.new(0.86, -0.42, -1.9), GUN_BODY)
	add("ScopeGlass", Vector3.new(0.2, 0.2, 0.06), Vector3.new(0.86, -0.42, -2.42), NEON,
		Enum.Material.Neon)
	add("Rail", Vector3.new(0.08, 0.08, 1.6), Vector3.new(0.86, -0.55, -2.2), NEON,
		Enum.Material.Neon)
	add("Sight", Vector3.new(0.1, 0.16, 0.1), Vector3.new(0.86, -0.6, -4.1), NEON,
		Enum.Material.Neon)

	-- руки
	add("RightArm", Vector3.new(0.42, 0.42, 1.5), Vector3.new(1.02, -1.42, -0.72), SKIN,
		Enum.Material.SmoothPlastic, CFrame.Angles(math.rad(18), math.rad(-6), 0))
	add("RightSleeve", Vector3.new(0.5, 0.5, 0.9), Vector3.new(1.08, -1.66, 0.28), SLEEVE,
		Enum.Material.Fabric)
	add("LeftArm", Vector3.new(0.4, 0.4, 1.4), Vector3.new(0.52, -1.12, -2.5), SKIN,
		Enum.Material.SmoothPlastic, CFrame.Angles(math.rad(-8), math.rad(28), math.rad(-16)))
	add("LeftSleeve", Vector3.new(0.48, 0.48, 0.8), Vector3.new(0.28, -0.98, -3.2), SLEEVE,
		Enum.Material.Fabric)

	-- нож (виден только в замахе)
	add("Blade", Vector3.new(0.07, 0.42, 1.5), Vector3.new(0.95, -1.0, -1.6),
		Color3.fromRGB(198, 208, 220), Enum.Material.Metal, CFrame.Angles(math.rad(6), 0, 0), "knife")
	add("BladeEdge", Vector3.new(0.03, 0.14, 1.45), Vector3.new(0.95, -1.22, -1.6), NEON,
		Enum.Material.Neon, nil, "knife")
	add("Hilt", Vector3.new(0.18, 0.18, 0.5), Vector3.new(0.95, -1.0, -0.72), GUN_WOOD, nil, nil,
		"knife")
	add("Guard", Vector3.new(0.34, 0.1, 0.12), Vector3.new(0.95, -1.0, -1.0), GUN_METAL, nil, nil,
		"knife")

	self:muzzleSetup()
	self:setGroupVisible("knife", false)
end

function FpsWeapon:muzzleSetup()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local flash = makePart("MuzzleFlash", Vector3.new(0.7, 0.7, 0.7),
		Color3.fromRGB(255, 226, 150), Enum.Material.Neon, self.model)
	flash.Shape = Enum.PartType.Ball
	flash.Transparency = 1
	flash.CFrame = camera.CFrame * CFrame.new(0.86, -0.74, -4.7)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 140)
	light.Brightness = 0
	light.Range = 26
	light.Parent = flash
	self.muzzle = flash
	self.muzzleLight = light
end

function FpsWeapon:setGroupVisible(group, visible)
	for _, entry in ipairs(self.parts) do
		if entry.group == group then
			entry.part.Transparency = visible and 0 or 1
		end
	end
	if group == "gun" and self.muzzle then
		self.muzzle.Transparency = visible and 1 or 1
	end
end

function FpsWeapon:attach()
	self:build()
	self.enabled = true
	self:setGroupVisible("gun", true)
	self.ammo = self.magazine
	self.reloadT = -1
	if self.callbacks.onAmmo then
		self.callbacks.onAmmo(self.ammo, self.magazine, false)
	end
	local character = self.callbacks.getCharacter and self.callbacks.getCharacter()
	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 1
			end
		end
	end
end

function FpsWeapon:detach()
	self.enabled = false
	if self.model then
		self.model:Destroy()
		self.model = nil
	end
	self.parts = {}
	self.muzzle = nil
	self.muzzleLight = nil
end

-- --------------------------------------------------------------------------- --
-- Стрельба
-- --------------------------------------------------------------------------- --
function FpsWeapon:reload()
	if self.reloadT &gt;= 0 or self.ammo &gt;= self.magazine then
		return
	end
	self.reloadT = 0
	if self.reloadRemote then
		self.reloadRemote:FireServer()
	end
end

function FpsWeapon:fire()
	local camera = Workspace.CurrentCamera
	if not self.enabled or not camera or self.reloadT &gt;= 0 then
		return
	end
	if os.clock() - self.lastFire &lt; self.cfg.Interval then
		return
	end
	if self.ammo &lt;= 0 then
		self:reload()
		return
	end
	self.lastFire = os.clock()
	self.ammo -= 1
	self.recoil = 1

	local origin = camera.CFrame.Position
	local dir = camera.CFrame.LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { Effects.folder() }
	local character = self.callbacks.getCharacter and self.callbacks.getCharacter()
	if character then
		table.insert(exclude, character)
	end
	if self.model then
		table.insert(exclude, self.model)
	end
	params.FilterDescendantsInstances = exclude
	local hit = Workspace:Raycast(origin + dir * 1.5, dir * (self.cfg.Range + 40), params)
	local endpoint = hit and hit.Position or (origin + dir * self.cfg.Range)

	local muzzlePos = camera.CFrame * CFrame.new(0.86, -0.74, -4.6)
	Effects.tracer(muzzlePos.Position, endpoint, Color3.fromRGB(255, 240, 190), 0.14)
	Effects.muzzle(muzzlePos.Position, Color3.fromRGB(255, 226, 150))
	if hit then
		Effects.impact(hit.Position, hit.Normal)
	end
	Effects.addShake(0.012)

	if self.muzzle then
		self.muzzle.Transparency = 0.05
		self.muzzleLight.Brightness = 7
		task.delay(0.05, function()
			if self.muzzle then
				self.muzzle.Transparency = 1
				self.muzzleLight.Brightness = 0
			end
		end)
	end

	self.rifle:FireServer(dir)
	if self.callbacks.onAmmo then
		self.callbacks.onAmmo(self.ammo, self.magazine, self.reloadT &gt;= 0)
	end
	if self.ammo &lt;= 0 then
		task.delay(0.25, function()
			self:reload()
		end)
	end
end

function FpsWeapon:melee()
	if not self.enabled or self.meleeT &gt;= 0 then
		return
	end
	self.meleeT = 0
	self:setGroupVisible("gun", false)
	self:setGroupVisible("knife", true)
	self.meleeRemote:FireServer()

	local camera = Workspace.CurrentCamera
	if camera then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local character = self.callbacks.getCharacter and self.callbacks.getCharacter()
		local exclude = { Effects.folder() }
		if character then
			table.insert(exclude, character)
		end
		params.FilterDescendantsInstances = exclude
		local origin = camera.CFrame.Position
		local hit = Workspace:Raycast(origin, camera.CFrame.LookVector * 10, params)
		if hit then
			Effects.impact(hit.Position, hit.Normal, Color3.fromRGB(255, 200, 200))
		end
	end
end

-- --------------------------------------------------------------------------- --
-- Анимация
-- --------------------------------------------------------------------------- --
function FpsWeapon:update(dt, firing)
	if not self.enabled or not self.model then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end

	if firing then
		self:fire()
	end

	-- отдача
	self.recoil = math.max(0, self.recoil - dt * 6)
	local kick = self.recoil * self.recoil

	-- покачивание при ходьбе
	local character = self.callbacks.getCharacter and self.callbacks.getCharacter()
	local speed = 0
	if character then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then
			speed = (hum.MoveDirection.Magnitude &gt; 0.1) and hum.WalkSpeed or 0
		end
	end
	self.bob += dt * (speed &gt; 0 and 9 or 2.2)
	local bobX = math.sin(self.bob) * (speed &gt; 0 and 0.035 or 0.008)
	local bobY = math.abs(math.cos(self.bob)) * (speed &gt; 0 and 0.03 or 0.006)

	-- инерция мыши
	local delta = Vector2.zero
	if not UserInputService.TouchEnabled then
		local d = UserInputService:GetMouseDelta()
		delta = Vector2.new(d.X, d.Y)
	end
	self.sway = self.sway:Lerp(delta * 0.0016, math.clamp(dt * 9, 0, 1))
	self.sway = Vector2.new(math.clamp(self.sway.X, -0.08, 0.08),
		math.clamp(self.sway.Y, -0.08, 0.08))

	-- перезарядка
	local reloadOffset = 0
	local reloadRoll = 0
	local magDrop = 0
	if self.reloadT &gt;= 0 then
		self.reloadT += dt / self.cfg.Reload
		local t = math.clamp(self.reloadT, 0, 1)
		local arc = math.sin(t * math.pi)
		reloadOffset = -arc * 0.55
		reloadRoll = arc * 0.9
		magDrop = (t &gt; 0.25 and t &lt; 0.75) and math.sin((t - 0.25) / 0.5 * math.pi) * 0.9 or 0
		if self.reloadT &gt;= 1 then
			self.reloadT = -1
			self.ammo = self.magazine
			if self.callbacks.onAmmo then
				self.callbacks.onAmmo(self.ammo, self.magazine, false)
			end
		elseif self.callbacks.onAmmo then
			self.callbacks.onAmmo(self.ammo, self.magazine, true)
		end
	end

	-- замах ножом
	local knifeCF = nil
	if self.meleeT &gt;= 0 then
		self.meleeT += dt / 0.42
		local t = math.clamp(self.meleeT, 0, 1)
		local swing = math.sin(t * math.pi)
		local side = 1 - t * 1.6
		knifeCF = CFrame.new(0.6 + side * 0.5, -0.7 + swing * 0.35, -1.2 - swing * 0.9)
			* CFrame.Angles(math.rad(-30 + swing * 60), math.rad(-70 + t * 110),
				math.rad(20 - t * 70))
		if self.meleeT &gt;= 1 then
			self.meleeT = -1
			self:setGroupVisible("knife", false)
			self:setGroupVisible("gun", true)
		end
	end

	local base = CFrame.new(
		bobX + self.sway.X,
		-bobY + self.sway.Y + reloadOffset - kick * 0.1,
		0.16 + kick * 0.35)
		* CFrame.Angles(math.rad(-reloadRoll * 26 - kick * 4), math.rad(reloadRoll * 14),
			math.rad(reloadRoll * 22))
		* CFrame.Angles(-self.sway.Y * 1.6, -self.sway.X * 1.6, self.sway.X * 2.2)

	for _, entry in ipairs(self.parts) do
		local cf = base * entry.cf
		if entry.group == "knife" and knifeCF then
			cf = base * knifeCF
		elseif entry.group == "knife" then
			cf = base * entry.cf
		elseif entry.part.Name == "Mag" then
			cf = base * entry.cf * CFrame.new(0, -magDrop, 0)
		end
		entry.part.CFrame = camera.CFrame * cf
	end
	if self.muzzle then
		self.muzzle.CFrame = camera.CFrame * base * CFrame.new(0.86, -0.74, -4.7)
	end
end

return FpsWeapon
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3596">
        <Properties>
          <string name="Name">Builder</string>
          <string name="Source">--!nonstrict
--[[
	Builder -- строительство из досок для выживших.

	Сетка, призрачная доска перед камерой (зелёная -- можно, красная -- нет),
	поворот колесом/R, три типа: стена, настил, пандус. Сервер проверяет
	расстояние и лимит деталей, поэтому читерить не получится.
]]

local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Builder = {}
Builder.__index = Builder

function Builder.new(config, callbacks)
	local self = setmetatable({}, Builder)
	self.cfg = config
	self.callbacks = callbacks or {}
	self.enabled = false
	self.plankIndex = 1
	self.yaw = 0
	self.ghost = nil
	self.valid = false
	self.targetCF = nil
	return self
end

function Builder:getPlank()
	local list = self.cfg.PlankSizes
	return list[(self.plankIndex - 1) % #list + 1]
end

function Builder:cycle(delta)
	local list = self.cfg.PlankSizes
	self.plankIndex = (self.plankIndex - 1 + (delta or 1)) % #list + 1
	self:refresh()
	return self:getPlank()
end

function Builder:setPlank(id)
	local list = self.cfg.PlankSizes
	for i, plank in ipairs(list) do
		if plank.Id == id then
			self.plankIndex = i
			self:refresh()
			return plank
		end
	end
	return self:getPlank()
end

function Builder:refresh()
	local plank = self:getPlank()
	if self.ghost then
		self.ghost.Size = plank.Size
		self.ghost.Color = plank.Color
	end
end

function Builder:ensureGhost()
	if self.ghost and self.ghost.Parent then
		return
	end
	local plank = self:getPlank()
	local ghost = Instance.new("Part")
	ghost.Name = "PlankGhost"
	ghost.Size = plank.Size
	ghost.Color = plank.Color
	ghost.Material = self.cfg.Material
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanQuery = false
	ghost.CanTouch = false
	ghost.CastShadow = false
	ghost.Transparency = 0.55
	ghost.Parent = Workspace
	self.ghost = ghost
end

function Builder:setEnabled(value)
	self.enabled = value
	if value then
		self:ensureGhost()
		self:refresh()
	elseif self.ghost then
		self.ghost:Destroy()
		self.ghost = nil
	end
end

function Builder:rotate(deg)
	self.yaw = (self.yaw + (deg or 45)) % 360
end

-- считает CFrame установки по лучу камеры
function Builder:update(dt, camera)
	if not self.enabled then
		return
	end
	self:ensureGhost()
	local plank = self:getPlank()
	local character = self.callbacks.getCharacter and self.callbacks.getCharacter()

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	if character then
		table.insert(exclude, character)
	end
	if self.ghost then
		table.insert(exclude, self.ghost)
	end
	local fx = Workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(exclude, fx)
	end
	params.FilterDescendantsInstances = exclude

	local origin = camera.CFrame.Position
	local dir = camera.CFrame.LookVector
	local hit = Workspace:Raycast(origin, dir * (self.cfg.Range + 26), params)
	if not hit then
		self.valid = false
		self.targetCF = nil
		self.ghost.Transparency = 1
		return
	end

	local pos = hit.Position
	local normal = hit.Normal
	if plank.Id == "floor" then
		pos = pos + Vector3.new(0, plank.Size.Y / 2 + 0.06, 0)
	else
		-- прижимаем доску к поверхности по нормали
		local push = math.abs(normal.X) * plank.Size.X / 2
			+ math.abs(normal.Z) * plank.Size.Z / 2
			+ math.abs(normal.Y) * plank.Size.Y / 2
		pos = pos + normal * (push + 0.06)
	end
	-- сетка
	local step = self.cfg.GridStep
	pos = Vector3.new(
		math.floor(pos.X / step + 0.5) * step,
		math.floor(pos.Y / step + 0.5) * step,
		math.floor(pos.Z / step + 0.5) * step)

	local cf
	if plank.Id == "floor" then
		cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(self.yaw), 0)
	elseif plank.Id == "ramp" then
		local yaw = math.degrees(math.atan2(-dir.X, -dir.Z)) + self.yaw
		cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw), 0)
			* CFrame.Angles(math.rad(-32), 0, 0)
	else
		local flat = Vector3.new(normal.X, 0, normal.Z)
		if flat.Magnitude &lt; 0.2 then
			flat = -dir
		end
		flat = flat.Unit
		local yaw = math.degrees(math.atan2(-flat.X, -flat.Z)) + self.yaw
		cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(yaw), 0)
	end

	self.targetCF = cf
	self.valid = true
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root and (pos - root.Position).Magnitude &gt; self.cfg.Range then
			self.valid = false
		end
	end

	self.ghost.Size = plank.Size
	self.ghost.CFrame = cf
	self.ghost.Transparency = 0.5
	self.ghost.Color = self.valid and Color3.fromRGB(130, 255, 170)
		or Color3.fromRGB(255, 110, 110)
end

function Builder:place()
	if not self.enabled or not self.valid or not self.targetCF then
		return false
	end
	if self.callbacks.place then
		self.callbacks.place(self:getPlank().Id, self.targetCF)
	end
	return true
end

return Builder
</string>
        </Properties>
      </Item>
    </Item>

  <Item class="ServerScriptService" referent="RBX2003">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX2004">
      <Properties>
        <string name="Name">DroneServer</string>
        <string name="Source">--!nonstrict
--[[
	DroneServer -- серверная часть «Беспилотник: Лавовый каньон».

	Сервер отвечает за:
	  * сборку дрона из модели игрока (сварка всех деталей в один узел),
	  * передачу сетевого владения игроку (физику считает клиент),
	  * оружие, урон, смерть и возрождение,
	  * волны врагов-перехватчиков и лавовые турели,
	  * бонусы, счёт, лидерборд.
]]

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("DroneConfig"))

Players.CharacterAutoLoads = false

-- ---------------------------------------------------------------------------
-- Состояние
-- ---------------------------------------------------------------------------
local playerData = {}    -- [Player] = данные дрона
local droneOwners = {}   -- [Model] = Player
local enemies = {}       -- активные перехватчики
local turrets = {}       -- лавовые турели
local projectiles = {}   -- снаряды врагов
local pickups = {}       -- бонусы
local waveNumber = 0

-- forward declarations
local damageEnemy, damageTurret, explode, spawnDrone, killPlayer, damageDrone

-- ---------------------------------------------------------------------------
-- Remotes
-- ---------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "DroneRemotes"
remotes.Parent = ReplicatedStorage

local function newRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end

local SetDrone = newRemote("SetDrone")
local DroneLost = newRemote("DroneLost")
local FireRemote = newRemote("Fire")
local FireFX = newRemote("FireFX")
local BombRemote = newRemote("Bomb")
local BombFX = newRemote("BombFX")
local ExplosionFX = newRemote("ExplosionFX")
local Banner = newRemote("Banner")
local CrashRemote = newRemote("Crash")
local DamageFX = newRemote("DamageFX")
local RequestDrone = newRemote("RequestDrone")

-- ---------------------------------------------------------------------------
-- Утилиты
-- ---------------------------------------------------------------------------
local function norm(s)
	return (s:lower():gsub("[%s_%-]", ""))
end

local function findNamed(root, name)
	local n = norm(name)
	for _, d in ipairs(root:GetDescendants()) do
		if norm(d.Name) == n then
			return d
		end
	end
	return nil
end

local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

local function spreadDirection(dir, degrees)
	if degrees &lt;= 0 then
		return dir.Unit
	end
	local up = math.abs(dir.Y) &gt; 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local right = dir:Cross(up).Unit
	local realUp = right:Cross(dir.Unit).Unit
	local ang = math.rad(degrees) * math.sqrt(math.random())
	local roll = math.random() * math.pi * 2
	local offset = (right * math.cos(roll) + realUp * math.sin(roll)) * math.tan(ang)
	return (dir.Unit + offset).Unit
end

-- ---------------------------------------------------------------------------
-- Мир: точки спавна, турели, бонусы
-- ---------------------------------------------------------------------------
local gameplay = Workspace:WaitForChild("Gameplay")
local spawnPads = gameplay:WaitForChild("SpawnPads")
local turretMounts = gameplay:WaitForChild("TurretMounts")
local pickupAnchors = gameplay:WaitForChild("PickupAnchors")

local spawnList = {}
for _, pad in ipairs(spawnPads:GetChildren()) do
	if pad:IsA("BasePart") then
		table.insert(spawnList, pad)
	end
end
table.sort(spawnList, function(a, b) return a.Name &lt; b.Name end)

local function getSpawnCFrame(player)
	if #spawnList == 0 then
		return CFrame.new(0, 70, 0)
	end
	local idx = 1
	for i, p in ipairs(Players:GetPlayers()) do
		if p == player then
			idx = i
			break
		end
	end
	local pad = spawnList[((idx - 1) % #spawnList) + 1]
	return CFrame.new(pad.Position + Vector3.new(0, 16, 0))
end

local fxFolder = Instance.new("Folder")
fxFolder.Name = "ServerFX"
fxFolder.Parent = Workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = { fxFolder }

local projectileParams = RaycastParams.new()
projectileParams.FilterType = Enum.RaycastFilterType.Exclude
projectileParams.FilterDescendantsInstances = { fxFolder }

-- ---------------------------------------------------------------------------
-- Лидерборд / счёт
-- ---------------------------------------------------------------------------
local function setupLeaderstats(player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local score = Instance.new("IntValue")
	score.Name = "Счёт"
	score.Parent = stats
	local kills = Instance.new("IntValue")
	kills.Name = "Убийства"
	kills.Parent = stats
	stats.Parent = player
end

local function addScore(player, amount)
	if not player or not player.Parent then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	local score = stats and stats:FindFirstChild("Счёт")
	if score then
		score.Value += amount
	end
	player:SetAttribute("Score", (player:GetAttribute("Score") or 0) + amount)
end

local function addKill(player)
	if not player or not player.Parent then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	local kills = stats and stats:FindFirstChild("Убийства")
	if kills then
		kills.Value += 1
	end
	player:SetAttribute("Kills", (player:GetAttribute("Kills") or 0) + 1)
end

-- ---------------------------------------------------------------------------
-- Эффекты
-- ---------------------------------------------------------------------------
function explode(position, radius, color)
	ExplosionFX:FireAllClients(position, radius, color or Color3.fromRGB(255, 140, 40))
end

local function announce(text, duration)
	Banner:FireAllClients(text, duration or 3)
	for _, p in ipairs(Players:GetPlayers()) do
		p:SetAttribute("Wave", waveNumber)
	end
end

-- ---------------------------------------------------------------------------
-- Дрон: сборка / уничтожение
-- ---------------------------------------------------------------------------
local function weldAssembly(model, primary)
	-- все детали пока Anchored = true, поэтому ничего не разваливается
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= primary then
			if not p:FindFirstChildOfClass("WeldConstraint") then
				local weld = Instance.new("WeldConstraint")
				weld.Name = "AssemblyWeld"
				weld.Part0 = primary
				weld.Part1 = p
				weld.Parent = p
			end
		end
	end
end

local function unanchorAll(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = false
		end
	end
end

function damageDrone(player, amount, killer, reason)
	local data = playerData[player]
	if not data or not data.alive then
		return
	end
	local model = data.model
	local armor = model:GetAttribute("Armor") or 1
	local health = (model:GetAttribute("Health") or 0) - amount * armor
	model:SetAttribute("Health", math.max(0, health))
	DamageFX:FireClient(player, amount * armor, reason or "hit")
	if health &lt;= 0 then
		killPlayer(player, killer, reason or "destroyed")
	end
end

function killPlayer(player, killer, reason)
	local data = playerData[player]
	if not data then
		return
	end
	local pos = data.primary and data.primary.Position or Vector3.zero
	explode(pos, 28, Color3.fromRGB(255, 170, 60))
	addKill(killer)
	addScore(killer, 60)
	player:SetAttribute("Alive", false)
	player:SetAttribute("Deaths", (player:GetAttribute("Deaths") or 0) + 1)

	local model = data.model
	playerData[player] = nil
	if model then
		droneOwners[model] = nil
		model:SetAttribute("Alive", false)
		SetDrone:FireClient(player, nil, nil)
		DroneLost:FireClient(player, reason)
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Anchored = false
				p:ApplyAngularImpulse(Vector3.new(math.random(-300, 300),
					math.random(-300, 300), math.random(-300, 300)))
			end
		end
		Debris:AddItem(model, 6)
	end

	task.delay(Config.RespawnTime, function()
		if player.Parent then
			spawnDrone(player, player:GetAttribute("DroneId"))
		end
	end)
end

function spawnDrone(player, droneId)
	local old = playerData[player]
	if old then
		local model = old.model
		playerData[player] = nil
		if model then
			droneOwners[model] = nil
			model:Destroy()
		end
	end

	local droneCfg = Config.getDrone(droneId or player:GetAttribute("DroneId"))
	player:SetAttribute("DroneId", droneCfg.Id)

	local template = ServerStorage:FindFirstChild(droneCfg.Template)
	if not template then
		warn("[Drone] В ServerStorage нет модели " .. droneCfg.Template)
		return
	end

	local model = template:Clone()
	model.Name = "Drone_" .. player.Name
	model:PivotTo(getSpawnCFrame(player))

	local primary = model.PrimaryPart
	if not primary then
		local best, bestVol = nil, -1
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				local v = p.Size.X * p.Size.Y * p.Size.Z
				if v &gt; bestVol then
					best, bestVol = p, v
				end
			end
		end
		primary = best
		model.PrimaryPart = primary
	end
	if not primary then
		warn("[Drone] У модели нет деталей")
		model:Destroy()
		return
	end

	local camPart = findNamed(model, "camera")
	if camPart and camPart:IsA("BasePart") then
		camPart.CanCollide = false
		camPart.CanQuery = false
		camPart.CanTouch = false
	end

	weldAssembly(model, primary)

	model:SetAttribute("IsDrone", true)
	model:SetAttribute("OwnerName", player.Name)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("DroneId", droneCfg.Id)
	model:SetAttribute("MaxHealth", droneCfg.Health)
	model:SetAttribute("Health", droneCfg.Health)
	model:SetAttribute("Alive", true)
	model:SetAttribute("Armor", droneCfg.Armor)

	model.Parent = Workspace
	primary.Anchored = false
	unanchorAll(model)

	local guns = {}
	for _, n in ipairs({ "minigan one", "minigan two" }) do
		local g = findNamed(model, n)
		if g and g:IsA("BasePart") then
			table.insert(guns, g)
		end
	end
	if #guns == 0 then
		table.insert(guns, primary)
	end

	playerData[player] = {
		model = model,
		primary = primary,
		camera = camPart,
		guns = guns,
		gunIndex = 1,
		cfg = droneCfg,
		alive = true,
		lastFire = 0,
		lastBomb = -999,
		spawnTime = os.clock(),
	}
	droneOwners[model] = player

	-- Физику считает клиент -&gt; управление без задержки.
	pcall(function()
		primary:SetNetworkOwner(player)
	end)

	SetDrone:FireClient(player, model, droneCfg.Id)
	player:SetAttribute("Alive", true)
end

local function isDroneModel(inst)
	local model = inst and inst:FindFirstAncestorOfClass("Model")
	while model do
		if model:GetAttribute("IsDrone") then
			return model, droneOwners[model]
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil, nil
end

local function findWithAttribute(inst, attribute)
	local node = inst
	while node do
		if node:GetAttribute(attribute) then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- ---------------------------------------------------------------------------
-- Враги
-- ---------------------------------------------------------------------------
local function buildEnemyModel(position, wave)
	local model = Instance.new("Model")
	model.Name = "EnemyInterceptor"

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(4.6, 4.6, 4.6)
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(255, 96, 32)
	core.Anchored = true
	core.CanCollide = false
	core.CFrame = CFrame.new(position)
	core.Parent = model
	model.PrimaryPart = core

	local function weldPart(part)
		part.Anchored = true
		part.CanCollide = false
		part.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = core
		w.Part1 = part
		w.Parent = part
	end

	for i = 0, 3 do
		local ang = math.rad(45 + i * 90)
		local arm = Instance.new("Part")
		arm.Name = "Arm"
		arm.Size = Vector3.new(1.6, 1.6, 8.5)
		arm.Material = Enum.Material.Metal
		arm.Color = Color3.fromRGB(42, 38, 40)
		arm.CFrame = CFrame.new(position) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -4.6)
		arm.TopSurface = Enum.SurfaceType.Smooth
		arm.BottomSurface = Enum.SurfaceType.Smooth
		weldPart(arm)

		local tip = Instance.new("Part")
		tip.Name = "Tip"
		tip.Shape = Enum.PartType.Ball
		tip.Size = Vector3.new(1.4, 1.4, 1.4)
		tip.Material = Enum.Material.Neon
		tip.Color = Color3.fromRGB(255, 60, 30)
		tip.CFrame = CFrame.new(position) * CFrame.Angles(0, ang, 0) * CFrame.new(0, 0, -8.6)
		weldPart(tip)
	end

	local eye = Instance.new("Part")
	eye.Name = "Eye"
	eye.Shape = Enum.PartType.Ball
	eye.Size = Vector3.new(2.2, 2.2, 2.2)
	eye.Material = Enum.Material.Neon
	eye.Color = Color3.fromRGB(255, 220, 180)
	eye.CFrame = CFrame.new(position) * CFrame.new(0, 0, -2.9)
	weldPart(eye)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 92, 30)
	light.Brightness = 4
	light.Range = 40
	light.Parent = core

	local fire = Instance.new("ParticleEmitter")
	fire.Rate = 20
	fire.Lifetime = NumberRange.new(0.6, 1.4)
	fire.Speed = NumberRange.new(3, 8)
	fire.Size = NumberSequence.new(1.6, 0.2)
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 150, 60), Color3.fromRGB(120, 20, 0))
	fire.LightEmission = 1
	fire.Parent = core

	local hp = Config.Enemies.BaseHealth + Config.Enemies.HealthPerWave * (wave - 1)
	model:SetAttribute("Enemy", true)
	model:SetAttribute("Health", hp)
	model:SetAttribute("MaxHealth", hp)
	model.Parent = workspace

	local att = Instance.new("Attachment")
	att.Name = "Root"
	att.Parent = core

	local alignPos = Instance.new("AlignPosition")
	alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPos.Attachment0 = att
	alignPos.Position = position
	alignPos.MaxForce = 1e6
	alignPos.Responsiveness = 4.5
	alignPos.ApplyAtCenterOfMass = true
	alignPos.Parent = core

	local alignOr = Instance.new("AlignOrientation")
	alignOr.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOr.Attachment0 = att
	alignOr.RigidityEnabled = false
	alignOr.MaxTorque = 1e6
	alignOr.Responsiveness = 6
	alignOr.Parent = core

	core.Anchored = false
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p ~= core then
			p.Anchored = false
		end
	end

	return model
end

local function spawnEnemy(wave)
	local list = Players:GetPlayers()
	if #list == 0 then
		return
	end
	local player = list[math.random(1, #list)]
	local data = playerData[player]
	local base = (data and data.primary and data.primary.Position) or Vector3.new(0, 60, 0)
	local ang = math.random() * math.pi * 2
	local dist = math.random(220, 420)
	local pos = base + Vector3.new(math.cos(ang) * dist, math.random(20, 80), math.sin(ang) * dist)
	local model = buildEnemyModel(pos, wave)
	table.insert(enemies, {
		model = model,
		nextFire = os.clock() + math.random(120, 300) / 100,
		phase = math.random() * math.pi * 2,
		orbit = math.random(80, 150),
		height = math.random(15, 45),
	})
end

function damageEnemy(model, amount, attacker)
	for i, e in ipairs(enemies) do
		if e.model == model then
			local hp = (model:GetAttribute("Health") or 0) - amount
			model:SetAttribute("Health", hp)
			if hp &lt;= 0 then
				table.remove(enemies, i)
				explode(model:GetPivot().Position, 20, Color3.fromRGB(255, 120, 40))
				model:Destroy()
				addScore(attacker, Config.Enemies.KillScore)
				addKill(attacker)
			end
			return
		end
	end
end

-- ---------------------------------------------------------------------------
-- Турели
-- ---------------------------------------------------------------------------
local function buildTurret(mount)
	local folder = Instance.new("Folder")
	folder.Name = "LavaTurret"
	local basePos = mount:GetPivot().Position

	local core = Instance.new("Part")
	core.Name = "TurretCore"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(4.2, 4.2, 4.2)
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(255, 110, 40)
	core.Anchored = true
	core.CanCollide = false
	core.CFrame = CFrame.new(basePos + Vector3.new(0, 14, 0))
	core.Parent = folder

	local barrel = Instance.new("Part")
	barrel.Name = "TurretBarrel"
	barrel.Size = Vector3.new(1.5, 1.5, 7)
	barrel.Material = Enum.Material.Metal
	barrel.Color = Color3.fromRGB(38, 34, 36)
	barrel.Anchored = true
	barrel.CanCollide = false
	barrel.CFrame = core.CFrame * CFrame.new(0, 0, -4)
	barrel.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 110, 40)
	light.Brightness = 3
	light.Range = 34
	light.Parent = core

	folder:SetAttribute("Turret", true)
	folder:SetAttribute("Health", Config.Turrets.Health)
	folder.Parent = workspace

	local entry = {
		folder = folder,
		core = core,
		barrel = barrel,
		mount = mount,
		nextFire = os.clock() + math.random(2, 5),
		dead = false,
	}
	table.insert(turrets, entry)
	return entry
end

function damageTurret(entry, amount, attacker)
	if entry.dead then
		return
	end
	local hp = (entry.folder:GetAttribute("Health") or 0) - amount
	entry.folder:SetAttribute("Health", hp)
	if hp &lt;= 0 then
		entry.dead = true
		explode(entry.core.Position, 30, Color3.fromRGB(255, 140, 50))
		entry.folder:Destroy()
		addScore(attacker, Config.Turrets.KillScore)
		addKill(attacker)
		local idx = table.find(turrets, entry)
		if idx then
			table.remove(turrets, idx)
		end
		local mountRef = entry.mount
		task.delay(Config.Turrets.Respawn, function()
			if mountRef and mountRef.Parent then
				buildTurret(mountRef)
			end
		end)
	end
end

-- ---------------------------------------------------------------------------
-- Снаряды
-- ---------------------------------------------------------------------------
local function shootProjectile(from, dir, speed, damage, radius, color)
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(2, 2, 2)
	part.Material = Enum.Material.Neon
	part.Color = color
	part.CanCollide = false
	part.Anchored = true
	part.CFrame = CFrame.new(from)
	part.Parent = fxFolder
	table.insert(projectiles, {
		part = part,
		dir = dir.Unit,
		speed = speed,
		damage = damage,
		radius = radius,
		color = color,
		life = 7,
	})
end

local function nearestDrone(pos, maxDist)
	local best, bestDist, bestPos = nil, maxDist, nil
	for plr, d in pairs(playerData) do
		if d.alive and d.primary and d.primary.Parent then
			local p = d.primary.Position
			local dist = (p - pos).Magnitude
			if dist &lt; bestDist then
				best, bestDist, bestPos = plr, dist, p
			end
		end
	end
	return best, bestPos
end

-- ---------------------------------------------------------------------------
-- Бонусы
-- ---------------------------------------------------------------------------
local function spawnPickup(anchor)
	local p = Instance.new("Part")
	p.Name = "Coolant"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(4.4, 4.4, 4.4)
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(80, 225, 255)
	p.Anchored = true
	p.CanCollide = false
	p.CFrame = anchor.CFrame * CFrame.new(0, 6, 0)
	p.Parent = workspace

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(80, 225, 255)
	light.Brightness = 2.5
	light.Range = 26
	light.Parent = p

	table.insert(pickups, { part = p, anchor = anchor })
end

-- ---------------------------------------------------------------------------
-- Оружие игрока
-- ---------------------------------------------------------------------------
FireRemote.OnServerEvent:Connect(function(player, aimDir)
	local data = playerData[player]
	if not data or not data.alive then
		return
	end
	local wcfg = Config.Weapons.Minigun
	local now = os.clock()
	if now - data.lastFire &lt; wcfg.Interval * 0.75 then
		return
	end
	data.lastFire = now

	if typeof(aimDir) ~= "Vector3" or aimDir.Magnitude &lt; 0.5 then
		return
	end
	local dir = spreadDirection(aimDir, wcfg.Spread)

	local gun = data.guns[((data.gunIndex - 1) % #data.guns) + 1]
	data.gunIndex += 1
	local origin = gun.Position + dir * 3.5

	rayParams.FilterDescendantsInstances = { data.model, fxFolder }
	local result = Workspace:Raycast(origin, dir * wcfg.Range, rayParams)
	local hitPos = result and result.Position or (origin + dir * wcfg.Range)

	if result then
		local hit = result.Instance
		local droneModel, owner = isDroneModel(hit)
		local enemyModel = findWithAttribute(hit, "Enemy")
		local turretFolder = findWithAttribute(hit, "Turret")
		if droneModel and owner and owner ~= player then
			damageDrone(owner, wcfg.Damage, player, "minigun")
		elseif enemyModel then
			damageEnemy(enemyModel, wcfg.Damage, player)
		elseif turretFolder then
			for _, t in ipairs(turrets) do
				if t.folder == turretFolder then
					damageTurret(t, wcfg.Damage, player)
					break
				end
			end
		end
	end

	FireFX:FireAllClients(origin, hitPos, wcfg.Tracer)
end)

BombRemote.OnServerEvent:Connect(function(player)
	local data = playerData[player]
	if not data or not data.alive or not data.cfg.Bomb then
		return
	end
	local bcfg = Config.Weapons.Bomb
	local now = os.clock()
	if now - data.lastBomb &lt; bcfg.Cooldown then
		return
	end
	data.lastBomb = now

	local start = data.primary.Position - Vector3.new(0, 7, 0)
	local model = Instance.new("Model")
	model.Name = "Bomb"

	local bomb = Instance.new("Part")
	bomb.Name = "BombBody"
	bomb.Shape = Enum.PartType.Ball
	bomb.Size = Vector3.new(2.6, 3.4, 2.6)
	bomb.Material = Enum.Material.Metal
	bomb.Color = Color3.fromRGB(52, 50, 54)
	bomb.CanCollide = false
	bomb.Anchored = true
	bomb.CFrame = CFrame.new(start)
	bomb.Parent = model

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 40)
	light.Brightness = 3
	light.Range = 26
	light.Parent = bomb

	local beep = Instance.new("ParticleEmitter")
	beep.Rate = 30
	beep.Lifetime = NumberRange.new(0.3, 0.6)
	beep.Speed = NumberRange.new(2, 6)
	beep.Size = NumberSequence.new(0.8, 0.2)
	beep.Color = ColorSequence.new(Color3.fromRGB(255, 120, 40))
	beep.LightEmission = 1
	beep.Parent = bomb

	model.Parent = workspace
	BombFX:FireAllClients(start)

	local velocity = Vector3.new(0, -bcfg.DropSpeed, 0)
	local pos = start
	local exploded = false

	local function detonate(atPos)
		if exploded then
			return
		end
		exploded = true
		explode(atPos, bcfg.Radius, Color3.fromRGB(255, 170, 60))
		for plr, d in pairs(playerData) do
			if d.alive and d.primary then
				local dist = (d.primary.Position - atPos).Magnitude
				if dist &lt; bcfg.Radius then
					local falloff = 1 - dist / bcfg.Radius
					damageDrone(plr, bcfg.Damage * falloff, plr == player and nil or player, "bomb")
				end
			end
		end
		for _, e in ipairs(enemies) do
			local dist = (e.model:GetPivot().Position - atPos).Magnitude
			if dist &lt; bcfg.Radius * 1.4 then
				damageEnemy(e.model, bcfg.Damage * (1 - dist / (bcfg.Radius * 1.4)) * 1.6, player)
			end
		end
		model:Destroy()
	end

	task.spawn(function()
		local t = 0
		local step = 1 / 30
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model }
		while t &lt; 14 and model.Parent do
			t += step
			velocity += Vector3.new(0, -workspace.Gravity * step, 0)
			local newPos = pos + velocity * step
			local res = workspace:Raycast(pos, newPos - pos, params)
			if res then
				detonate(res.Position)
				return
			end
			pos = newPos
			bomb.CFrame = CFrame.new(pos) * CFrame.Angles(t * 4, t * 6, 0)
			if pos.Y &lt; Config.LavaKillY then
				detonate(pos)
				return
			end
			task.wait(step)
		end
		detonate(pos)
	end)
end)

CrashRemote.OnServerEvent:Connect(function(player, amount)
	local data = playerData[player]
	if not data or not data.alive then
		return
	end
	if typeof(amount) ~= "number" or amount &lt;= 0 then
		return
	end
	damageDrone(player, math.min(amount, 34), nil, "crash")
end)

local VALID_DRONES = {}
for _, d in ipairs(Config.Drones) do
	VALID_DRONES[d.Id] = true
end

RequestDrone.OnServerEvent:Connect(function(player, droneId)
	if typeof(droneId) ~= "string" or not VALID_DRONES[droneId] then
		return
	end
	player:SetAttribute("DroneId", droneId)
	if player:GetAttribute("Alive") then
		-- killPlayer сам возродит игрока уже с новым DroneId
		killPlayer(player, nil, "switch")
	else
		spawnDrone(player, droneId)
	end
end)

-- ---------------------------------------------------------------------------
-- Главный цикл
-- ---------------------------------------------------------------------------
local pickupTimer = 0
local lavaTimer = 0

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	pickupTimer += dt
	lavaTimer += dt

	-- враги: держим дистанцию и стреляем
	for i = #enemies, 1, -1 do
		local e = enemies[i]
		local core = e.model.PrimaryPart
		if not e.model.Parent or not core then
			table.remove(enemies, i)
			continue
		end
		local _, targetPos = nearestDrone(core.Position, 1600)
		local alignPos = core:FindFirstChildOfClass("AlignPosition")
		local alignOr = core:FindFirstChildOfClass("AlignOrientation")
		if targetPos then
			e.phase += dt * 0.55
			local orbitDir = Vector3.new(math.cos(e.phase), 0, math.sin(e.phase))
			if alignPos then
				alignPos.Position = targetPos + orbitDir * e.orbit + Vector3.new(0, e.height, 0)
			end
			if alignOr and (targetPos - core.Position).Magnitude &gt; 2 then
				alignOr.CFrame = CFrame.lookAt(core.Position, targetPos)
			end
			if now &gt;= e.nextFire then
				e.nextFire = now + Config.Enemies.FireInterval * (0.7 + math.random() * 0.6)
				local from = core.Position + (targetPos - core.Position).Unit * 4
				shootProjectile(from, targetPos - from, Config.Enemies.ProjectileSpeed,
					Config.Enemies.ProjectileDamage, 9, Color3.fromRGB(255, 90, 30))
			end
		elseif alignPos then
			e.phase += dt * 0.3
			alignPos.Position = core.Position + Vector3.new(math.cos(e.phase) * 30, 0, math.sin(e.phase) * 30)
		end

		if core.Position.Y &lt; Config.LavaKillY then
			explode(core.Position, 18, Color3.fromRGB(255, 120, 40))
			e.model:Destroy()
			table.remove(enemies, i)
		end
	end

	-- турели
	for _, t in ipairs(turrets) do
		if t.folder.Parent then
			local _, targetPos = nearestDrone(t.core.Position, Config.Turrets.Range)
			if targetPos then
				t.barrel.CFrame = CFrame.lookAt(t.core.Position, targetPos) * CFrame.new(0, 0, -4)
				if now &gt;= t.nextFire then
					t.nextFire = now + Config.Turrets.FireInterval
					shootProjectile(t.barrel.Position, targetPos - t.barrel.Position,
						Config.Turrets.ProjectileSpeed, Config.Turrets.ProjectileDamage, 12,
						Color3.fromRGB(255, 130, 40))
				end
			end
		end
	end

	-- снаряды
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		p.life -= dt
		if p.life &lt;= 0 or not p.part.Parent then
			if p.part.Parent then
				p.part:Destroy()
			end
			table.remove(projectiles, i)
			continue
		end
		local step = p.dir * p.speed * dt
		local res = workspace:Raycast(p.part.Position, step, projectileParams)
		if res then
			local _, owner = isDroneModel(res.Instance)
			if owner then
				damageDrone(owner, p.damage, nil, "enemy")
			end
			explode(res.Position, p.radius, p.color)
			p.part:Destroy()
			table.remove(projectiles, i)
			continue
		end
		local newPos = p.part.Position + step
		p.part.CFrame = CFrame.new(newPos)
		if newPos.Y &lt; Config.LavaKillY then
			explode(newPos, p.radius, p.color)
			p.part:Destroy()
			table.remove(projectiles, i)
		end
	end

	-- бонусы
	if pickupTimer &gt; 0.16 then
		pickupTimer = 0
		for i = #pickups, 1, -1 do
			local pk = pickups[i]
			if not pk.part.Parent then
				table.remove(pickups, i)
				continue
			end
			pk.part.CFrame = pk.part.CFrame * CFrame.Angles(0, 0.07, 0)
			for plr, d in pairs(playerData) do
				if d.alive and d.primary and (d.primary.Position - pk.part.Position).Magnitude &lt; 12 then
					local max = d.model:GetAttribute("MaxHealth") or 100
					local hp = d.model:GetAttribute("Health") or 0
					d.model:SetAttribute("Health", math.min(max, hp + Config.Pickups.Heal))
					addScore(plr, Config.Pickups.Score)
					DamageFX:FireClient(plr, -Config.Pickups.Heal, "heal")
					local anchor = pk.anchor
					pk.part:Destroy()
					table.remove(pickups, i)
					task.delay(Config.Pickups.Respawn, function()
						if anchor and anchor.Parent then
							spawnPickup(anchor)
						end
					end)
					break
				end
			end
		end
	end

	-- лава и границы арены
	if lavaTimer &gt; 0.2 then
		lavaTimer = 0
		for plr, d in pairs(playerData) do
			if d.alive and d.primary then
				local pos = d.primary.Position
				if pos.Y &lt; Config.LavaKillY then
					killPlayer(plr, nil, "lava")
				elseif pos.Magnitude &gt; Config.ArenaRadius then
					damageDrone(plr, 15, nil, "bounds")
				end
			end
		end
	end
end)

-- ---------------------------------------------------------------------------
-- Волны
-- ---------------------------------------------------------------------------
local function waveLoop()
	task.wait(Config.Waves.FirstDelay)
	while true do
		waveNumber += 1
		announce("ВОЛНА " .. waveNumber, 3.5)

		for _, d in pairs(playerData) do
			if d.alive and d.model then
				local max = d.model:GetAttribute("MaxHealth") or 100
				local hp = d.model:GetAttribute("Health") or 0
				d.model:SetAttribute("Health", math.min(max, hp + max * 0.25))
			end
		end

		local toSpawn = math.min(Config.Enemies.MaxAlive,
			Config.Waves.BaseCount + (waveNumber - 1) * Config.Waves.CountPerWave)
		for i = 1, toSpawn do
			task.spawn(function()
				task.wait((i - 1) * 1.2)
				if #enemies &lt; Config.Enemies.MaxAlive then
					spawnEnemy(waveNumber)
				end
			end)
		end

		-- ждём, пока все враги волны действительно появятся
		task.wait(toSpawn * 1.2 + 2.0)

		while #enemies &gt; 0 do
			task.wait(1)
		end

		announce("ВОЛНА " .. waveNumber .. " ОЧИЩЕНА", 3)
		task.wait(Config.Waves.Intermission)
	end
end

-- ---------------------------------------------------------------------------
-- Игроки
-- ---------------------------------------------------------------------------
local function onPlayerAdded(player)
	setupLeaderstats(player)
	player:SetAttribute("Alive", false)
	player:SetAttribute("Deaths", 0)
	player:SetAttribute("Score", 0)
	player:SetAttribute("Kills", 0)
	player:SetAttribute("Wave", waveNumber)
	player.CharacterAdded:Connect(function(char)
		task.defer(function()
			if char and char.Parent then
				char:Destroy()
			end
		end)
	end)
	task.delay(1, function()
		if player.Parent then
			spawnDrone(player, Config.DefaultDrone)
		end
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end
Players.PlayerAdded:Connect(onPlayerAdded)

Players.PlayerRemoving:Connect(function(player)
	local data = playerData[player]
	if data then
		local model = data.model
		playerData[player] = nil
		if model then
			droneOwners[model] = nil
			model:Destroy()
		end
	end
end)

-- ---------------------------------------------------------------------------
-- Запуск мира
-- ---------------------------------------------------------------------------
for _, mount in ipairs(turretMounts:GetChildren()) do
	task.delay(math.random() * 2, function()
		buildTurret(mount)
	end)
end

for _, anchor in ipairs(pickupAnchors:GetChildren()) do
	if anchor:IsA("BasePart") then
		task.delay(math.random() * 4, function()
			spawnPickup(anchor)
		end)
	end
end

task.spawn(waveLoop)

print("[Drone] «Лавовый каньон»: сервер запущен.")
</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX2005">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="Folder" referent="RBX2006">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX2007">
        <Properties>
          <string name="Name">DroneClient</string>
          <string name="Source">--!nonstrict
--[[
	DroneClient -- клиентская часть.

	Здесь живёт «физика» дрона. Она сделана по-настоящему, а не через
	CFrame-телепортацию:

	  * тяга -- VectorForce вдоль локальной оси «вверх» корпуса;
	    гравитация настоящая, поэтому при крене дрон честно «съезжает» вниз;
	  * ориентация -- AlignOrientation (упругий гироскоп с инерцией),
	    MaxTorque масштабируется от массы, поэтому тяжёлый дрон чувствуется
	    тяжёлым;
	  * сопротивление воздуха -- линейное + квадратичное (F = -(k1*v + k2*v|v|)),
	    поэтому есть настоящая максимальная скорость и «планирование»;
	  * порывы ветра, эффект экрана земли, инерция разгона и торможения.

	Управление: WASD -- крен/тангаж, Q/E -- рыскание, Space/Shift -- тяга,
	ЛКМ -- миниганы, X -- бомба, F -- вид от первого лица, 1/2 -- смена дрона.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("DroneConfig"))
local DroneUI = require(script.Parent:WaitForChild("DroneUI"))

local remotes = ReplicatedStorage:WaitForChild("DroneRemotes")
local SetDrone = remotes:WaitForChild("SetDrone")
local DroneLost = remotes:WaitForChild("DroneLost")
local FireRemote = remotes:WaitForChild("Fire")
local FireFX = remotes:WaitForChild("FireFX")
local BombRemote = remotes:WaitForChild("Bomb")
local BombFX = remotes:WaitForChild("BombFX")
local ExplosionFX = remotes:WaitForChild("ExplosionFX")
local Banner = remotes:WaitForChild("Banner")
local CrashRemote = remotes:WaitForChild("Crash")
local DamageFX = remotes:WaitForChild("DamageFX")
local RequestDrone = remotes:WaitForChild("RequestDrone")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local P = Config.Physics
local W = Config.Weapons

camera.CameraType = Enum.CameraType.Scriptable
camera.FieldOfView = 74

-- ---------------------------------------------------------------------------
-- Состояние
-- ---------------------------------------------------------------------------
local state = {
	drone = nil,          -- {model, primary, cfg, guns, camera}
	align = nil,
	thrust = nil,
	drag = nil,
	mass = 100,
	collective = P.CollectiveIdle,
	tiltX = 0,            -- текущий тангаж (градусы)
	tiltZ = 0,            -- текущий крен
	yaw = 0,              -- текущий курс
	lastFire = 0,
	heat = 0,
	overheated = false,
	alive = false,
	lastCrash = 0,
	camYaw = 0,
	camPitch = -16,
	camDist = 38,
	camMode = "chase",    -- chase | fpv
	shake = 0,
	shakeSeed = 0,
	velocityPrev = Vector3.zero,
	windPhase = 0,
	zoom = 1,
	landedOn = nil,
	lastDamaged = 0,
}

local inputState = {
	forward = 0,
	right = 0,
	up = 0,
	yaw = 0,
	fire = false,
}

local ui
ui = DroneUI.new({
	onSwitchDrone = function(id)
		RequestDrone:FireServer(id)
	end,
	onBomb = function()
		if state.drone and state.drone.cfg.Bomb then
			BombRemote:FireServer()
		end
	end,
	onToggleCamera = function()
		state.camMode = (state.camMode == "chase") and "fpv" or "chase"
		ui:setCameraMode(state.camMode)
	end,
})

-- ---------------------------------------------------------------------------
-- Мелочи
-- ---------------------------------------------------------------------------
local function lerp(a, b, t)
	return a + (b - a) * math.clamp(t, 0, 1)
end

local function lerpAngle(a, b, t)
	local diff = (b - a + 540) % 360 - 180
	return a + diff * math.clamp(t, 0, 1)
end

local function findNamed(root, name)
	local n = (name:lower():gsub("[%s_%-]", ""))
	for _, d in ipairs(root:GetDescendants()) do
		if (d.Name:lower():gsub("[%s_%-]", "")) == n then
			return d
		end
	end
	return nil
end

local function shaking()
	state.shake = math.max(state.shake, 0)
	return CFrame.Angles(
		math.noise(state.shakeSeed, os.clock() * 22) * state.shake,
		math.noise(state.shakeSeed + 5, os.clock() * 19) * state.shake,
		math.noise(state.shakeSeed + 9, os.clock() * 17) * state.shake * 0.6)
end

-- ---------------------------------------------------------------------------
-- Эффекты
-- ---------------------------------------------------------------------------
local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientFX"
fxFolder.Parent = Workspace

local function tracer(origin, target, color)
	local dist = (target - origin).Magnitude
	if dist &lt; 0.6 then
		return
	end
	local beam = Instance.new("Part")
	beam.Name = "Tracer"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = color or W.Minigun.Tracer
	beam.Size = Vector3.new(0.22, 0.22, dist)
	beam.CFrame = CFrame.lookAt(origin + (target - origin) / 2, target)
	beam.Transparency = 0.05
	beam.Parent = fxFolder
	TweenService:Create(beam, TweenInfo.new(0.09), { Transparency = 1 }):Play()
	Debris:AddItem(beam, 0.14)

	local flash = Instance.new("PointLight")
	flash.Color = color or W.Minigun.Tracer
	flash.Brightness = 4
	flash.Range = 26
	flash.Parent = beam

	-- искры в точке попадания
	local hit = Instance.new("ParticleEmitter")
	hit.Rate = 0
	hit.Lifetime = NumberRange.new(0.2, 0.5)
	hit.Speed = NumberRange.new(10, 26)
	hit.SpreadAngle = Vector2.new(180, 180)
	hit.Size = NumberSequence.new(0.5, 0)
	hit.Color = ColorSequence.new(color or W.Minigun.Tracer)
	hit.LightEmission = 1
	hit.Enabled = false
	hit.Parent = beam
	hit:Emit(6)
end

local function explosion(position, radius, color)
	local sphere = Instance.new("Part")
	sphere.Shape = Enum.PartType.Ball
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.CanQuery = false
	sphere.CastShadow = false
	sphere.Material = Enum.Material.Neon
	sphere.Color = color
	sphere.Size = Vector3.new(4, 4, 4)
	sphere.CFrame = CFrame.new(position)
	sphere.Transparency = 0.15
	sphere.Parent = fxFolder

	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 12
	light.Range = radius * 3
	light.Parent = sphere

	local sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 0
	sparks.Lifetime = NumberRange.new(0.4, 1.1)
	sparks.Speed = NumberRange.new(radius * 1.6, radius * 3.4)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Size = NumberSequence.new(1.8, 0)
	sparks.Color = ColorSequence.new(color, Color3.fromRGB(90, 20, 0))
	sparks.LightEmission = 1
	sparks.Acceleration = Vector3.new(0, -40, 0)
	sparks.Parent = sphere
	sparks:Emit(40)

	local smoke = Instance.new("ParticleEmitter")
	smoke.Rate = 0
	smoke.Lifetime = NumberRange.new(1.2, 2.4)
	smoke.Speed = NumberRange.new(6, 18)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Size = NumberSequence.new(radius * 0.6, radius * 1.8)
	smoke.Color = ColorSequence.new(Color3.fromRGB(60, 40, 34), Color3.fromRGB(24, 18, 18))
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = sphere
	smoke:Emit(18)

	TweenService:Create(sphere, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(radius * 2, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(sphere, 0.6)

	local dist = (camera.CFrame.Position - position).Magnitude
	state.shake = math.max(state.shake, math.clamp(radius / math.max(dist, 20) * 0.06, 0, 0.09))
	state.shakeSeed = math.random() * 100
end

FireFX.OnClientEvent:Connect(function(origin, target, color)
	tracer(origin, target, color)
end)

ExplosionFX.OnClientEvent:Connect(function(position, radius, color)
	explosion(position, radius, color)
end)

BombFX.OnClientEvent:Connect(function(position)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(3, 3, 3)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 120, 40)
	p.Transparency = 0.4
	p.CFrame = CFrame.new(position)
	p.Parent = fxFolder
	TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	Debris:AddItem(p, 0.3)
end)

Banner.OnClientEvent:Connect(function(text, duration)
	ui:banner(text, duration)
end)

DamageFX.OnClientEvent:Connect(function(amount, reason)
	if amount &gt; 0 then
		ui:damageFlash(false)
		state.shake = math.max(state.shake, 0.012 + math.min(amount / 140, 0.05))
		state.shakeSeed = math.random() * 100
		state.lastDamaged = os.clock()
		if reason == "crash" then
			ui:toast("ЖЁСТКОЕ СТОЛКНОВЕНИЕ", Color3.fromRGB(255, 190, 90))
		end
	else
		ui:damageFlash(true)
		ui:toast("+" .. math.floor(-amount) .. " РЕМОНТ", Color3.fromRGB(120, 255, 190))
	end
end)

-- ---------------------------------------------------------------------------
-- Управление (клавиатура + мышь + тач)
-- ---------------------------------------------------------------------------
local keys = {}

UserInputService.InputBegan:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		keys[input.KeyCode] = true
		if input.KeyCode == Enum.KeyCode.F then
			ui:callToggleCamera()
		end
		if input.KeyCode == Enum.KeyCode.One then
			RequestDrone:FireServer("scout")
		elseif input.KeyCode == Enum.KeyCode.Two then
			RequestDrone:FireServer("gunship")
		end
		if input.KeyCode == Enum.KeyCode.X then
			ui:callBomb()
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		keys.fire = true
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		state.zoom = 1.6
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		keys[input.KeyCode] = false
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		keys.fire = false
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		state.zoom = 1
	end
end)

UserInputService.InputChanged:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		state.camDist = math.clamp(state.camDist - input.Position.Z * 3, 16, 78)
	end
end)

if not UserInputService.TouchEnabled then
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
end

local function readKeyboard(dt)
	local f = 0
	local r = 0
	local u = 0
	local y = 0
	if keys[Enum.KeyCode.W] then f += 1 end
	if keys[Enum.KeyCode.S] then f -= 1 end
	if keys[Enum.KeyCode.A] then r -= 1 end
	if keys[Enum.KeyCode.D] then r += 1 end
	if keys[Enum.KeyCode.Space] then u += 1 end
	if keys[Enum.KeyCode.LeftShift] or keys[Enum.KeyCode.LeftControl] then u -= 1 end
	if keys[Enum.KeyCode.Q] then y -= 1 end
	if keys[Enum.KeyCode.E] then y += 1 end

	if not UserInputService.TouchEnabled and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
	local delta = UserInputService:GetMouseDelta()
	state.camYaw -= delta.X * 0.22
	state.camPitch = math.clamp(state.camPitch - delta.Y * 0.18, -72, 34)

	local virtual = ui:getVirtualInput()
	inputState.forward = math.clamp(f + virtual.y, -1, 1)
	inputState.right = math.clamp(r + virtual.x, -1, 1)
	inputState.up = math.clamp(u + virtual.up, -1, 1)
	inputState.yaw = math.clamp(y + virtual.yaw, -1, 1)
	inputState.fire = (keys.fire == true) or virtual.fire
end

-- ---------------------------------------------------------------------------
-- Сборка контроллера
-- ---------------------------------------------------------------------------
local function teardown()
	local d = state.drone
	state.drone = nil
	state.alive = false
	state.align = nil
	state.thrust = nil
	state.drag = nil
	if d then
		local primary = d.primary
		if primary and primary.Parent then
			for _, name in ipairs({ "DroneAlign", "DroneThrust", "DroneDrag", "DroneBody",
				"DroneThrustDir" }) do
				local inst = primary:FindFirstChild(name)
				if inst then
					inst:Destroy()
				end
			end
		end
	end
	ui:setDrone(nil)
end

local function buildController(model, droneId)
	teardown()

	local cfg = Config.getDrone(droneId)
	local primary = model.PrimaryPart
	if not primary then
		local best, bestVol = nil, -1
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				local v = p.Size.X * p.Size.Y * p.Size.Z
				if v &gt; bestVol then
					best, bestVol = p, v
				end
			end
		end
		primary = best
		model.PrimaryPart = primary
	end
	if not primary then
		return
	end

	local bodyAtt = Instance.new("Attachment")
	bodyAtt.Name = "DroneBody"
	bodyAtt.Parent = primary

	local align = Instance.new("AlignOrientation")
	align.Name = "DroneAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = bodyAtt
	align.RigidityEnabled = false
	align.ReactionTorqueEnabled = true
	align.MaxTorque = math.clamp(primary.AssemblyMass * 3000, 120000, 4000000)
	align.Responsiveness = P.TiltResponsiveness * cfg.Agility
	align.CFrame = primary.CFrame
	align.Parent = primary

	local thrustAtt = Instance.new("Attachment")
	thrustAtt.Name = "DroneThrustDir"
	thrustAtt.Parent = primary

	local thrust = Instance.new("VectorForce")
	thrust.Name = "DroneThrust"
	thrust.Attachment0 = thrustAtt
	thrust.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	thrust.ApplyAtCenterOfMass = true
	thrust.Force = Vector3.zero
	thrust.Parent = primary

	local drag = Instance.new("VectorForce")
	drag.Name = "DroneDrag"
	drag.ApplyAtCenterOfMass = true
	drag.Force = Vector3.zero
	drag.Parent = primary

	local guns = {}
	for _, n in ipairs({ "minigan one", "minigan two" }) do
		local g = findNamed(model, n)
		if g and g:IsA("BasePart") then
			table.insert(guns, g)
		end
	end
	if #guns == 0 then
		guns = { primary }
	end

	local camPart = findNamed(model, "camera")

	-- пыль от винтов: красиво и сразу читается как «дрон»
	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Downwash"
	dust.Rate = 0
	dust.Lifetime = NumberRange.new(0.5, 1.1)
	dust.Speed = NumberRange.new(18, 34)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.Size = NumberSequence.new(2.4, 0.2)
	dust.Color = ColorSequence.new(Color3.fromRGB(150, 120, 100), Color3.fromRGB(60, 44, 36))
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 1) })
	dust.Acceleration = Vector3.new(0, -14, 0)
	dust.EmissionDirection = Enum.NormalId.Bottom
	dust.Parent = primary

	local engine = Instance.new("PointLight")
	engine.Name = "EngineGlow"
	engine.Color = cfg.Tint
	engine.Brightness = 2
	engine.Range = 26
	engine.Parent = primary

	state.drone = {
		model = model,
		primary = primary,
		cfg = cfg,
		guns = guns,
		cameraPart = camPart,
		dust = dust,
		align = align,
		alignCFrame = primary.CFrame,
	}
	state.align = align
	state.thrust = thrust
	state.drag = drag
	state.mass = primary.AssemblyMass
	state.collective = P.CollectiveIdle
	state.tiltX = 0
	state.tiltZ = 0
	state.yaw = select(2, primary.CFrame:ToEulerAnglesYXZ())
	state.heat = 0
	state.overheated = false
	state.alive = true
	state.velocityPrev = primary.AssemblyLinearVelocity
	state.camYaw = state.yaw
	ui:setDrone(cfg)
	ui:setCameraMode(state.camMode)

	-- начальный «толчок» эффектов
	ui:toast("ДРОН ГОТОВ: " .. cfg.Title, cfg.Tint)
end

SetDrone.OnClientEvent:Connect(function(model, droneId)
	if model and model:IsA("Model") then
		buildController(model, droneId)
		-- ждём, пока сервер отдаст владение физикой
		task.delay(0.1, function()
			if state.drone and state.drone.model == model and model.PrimaryPart then
				state.mass = model.PrimaryPart.AssemblyMass
			end
		end)
	else
		teardown()
	end
end)

DroneLost.OnClientEvent:Connect(function(reason)
	teardown()
	local text = "ДРОН УНИЧТОЖЕН"
	if reason == "lava" then
		text = "ЛАВА! ДРОН РАСПЛАВИЛСЯ"
	elseif reason == "crash" then
		text = "ЖЁСТКАЯ ПОСАДКА"
	elseif reason == "switch" then
		text = "СМЕНА ДРОНА"
	end
	ui:banner(text, 3)
end)

-- ---------------------------------------------------------------------------
-- Физика: главный цикл
-- ---------------------------------------------------------------------------
local function windVector(dt)
	state.windPhase += dt * 0.35
	local t = os.clock() * 0.5
	return Vector3.new(
		math.noise(state.windPhase, t) * P.WindStrength,
		math.noise(state.windPhase + 10, t * 0.7) * P.WindStrength * 0.35,
		math.noise(state.windPhase + 20, t * 0.9) * P.WindStrength)
end

local downRay = RaycastParams.new()
downRay.FilterType = Enum.RaycastFilterType.Exclude
downRay.FilterDescendantsInstances = { fxFolder }

local groundFt = 0
local groundTimer = 0

local function stepPhysics(dt)
	local d = state.drone
	if not d or not d.primary or not d.primary.Parent then
		return
	end
	local primary = d.primary
	local cfg = d.cfg

	readKeyboard(dt)

	state.mass = math.max(primary.AssemblyMass, 1)
	local hover = state.mass * Workspace.Gravity

	-- ------------------------------------------------------------- курс
	local hasStick = math.abs(inputState.forward) + math.abs(inputState.right) &gt; 0.08
	if inputState.yaw ~= 0 then
		state.yaw += inputState.yaw * P.YawRate * cfg.Agility * dt
		state.camYaw = lerpAngle(state.camYaw, state.yaw, dt * 3.4)
	elseif hasStick then
		state.yaw = lerpAngle(state.yaw, state.camYaw, dt * P.YawFollowLerp * cfg.Agility)
	end

	-- ------------------------------------------------------------- крен/тангаж
	local maxTilt = P.MaxTilt
	local targetPitch = -inputState.forward * maxTilt
	local targetRoll = inputState.right * maxTilt * 1.05
	-- крен в поворот для «живого» поведения
	targetRoll += math.clamp(inputState.yaw * 9, -9, 9)
	state.tiltX = lerp(state.tiltX, targetPitch, dt * P.TiltResponsiveness * cfg.Agility)
	state.tiltZ = lerp(state.tiltZ, targetRoll, dt * P.TiltResponsiveness * cfg.Agility)

	local desired = CFrame.fromEulerAnglesYXZ(
		math.rad(state.tiltX), math.rad(state.yaw), math.rad(state.tiltZ))

	if state.align then
		state.align.CFrame = CFrame.new(primary.Position) * desired
	end

	-- ------------------------------------------------------------- тяга
	local targetCollective = P.CollectiveIdle + inputState.up * 0.6
	if inputState.up &gt; 0 then
		targetCollective = P.CollectiveUp
	elseif inputState.up &lt; 0 then
		targetCollective = P.CollectiveDown
	end
	state.collective = lerp(state.collective, targetCollective, dt * P.CollectiveLerp)

	-- эффект экрана земли: у самой поверхности винты «отталкиваются»
	groundTimer += dt
	if groundTimer &gt; 0.08 then
		groundTimer = 0
		local res = Workspace:Raycast(primary.Position, Vector3.new(0, -P.GroundEffectHeight, 0), downRay)
		groundFt = res and 1 or 0
	end
	local collective = state.collective * (groundFt &gt; 0 and (1 + P.GroundEffectBoost) or 1)

	if state.thrust then
		state.thrust.Force = Vector3.new(0, hover * collective * cfg.Thrust, 0)
	end

	-- ------------------------------------------------------------- воздух
	local velocity = primary.AssemblyLinearVelocity
	local air = velocity - windVector(dt)
	local speed = air.Magnitude
	if state.drag then
		if speed &gt; 0.05 then
			local coef = state.mass * (P.LinearDrag * speed + P.QuadDrag * speed * speed)
			state.drag.Force = -(air.Unit * coef)
		else
			state.drag.Force = Vector3.zero
		end
	end

	-- ------------------------------------------------------------- пыль/звук винтов
	if d.dust then
		d.dust.Rate = (state.collective &gt; 1.02 and speed &lt; 60) and 26 or 0
	end

	-- ------------------------------------------------------------- столкновения
	local deltaV = (velocity - state.velocityPrev).Magnitude
	local prevSpeed = state.velocityPrev.Magnitude
	if deltaV &gt; 34 and prevSpeed &gt; 42 and os.clock() - state.lastCrash &gt; 0.75 then
		state.lastCrash = os.clock()
		local dmg = math.clamp((deltaV - 34) * P.CrashDamageScale, 0, 30)
		if dmg &gt; 1 then
			CrashRemote:FireServer(dmg)
			state.shake = math.max(state.shake, math.min(dmg / 90, 0.06))
			state.shakeSeed = math.random() * 100
		end
	end
	state.velocityPrev = velocity

	-- ------------------------------------------------------------- оружие
	if inputState.fire then
		local now = os.clock()
		if now - state.lastFire &gt;= W.Minigun.Interval and not state.overheated then
			state.lastFire = now
			FireRemote:FireServer(camera.CFrame.LookVector)
			state.heat = math.min(1, state.heat + W.Minigun.HeatPerShot)

			-- локальная отдача
			state.shake = math.max(state.shake, 0.004)
			state.shakeSeed = math.random() * 100

			-- дымок из ствола
			if d.dust then
				d.dust:Emit(1)
			end
		end
	end
	state.heat = math.max(0, state.heat - W.Minigun.CoolRate * dt)
	if state.heat &gt;= 1 then
		state.overheated = true
	end
	if state.overheated and state.heat &lt; 0.35 then
		state.overheated = false
	end

	-- ------------------------------------------------------------- HUD
	local health = d.model:GetAttribute("Health") or 0
	local maxHealth = d.model:GetAttribute("MaxHealth") or cfg.Health
	local stats = player:FindFirstChild("leaderstats")
	ui:update({
		health = health,
		maxHealth = maxHealth,
		heat = state.heat,
		overheated = state.overheated,
		speed = velocity.Magnitude,
		altitude = primary.Position.Y,
		score = player:GetAttribute("Score") or 0,
		kills = player:GetAttribute("Kills") or 0,
		wave = player:GetAttribute("Wave") or 1,
		collective = state.collective,
		bombReady = d.cfg.Bomb and (os.clock() - 0 &gt;= 0) or false,
		alive = state.alive,
		ammo = math.floor((1 - state.heat) * 100),
	})
end

-- ---------------------------------------------------------------------------
-- Камера
-- ---------------------------------------------------------------------------
local camPos = Vector3.new(0, 90, 130)
local camLook = Vector3.new(0, 40, 0)

local function updateCamera(dt)
	local d = state.drone
	if not d or not d.primary or not d.primary.Parent then
		-- дрон уничтожен: плавно облетаем арену
		state.camYaw += dt * 4
		local radius = 260
		local pos = Vector3.new(math.sin(math.rad(state.camYaw)) * radius, 130,
			math.cos(math.rad(state.camYaw)) * radius)
		camPos = camPos:Lerp(pos, math.clamp(dt * 1.6, 0, 1))
		camLook = camLook:Lerp(Vector3.new(0, 20, 0), math.clamp(dt * 1.6, 0, 1))
		camera.CFrame = CFrame.lookAt(camPos, camLook) * shaking()
		camera.Focus = CFrame.new(camLook)
		return
	end

	local primary = d.primary
	local velocity = primary.AssemblyLinearVelocity
	local speed = velocity.Magnitude

	if state.camMode == "fpv" then
		local camPart = d.cameraPart
		local base = primary.CFrame
		if camPart then
			base = camPart.CFrame
		end
		local fwd = base.LookVector
		local pos = base.Position + fwd * 3.2 + base.UpVector * 0.35
		camera.CFrame = CFrame.lookAt(pos, pos + fwd * 100, base.UpVector) * shaking()
		camera.FieldOfView = 88
		camera.Focus = CFrame.new(pos + fwd * 60)
	else
		local dist = state.camDist * state.zoom * (1 + math.clamp(speed / 900, 0, 0.14))
		local yaw = math.rad(state.camYaw)
		local pitch = math.rad(state.camPitch)
		local rot = CFrame.fromEulerAnglesYXZ(pitch + 0.12, yaw, 0)
		local targetPos = primary.Position + (rot * Vector3.new(0, 2.2, dist))
		-- не залезать в геометрию
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { d.model, fxFolder }
		local res = Workspace:Raycast(primary.Position, targetPos - primary.Position, params)
		if res then
			targetPos = res.Position + res.Normal * 2.4
		end

		camPos = camPos:Lerp(targetPos, math.clamp(dt * 6.5, 0, 1))
		local lookAt = primary.Position + velocity * 0.09 + Vector3.new(0, 1.5, 0)
		camLook = camLook:Lerp(lookAt, math.clamp(dt * 9, 0, 1))
		camera.CFrame = CFrame.lookAt(camPos, camLook) * shaking()
		camera.FieldOfView = lerp(camera.FieldOfView, 74 + math.clamp(speed / 8, 0, 14), dt * 3)
		camera.Focus = CFrame.new(camLook)
	end
end

RunService.Heartbeat:Connect(function(dt)
	if state.alive then
		stepPhysics(dt)
	end
	updateCamera(dt)
	state.shake *= 0.92
end)

-- ---------------------------------------------------------------------------
-- Стартовый экран / ожидание
-- ---------------------------------------------------------------------------
ui:banner("ЛАВОВЫЙ КАНЬОН", 4)
task.delay(4.5, function()
	ui:banner("WASD — полёт    SPACE — вверх    ЛКМ — огонь", 4)
end)
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX2008">
        <Properties>
          <string name="Name">DroneUI</string>
          <string name="Source">--!nonstrict
--[[
	DroneUI -- весь интерфейс игры создаётся кодом (никаких ассетов):
	прицел, здоровье, перегрев оружия, скорость/высота, счёт, волны,
	кнопки смены дрона и мобильное управление.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local ORANGE = Color3.fromRGB(255, 132, 40)
local AMBER = Color3.fromRGB(255, 196, 92)
local CYAN = Color3.fromRGB(96, 226, 255)
local RED = Color3.fromRGB(255, 74, 60)
local GREEN = Color3.fromRGB(110, 255, 170)
local DARK = Color3.fromRGB(18, 14, 14)

local FONT_BOLD = Enum.Font.GothamBlack
local FONT_MED = Enum.Font.GothamMedium

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or ORANGE
	s.Thickness = thickness or 1.5
	s.Transparency = transparency or 0.25
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function gradient(parent, c1, c2, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

local function newLabel(parent, props)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = FONT_MED
	t.TextColor3 = Color3.fromRGB(255, 240, 230)
	t.TextSize = 16
	t.TextXAlignment = Enum.TextXAlignment.Left
	for k, v in pairs(props or {}) do
		t[k] = v
	end
	t.Parent = parent
	return t
end

local function newPanel(parent, size, position, transparency)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = position
	f.BackgroundColor3 = DARK
	f.BackgroundTransparency = transparency or 0.35
	f.BorderSizePixel = 0
	f.Parent = parent
	corner(f, 10)
	stroke(f, ORANGE, 1.5, 0.55)
	return f
end

-- --------------------------------------------------------------------------- #
-- модуль
-- --------------------------------------------------------------------------- #
local DroneUI = {}
DroneUI.__index = DroneUI

function DroneUI.new(callbacks)
	local self = setmetatable({}, DroneUI)
	self.callbacks = callbacks or {}
	self.cache = {}
	self.virtual = { x = 0, y = 0, up = 0, yaw = 0, fire = false }

	local gui = Instance.new("ScreenGui")
	gui.Name = "DroneHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = player:WaitForChild("PlayerGui")
	self.gui = gui

	-- ------------------------------------------------------------- виньетка урона
	local vignette = Instance.new("Frame")
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.BackgroundColor3 = RED
	vignette.BackgroundTransparency = 1
	vignette.BorderSizePixel = 0
	vignette.ZIndex = 2
	vignette.Parent = gui
	self.vignette = vignette

	-- ------------------------------------------------------------- прицел
	local cross = Instance.new("Frame")
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(54, 54)
	cross.BackgroundTransparency = 1
	cross.Parent = gui
	self.cross = cross

	for i, cfg in ipairs({
		{ UDim2.fromOffset(2, 12), UDim2.fromOffset(20, 0), 0 },     -- left
		{ UDim2.fromOffset(2, 12), UDim2.fromOffset(32, 0), 0 },     -- right
		{ UDim2.fromOffset(12, 2), UDim2.fromOffset(0, 20), 0 },     -- top
		{ UDim2.fromOffset(12, 2), UDim2.fromOffset(0, 32), 0 },     -- bottom
	}) do
		local bar = Instance.new("Frame")
		bar.Size = cfg[1]
		bar.Position = cfg[2]
		bar.BackgroundColor3 = AMBER
		bar.BorderSizePixel = 0
		bar.Parent = cross
		corner(bar, 2)
	end
	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(4, 4)
	dot.Position = UDim2.fromOffset(25, 25)
	dot.BackgroundColor3 = AMBER
	dot.BorderSizePixel = 0
	dot.Parent = cross
	corner(dot, 4)
	self.crossDot = dot

	-- ------------------------------------------------------------- верх: волна
	local wavePanel = newPanel(gui, UDim2.fromOffset(220, 44), UDim2.new(0.5, -110, 0, 18), 0.4)
	wavePanel.AnchorPoint = Vector2.new(0, 0)
	local waveLabel = newLabel(wavePanel, {
		Size = UDim2.fromScale(1, 0.62),
		Position = UDim2.fromScale(0, 0.04),
		Text = "ВОЛНА 1",
		Font = FONT_BOLD,
		TextSize = 20,
		TextColor3 = ORANGE,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local waveSub = newLabel(wavePanel, {
		Size = UDim2.fromScale(1, 0.4),
		Position = UDim2.fromScale(0, 0.58),
		Text = "ЛАВОВЫЙ КАНЬОН",
		TextSize = 11,
		TextColor3 = Color3.fromRGB(200, 170, 150),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.waveLabel = waveLabel
	self.waveSub = waveSub

	-- ------------------------------------------------------------- левый верх: дрон
	local status = newPanel(gui, UDim2.fromOffset(292, 104), UDim2.fromOffset(18, 18), 0.4)
	local droneName = newLabel(status, {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.fromOffset(200, 20),
		Text = "ДРОН",
		Font = FONT_BOLD,
		TextSize = 16,
		TextColor3 = ORANGE,
	})
	self.droneName = droneName

	local function makeBar(parent, y, width, color)
		local back = Instance.new("Frame")
		back.Position = UDim2.fromOffset(12, y)
		back.Size = UDim2.fromOffset(width, 12)
		back.BackgroundColor3 = Color3.fromRGB(40, 30, 28)
		back.BorderSizePixel = 0
		back.Parent = parent
		corner(back, 6)
		local fill = Instance.new("Frame")
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = color
		fill.BorderSizePixel = 0
		fill.Parent = back
		corner(fill, 6)
		return back, fill
	end

	local healthBack, healthFill = makeBar(status, 34, 268, RED)
	gradient(healthFill, RED, Color3.fromRGB(255, 170, 80), 0)
	self.healthFill = healthFill
	local healthText = newLabel(status, {
		Position = UDim2.fromOffset(14, 33),
		Size = UDim2.fromOffset(260, 14),
		Text = "100 / 100",
		TextSize = 12,
		Font = FONT_BOLD,
		TextColor3 = Color3.fromRGB(255, 245, 240),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.healthText = healthText

	local heatLabel = newLabel(status, {
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.fromOffset(90, 14),
		Text = "ОРУЖИЕ",
		TextSize = 11,
		TextColor3 = Color3.fromRGB(220, 190, 170),
	})
	local _, heatFill = makeBar(status, 70, 268, AMBER)
	gradient(heatFill, AMBER, ORANGE, 0)
	heatFill.Size = UDim2.fromScale(0, 1)
	self.heatFill = heatFill
	local heatText = newLabel(status, {
		Position = UDim2.fromOffset(160, 88 - 2),
		Size = UDim2.fromOffset(118, 14),
		Text = "ГОТОВ",
		TextSize = 11,
		Font = FONT_BOLD,
		TextColor3 = CYAN,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	self.heatText = heatText

	-- ------------------------------------------------------------- правый верх: счёт
	local score = newPanel(gui, UDim2.fromOffset(210, 78), UDim2.new(1, -228, 0, 18), 0.4)
	local scoreLabel = newLabel(score, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.fromOffset(180, 24),
		Text = "СЧЁТ 0",
		Font = FONT_BOLD,
		TextSize = 18,
		TextColor3 = AMBER,
	})
	local killsLabel = newLabel(score, {
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.fromOffset(180, 20),
		Text = "СБИТО 0",
		TextSize = 13,
		TextColor3 = Color3.fromRGB(220, 200, 190),
	})
	self.scoreLabel = scoreLabel
	self.killsLabel = killsLabel

	-- ------------------------------------------------------------- низ: приборы
	local instr = Instance.new("Frame")
	instr.AnchorPoint = Vector2.new(0.5, 1)
	instr.Position = UDim2.new(0.5, 0, 1, -22)
	instr.Size = UDim2.fromOffset(330, 62)
	instr.BackgroundTransparency = 1
	instr.Parent = gui

	local speedLabel = newLabel(instr, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(200, 30),
		Text = "0",
		Font = FONT_BOLD,
		TextSize = 30,
		TextColor3 = Color3.fromRGB(255, 240, 225),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local speedUnit = newLabel(instr, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(200, 16),
		Text = "СТУД/С",
		TextSize = 11,
		TextColor3 = Color3.fromRGB(200, 160, 130),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local altLabel = newLabel(instr, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.72),
		Size = UDim2.fromOffset(200, 18),
		Text = "ВЫСОТА 0",
		TextSize = 13,
		Font = FONT_BOLD,
		TextColor3 = ORANGE,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.speedLabel = speedLabel
	self.altLabel = altLabel

	-- ------------------------------------------------------------- выбор дрона
	local picker = Instance.new("Frame")
	picker.Position = UDim2.new(0, 18, 1, -132)
	picker.Size = UDim2.fromOffset(180, 108)
	picker.BackgroundTransparency = 1
	picker.Parent = gui
	self.picker = picker

	local titles = { "1  РАЗВЕДЧИК", "2  ШТУРМОВИК" }
	local ids = { "scout", "gunship" }
	self.pickButtons = {}
	for i = 1, 2 do
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(180, 34)
		b.Position = UDim2.fromOffset(0, (i - 1) * 40)
		b.BackgroundColor3 = DARK
		b.BackgroundTransparency = 0.4
		b.BorderSizePixel = 0
		b.Font = FONT_BOLD
		b.TextSize = 13
		b.TextColor3 = Color3.fromRGB(255, 235, 220)
		b.Text = titles[i]
		b.AutoButtonColor = false
		b.Parent = picker
		corner(b, 8)
		local s = stroke(b, ORANGE, 1.2, 0.6)
		b.MouseButton1Click:Connect(function()
			if self.callbacks.onSwitchDrone then
				self.callbacks.onSwitchDrone(ids[i])
			end
		end)
		self.pickButtons[i] = { button = b, stroke = s }
	end

	-- ------------------------------------------------------------- большая надпись
	local banner = newLabel(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.34),
		Size = UDim2.fromOffset(760, 70),
		Text = "",
		Font = FONT_BOLD,
		TextSize = 46,
		TextColor3 = ORANGE,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 1,
	})
	local bannerStroke = Instance.new("UIStroke")
	bannerStroke.Color = Color3.fromRGB(20, 8, 0)
	bannerStroke.Thickness = 3
	bannerStroke.Transparency = 1
	bannerStroke.Parent = banner
	self.banner = banner
	self.bannerStroke = bannerStroke

	-- ------------------------------------------------------------- тосты
	local toasts = Instance.new("Frame")
	toasts.AnchorPoint = Vector2.new(0.5, 0)
	toasts.Position = UDim2.new(0.5, 0, 0, 96)
	toasts.Size = UDim2.fromOffset(460, 200)
	toasts.BackgroundTransparency = 1
	toasts.Parent = gui
	self.toasts = toasts

	-- ------------------------------------------------------------- подсказка управления
	local hint = newLabel(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 214, 1, -24),
		Size = UDim2.fromOffset(420, 78),
		Text = "WASD — крен и тангаж\nSPACE / SHIFT — тяга     Q / E — рыскание\nЛКМ — миниганы     X — бомба     F — вид от первого лица",
		TextSize = 12,
		TextColor3 = Color3.fromRGB(226, 200, 180),
		TextYAlignment = Enum.TextYAlignment.Bottom,
	})
	self.hint = hint
	task.delay(18, function()
		TweenService:Create(hint, TweenInfo.new(1.5), { TextTransparency = 0.65 }):Play()
	end)

	-- ------------------------------------------------------------- мобильное управление
	self:buildTouchControls(gui)

	return self
end

-- --------------------------------------------------------------------------- #
-- мобильные кнопки
-- --------------------------------------------------------------------------- #
function DroneUI:buildTouchControls(gui)
	if not UserInputService.TouchEnabled then
		return
	end
	local container = Instance.new("Frame")
	container.Size = UDim2.fromScale(1, 1)
	container.BackgroundTransparency = 1
	container.Parent = gui
	self.touch = container

	-- джойстик полёта
	local stick = Instance.new("Frame")
	stick.AnchorPoint = Vector2.new(0.5, 0.5)
	stick.Position = UDim2.new(0, 130, 1, -150)
	stick.Size = UDim2.fromOffset(150, 150)
	stick.BackgroundColor3 = DARK
	stick.BackgroundTransparency = 0.55
	stick.BorderSizePixel = 0
	stick.Parent = container
	corner(stick, 75)
	stroke(stick, ORANGE, 2, 0.5)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.Size = UDim2.fromOffset(62, 62)
	knob.BackgroundColor3 = ORANGE
	knob.BackgroundTransparency = 0.15
	knob.BorderSizePixel = 0
	knob.Parent = stick
	corner(knob, 31)

	local dragging = false
	local function updateStick(pos)
		local center = stick.AbsolutePosition + stick.AbsoluteSize / 2
		local delta = pos - center
		local radius = stick.AbsoluteSize.X / 2
		local mag = math.min(delta.Magnitude, radius)
		local dir = mag &gt; 3 and delta.Unit or Vector2.zero
		self.virtual.x = dir.X * (mag / radius)
		self.virtual.y = -dir.Y * (mag / radius)
		knob.Position = UDim2.fromScale(0.5 + dir.X * 0.5 * (mag / radius),
			0.5 + dir.Y * 0.5 * (mag / radius))
	end

	stick.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			updateStick(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement) then
			updateStick(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			self.virtual.x = 0
			self.virtual.y = 0
			knob.Position = UDim2.fromScale(0.5, 0.5)
		end
	end)

	-- кнопки тяги и огня
	local function roundButton(text, position, size, color)
		local b = Instance.new("TextButton")
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = position
		b.Size = size
		b.BackgroundColor3 = DARK
		b.BackgroundTransparency = 0.4
		b.BorderSizePixel = 0
		b.Text = text
		b.Font = FONT_BOLD
		b.TextSize = 20
		b.TextColor3 = color
		b.AutoButtonColor = false
		b.Parent = container
		corner(b, 40)
		stroke(b, color, 2, 0.4)
		return b
	end

	local up = roundButton("▲", UDim2.new(1, -230, 1, -230), UDim2.fromOffset(66, 66), CYAN)
	local down = roundButton("▼", UDim2.new(1, -230, 1, -148), UDim2.fromOffset(66, 66), CYAN)
	local yawL = roundButton("⟲", UDim2.new(1, -306, 1, -230), UDim2.fromOffset(58, 58), AMBER)
	local yawR = roundButton("⟳", UDim2.new(1, -306, 1, -148), UDim2.fromOffset(58, 58), AMBER)
	local fire = roundButton("ОГОНЬ", UDim2.new(1, -110, 1, -186), UDim2.fromOffset(110, 110), RED)

	local function hold(button, onDown, onUp)
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1 then
				onDown()
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1 then
				onUp()
			end
		end)
	end

	hold(up, function() self.virtual.up = 1 end, function() self.virtual.up = 0 end)
	hold(down, function() self.virtual.up = -1 end, function() self.virtual.up = 0 end)
	hold(yawL, function() self.virtual.yaw = -1 end, function() self.virtual.yaw = 0 end)
	hold(yawR, function() self.virtual.yaw = 1 end, function() self.virtual.yaw = 0 end)
	hold(fire, function() self.virtual.fire = true end, function() self.virtual.fire = false end)

	-- смена вида и бомба
	local camBtn = roundButton("ВИД", UDim2.new(1, -320, 0, 220), UDim2.fromOffset(64, 40), AMBER)
	camBtn.TextSize = 13
	camBtn.MouseButton1Click:Connect(function()
		self:callToggleCamera()
	end)
	local bombBtn = roundButton("БОМБА", UDim2.new(1, -320, 0, 274), UDim2.fromOffset(64, 40), ORANGE)
	bombBtn.TextSize = 13
	bombBtn.MouseButton1Click:Connect(function()
		self:callBomb()
	end)
end

-- --------------------------------------------------------------------------- #
-- API
-- --------------------------------------------------------------------------- #
function DroneUI:getVirtualInput()
	return self.virtual
end

function DroneUI:callToggleCamera()
	if self.callbacks.onToggleCamera then
		self.callbacks.onToggleCamera()
	end
end

function DroneUI:callBomb()
	if self.callbacks.onBomb then
		self.callbacks.onBomb()
	end
end

function DroneUI:setCameraMode(mode)
	if mode == "fpv" then
		self.cross.Visible = true
		self.crossDot.BackgroundColor3 = RED
	else
		self.cross.Visible = true
		self.crossDot.BackgroundColor3 = AMBER
	end
end

function DroneUI:setDrone(cfg)
	if not cfg then
		self.droneName.Text = "ДРОН УНИЧТОЖЕН"
		self.droneName.TextColor3 = RED
		return
	end
	self.droneName.Text = cfg.Title
	self.droneName.TextColor3 = cfg.Tint or ORANGE
	for i, data in ipairs(self.pickButtons) do
		local selected = (i == 1 and cfg.Id == "scout") or (i == 2 and cfg.Id == "gunship")
		data.button.BackgroundTransparency = selected and 0.15 or 0.5
		data.button.TextColor3 = selected and (cfg.Tint or ORANGE) or Color3.fromRGB(180, 165, 155)
		data.stroke.Color = selected and (cfg.Tint or ORANGE) or Color3.fromRGB(90, 70, 60)
	end
end

function DroneUI:banner(text, duration)
	local b = self.banner
	b.Text = text
	b.TextTransparency = 0
	b.TextSize = 52
	self.bannerStroke.Transparency = 0.1
	TweenService:Create(b, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ TextSize = 42 }):Play()
	self.bannerToken = (self.bannerToken or 0) + 1
	local token = self.bannerToken
	task.delay(duration or 3, function()
		if self.bannerToken ~= token then
			return
		end
		TweenService:Create(b, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		TweenService:Create(self.bannerStroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()
	end)
end

function DroneUI:toast(text, color)
	local label = newLabel(self.toasts, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(460, 26),
		Text = text,
		Font = FONT_BOLD,
		TextSize = 16,
		TextColor3 = color or Color3.fromRGB(255, 235, 220),
		TextTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	-- сдвигаем существующие вниз
	for _, child in ipairs(self.toasts:GetChildren()) do
		if child ~= label and child:IsA("TextLabel") then
			child.Position = child.Position + UDim2.fromOffset(0, 26)
		end
	end
	task.delay(1.6, function()
		local info = TweenInfo.new(0.7)
		TweenService:Create(label, info, {
			TextTransparency = 1,
			Position = label.Position - UDim2.fromOffset(0, 14),
		}):Play()
		task.wait(0.75)
		label:Destroy()
	end)
end

function DroneUI:damageFlash(heal)
	if self.flashTween then
		self.flashTween:Cancel()
	end
	self.vignette.BackgroundColor3 = heal and GREEN or RED
	self.vignette.BackgroundTransparency = heal and 0.82 or 0.72
	self.flashTween = TweenService:Create(self.vignette, TweenInfo.new(0.55),
		{ BackgroundTransparency = 1 })
	self.flashTween:Play()
end

function DroneUI:update(s)
	local cache = self.cache

	-- здоровье
	local hp = math.max(0, math.floor(s.health))
	if cache.health ~= hp then
		cache.health = hp
		local frac = math.clamp(s.health / math.max(s.maxHealth, 1), 0, 1)
		self.healthFill.Size = UDim2.fromScale(frac, 1)
		self.healthFill.BackgroundColor3 = (frac &lt; 0.3) and RED or ((frac &lt; 0.6) and AMBER or Color3.fromRGB(120, 230, 140))
		self.healthText.Text = hp .. " / " .. math.floor(s.maxHealth)
	end

	-- перегрев
	local heatPct = math.clamp(s.heat, 0, 1)
	if math.abs((cache.heat or 0) - heatPct) &gt; 0.01 or cache.overheated ~= s.overheated then
		cache.heat = heatPct
		self.heatFill.Size = UDim2.fromScale(heatPct, 1)
		local c = ORANGE
		if s.overheated then
			c = RED
			self.heatText.Text = "ПЕРЕГРЕВ"
			self.heatText.TextColor3 = RED
		elseif heatPct &gt; 0.6 then
			c = AMBER
			self.heatText.Text = "ГОРЯЧО"
			self.heatText.TextColor3 = AMBER
		else
			self.heatText.Text = "ГОТОВ"
			self.heatText.TextColor3 = CYAN
		end
		self.heatFill.BackgroundColor3 = c
		cache.overheated = s.overheated
	end

	-- скорость/высота
	local spd = math.floor(s.speed)
	if cache.speed ~= spd then
		cache.speed = spd
		self.speedLabel.Text = tostring(spd)
	end
	local alt = math.floor(s.altitude)
	if cache.alt ~= alt then
		cache.alt = alt
		self.altLabel.Text = "ВЫСОТА " .. alt
		self.altLabel.TextColor3 = alt &lt; 6 and RED or ORANGE
	end

	-- счёт
	local score = math.floor(s.score)
	if cache.score ~= score then
		cache.score = score
		self.scoreLabel.Text = "СЧЁТ " .. score
	end
	local kills = math.floor(s.kills)
	if cache.kills ~= kills then
		cache.kills = kills
		self.killsLabel.Text = "СБИТО " .. kills
	end
	local wave = math.floor(s.wave)
	if cache.wave ~= wave then
		cache.wave = wave
		self.waveLabel.Text = "ВОЛНА " .. wave
	end

	-- прицел дышит при перегреве
	if s.overheated then
		self.crossDot.BackgroundColor3 = RED
		self.crossDot.Size = UDim2.fromOffset(7, 7)
	else
		self.crossDot.BackgroundColor3 = AMBER
		self.crossDot.Size = UDim2.fromOffset(4, 4)
	end
end

return DroneUI
</string>
        </Properties>
      </Item>

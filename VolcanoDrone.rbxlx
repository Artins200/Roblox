		shiftTop = Color3.fromRGB(220, 244, 255), shiftBottom = Color3.fromRGB(120, 160, 200),
		atmColor = Color3.fromRGB(226, 244, 255), atmDecay = Color3.fromRGB(150, 186, 220),
		atmDensity = 0.38, haze = 1.9, glare = 0.3,
		bloom = 1.1, bloomSize = 26, bloomThreshold = 1.2,
		gravity = 196.2,
	},
	space = {
		brightness = 0.9, clock = 0.2,
		ambient = Color3.fromRGB(30, 30, 52), outdoor = Color3.fromRGB(46, 44, 72),
		fogColor = Color3.fromRGB(16, 14, 32), fogStart = 900, fogEnd = 5200,
		shiftTop = Color3.fromRGB(120, 110, 255), shiftBottom = Color3.fromRGB(10, 8, 24),
		atmColor = Color3.fromRGB(120, 130, 255), atmDecay = Color3.fromRGB(40, 40, 90),
		atmDensity = 0.2, haze = 0.4, glare = 0.2,
		bloom = 1.8, bloomSize = 32, bloomThreshold = 0.95,
		gravity = 196.2,
	},
}

local function applyTheme(mapId)
	local t = MapTheme[mapId] or MapTheme.lava
	Lighting.Brightness = t.brightness
	Lighting.ClockTime = t.clock
	Lighting.Ambient = t.ambient
	Lighting.OutdoorAmbient = t.outdoor
	Lighting.FogColor = t.fogColor
	Lighting.FogStart = t.fogStart
	Lighting.FogEnd = t.fogEnd
	Lighting.ColorShift_Top = t.shiftTop
	Lighting.ColorShift_Bottom = t.shiftBottom
	Workspace.Gravity = t.gravity

	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then
		atm.Color = t.atmColor
		atm.Decay = t.atmDecay
		atm.Density = t.atmDensity
		atm.Haze = t.haze
		atm.Glare = t.glare
	end
	local bloom = Lighting:FindFirstChild("Bloom") or Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Intensity = t.bloom
		bloom.Size = t.bloomSize
		bloom.Threshold = t.bloomThreshold
	end
end

local mapsFolder = ServerStorage:WaitForChild("Maps")

local function clearTransient()
	for _, b in ipairs(bots) do
		if b.model and b.model.Parent then
			b.model:Destroy()
		end
	end
	bots = {}
	for userId, list in pairs(builtParts) do
		for _, part in ipairs(list) do
			if part and part.Parent then
				part:Destroy()
			end
		end
	end
	builtParts = {}
	for _, beacon in ipairs(Game.Beacons) do
		if beacon and beacon.Parent then
			beacon:Destroy()
		end
	end
	Game.Beacons = {}
end

local function unloadMap()
	clearTransient()
	local old = Workspace:FindFirstChild("CurrentMap")
	if old then
		old:Destroy()
	end
end

local function loadMap(mapId)
	unloadMap()
	local template = mapsFolder:FindFirstChild(mapId)
	if not template then
		template = mapsFolder:GetChildren()[1]
	end
	if not template then
		log("ОШИБКА: в ServerStorage.Maps нет карт!")
		return nil
	end
	local model = template:Clone()
	model.Name = "CurrentMap"
	model.Parent = Workspace
	Game.MapId = template.Name
	applyTheme(template.Name)
	return model
end

local function mapFolder(name)
	local model = Workspace:FindFirstChild("CurrentMap")
	if not model then
		return nil
	end
	return model:FindFirstChild(name)
end

local SPAWN_PREFIX = {
	SpawnPads = "DroneSpawn",
	SurvivorSpawns = "SurvivorSpawn",
	BotSpawns = "BotSpawn",
}

local function pickSpawn(folderName, fallback)
	local folder = mapFolder(folderName)
	local all, matched = {}, {}
	local prefix = SPAWN_PREFIX[folderName]
	if folder then
		for _, c in ipairs(folder:GetChildren()) do
			if c:IsA("BasePart") then
				table.insert(all, c)
				if prefix and string.sub(c.Name, 1, #prefix) == prefix then
					table.insert(matched, c)
				end
			end
		end
	end
	local list = (#matched &gt; 0) and matched or all
	if #list == 0 then
		return CFrame.new(fallback or Vector3.new(0, 140, 0))
	end
	return list[math.random(1, #list)].CFrame
end

-- --------------------------------------------------------------------------- --
-- Дроны
-- --------------------------------------------------------------------------- --
local function destroyDrone(player, reason)
	local d = drones[player.UserId]
	if not d then
		return
	end
	drones[player.UserId] = nil
	local s = ps(player)
	s.role = nil
	if d.model and d.model.Parent then
		local pos = d.model:GetPivot().Position
		Rem.ExplosionFX:FireAllClients(pos, 22, d.cfg.Tint)
		d.model:Destroy()
	end
	Rem.SetDrone:FireClient(player, nil, nil)
	Rem.DroneLost:FireClient(player, reason or "destroyed")
	broadcast()
end

local function killDrone(player, reason)
	local d = drones[player.UserId]
	if not d or not d.alive then
		return
	end
	d.alive = false
	local s = ps(player)
	s.deaths += 1
	feed(string.format("%s уничтожен (%s)", player.DisplayName, reason or "урон"),
		Color3.fromRGB(255, 120, 110))
	local mode = Game.Mode
	local serial = Game.Serial
	destroyDrone(player, reason)

	-- в командных и свободных режимах дрон возвращается в бой
	if mode == "teams" or mode == "free" or mode == "survivors" then
		task.delay(Config.DroneRespawn, function()
			if Game.Serial ~= serial or Game.Phase ~= "Round" then
				return
			end
			local st = ps(player)
			if player.Parent and st.ready and st.role == nil and st.outRound ~= serial then
				spawnDrone(player, chooseDroneId(st))
			end
		end)
	end
end

local function droneHealth(player)
	local d = drones[player.UserId]
	return d and d.health or 0
end

local function damageDrone(player, amount, attackerName, attacker)
	local d = drones[player.UserId]
	if not d or not d.alive or amount &lt;= 0 then
		return
	end
	d.health = math.max(0, d.health - amount)
	Rem.DamageFX:FireClient(player, amount, attackerName)
	if d.health &lt;= 0 then
		if attacker and attacker ~= player then
			registerKill(attacker, player.DisplayName)
		end
		killDrone(player, attackerName or "сбит")
		return
	end
	if d.model then
		d.model:SetAttribute("Health", d.health)
		Rem.Health:FireClient(player, d.health, d.cfg.Health)
	end
end

local function prepareDroneModel(model)
	local primary = model.PrimaryPart
	if not primary then
		local bestVol = -1
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				local v = d.Size.X * d.Size.Y * d.Size.Z
				if v &gt; bestVol then
					bestVol = v
					primary = d
				end
			end
		end
		model.PrimaryPart = primary
	end
	if not primary then
		return nil
	end
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = true
			d.CanQuery = true
			d.CanTouch = true
			d.Massless = false
			table.insert(parts, d)
		end
	end
	for _, part in ipairs(parts) do
		if part ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = part
			weld.Parent = part
		end
	end
	for _, part in ipairs(parts) do
		part.Anchored = false
	end
	-- камера дрона не должна ни с чем сталкиваться
	local camPart = findNamed(model, "camera")
	if camPart and camPart:IsA("BasePart") then
		camPart.CanCollide = false
		camPart.CanQuery = false
		camPart.CanTouch = false
	end
	return primary, parts
end

function spawnDrone(player, droneId)
	local cfg = Config.getDrone(droneId)
	local template = ServerStorage:FindFirstChild(cfg.Template)
	if not template then
		log("нет шаблона дрона", cfg.Template)
		return nil
	end
	destroyDrone(player, "switch")

	local model = template:Clone()
	model.Name = "Drone_" .. player.Name
	model:SetAttribute("IsDrone", true)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("OwnerName", player.DisplayName)
	model:SetAttribute("DroneId", cfg.Id)
	model:SetAttribute("Health", cfg.Health)
	model:SetAttribute("MaxHealth", cfg.Health)

	local primary = prepareDroneModel(model)
	if not primary then
		model:Destroy()
		return nil
	end
	model.Parent = Workspace
	local spawnCF = pickSpawn("SpawnPads", Vector3.new(0, 150, 0)) + Vector3.new(0, 7, 0)
	model:PivotTo(spawnCF)

	-- сетевые права: физику дрона считает клиент пилота
	local ok, err = pcall(function()
		primary:SetNetworkOwner(player)
	end)
	if not ok then
		log("SetNetworkOwner не сработал:", err)
	end

	local gunNames = { "minigan one", "minigan two" }
	local guns = {}
	for _, n in ipairs(gunNames) do
		local g = findNamed(model, n)
		if g and g:IsA("BasePart") then
			table.insert(guns, g)
		end
	end
	if #guns == 0 then
		guns = { primary }
	end

	drones[player.UserId] = {
		model = model,
		primary = primary,
		cfg = cfg,
		health = cfg.Health,
		alive = true,
		guns = guns,
		spawnedAt = now(),
	}
	local s = ps(player)
	s.role = "drone"
	s.droneId = cfg.Id
	Rem.SetDrone:FireClient(player, model, cfg.Id, cfg.Health)
	Rem.Health:FireClient(player, cfg.Health, cfg.Health)
	broadcast()
	return model
end

-- --------------------------------------------------------------------------- --
-- Выжившие
-- --------------------------------------------------------------------------- --
local guardSpawn = Workspace:FindFirstChild("GuardSpawn")
if not guardSpawn then
	guardSpawn = Instance.new("SpawnLocation")
	guardSpawn.Name = "GuardSpawn"
	guardSpawn.Size = Vector3.new(6, 1, 6)
	guardSpawn.Transparency = 1
	guardSpawn.CanCollide = false
	guardSpawn.Anchored = true
	guardSpawn.CFrame = CFrame.new(0, 300, 0)
	guardSpawn.Neutral = true
	guardSpawn.Parent = Workspace
end

local function releaseSurvivor(player)
	local s = survivors[player.UserId]
	survivors[player.UserId] = nil
	if s and s.character and s.character.Parent then
		s.character:Destroy()
	end
end

local function spawnSurvivor(player, spawnCF)
	destroyDrone(player, "switch")
	local s = ps(player)
	s.role = "survivor"
	s.ammo = INF.Rifle.Magazine
	s.reloading = false

	local old = player.Character
	if old then
		old:Destroy()
	end
	pcall(function()
		player.Character = nil
	end)

	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	if not ok then
		log("LoadCharacter:", err)
	end
	local char = player.Character
	local waited = 0
	while not char and waited &lt; 3 do
		task.wait(0.1)
		waited += 0.1
		char = player.Character
	end
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return nil
	end

	hum.MaxHealth = INF.Health
	hum.Health = INF.Health
	hum.WalkSpeed = INF.WalkSpeed
	hum.JumpPower = INF.JumpPower
	hum.UseJumpPower = true
	hum.BreakJointsOnDeath = true
	char:PivotTo(spawnCF + Vector3.new(0, 4, 0))

	char:SetAttribute("Survivor", true)
	char:SetAttribute("OwnerUserId", player.UserId)

	survivors[player.UserId] = { character = char, humanoid = hum }
	Rem.Health:FireClient(player, hum.Health, hum.MaxHealth)

	hum.Died:Connect(function()
		local st = ps(player)
		st.deaths += 1
		st.outRound = Game.Serial
		feed(string.format("%s выбыл", player.DisplayName), Color3.fromRGB(255, 150, 150))
		survivors[player.UserId] = nil
		st.role = "spectator"
		Rem.DroneLost:FireClient(player, "dead")
		broadcast()
		task.delay(3, function()
			if player.Parent and player.Character then
				player.Character:Destroy()
				pcall(function()
					player.Character = nil
				end)
			end
		end)
	end)

	hum.HealthChanged:Connect(function(h)
		Rem.Health:FireClient(player, h, hum.MaxHealth)
	end)

	broadcast()
	return char
end

-- --------------------------------------------------------------------------- --
-- Урон: единая точка входа
-- --------------------------------------------------------------------------- --
local W = Config.Weapons
local BUILD = Config.Building

Rem.Reload = newRemote("Reload")

local damageDroneById  -- forward

function registerKill(attacker, victimName)
	if not attacker then
		return
	end
	local s = ps(attacker)
	s.kills += 1
	s.score += 100
	if s.team then
		Game.TeamScore = Game.TeamScore or {}
		Game.TeamScore[s.team] = (Game.TeamScore[s.team] or 0) + 1
	end
	feed(string.format("%s ⟶ %s", attacker.DisplayName, victimName),
		Color3.fromRGB(255, 236, 180))
end

local function damageBuiltPart(part, amount, attacker)
	local hp = part:GetAttribute("Health") or BUILD.Health
	hp -= amount
	part:SetAttribute("Health", hp)
	if hp &lt;= 0 then
		local owner = part:GetAttribute("OwnerUserId")
		Rem.ExplosionFX:FireAllClients(part.Position, 6, Color3.fromRGB(180, 140, 90))
		part:Destroy()
		if owner then
			local list = builtParts[owner]
			if list then
				for i = #list, 1, -1 do
					if list[i] == part or not list[i].Parent then
						table.remove(list, i)
					end
				end
			end
		end
	else
		part.Color = Color3.fromRGB(120, 80, 50)
	end
end

local function damageBot(bot, amount, attacker)
	bot.health -= amount
	if bot.health &lt;= 0 then
		local pos = bot.model and bot.model:GetPivot().Position or Vector3.new()
		Rem.ExplosionFX:FireAllClients(pos, 14, Color3.fromRGB(255, 170, 90))
		if bot.model then
			bot.model:Destroy()
		end
		bot.dead = true
		for i = #bots, 1, -1 do
			if bots[i] == bot then
				table.remove(bots, i)
			end
		end
		local s = bot.killedBy and ps(bot.killedBy)
		if s then
			s.kills += 1
			s.score += Config.Bots[bot.kind == "flyer" and "Flyer" or "Walker"].Score
			if s.team and Game.TeamScore then
				Game.TeamScore[s.team] = (Game.TeamScore[s.team] or 0) + 1
			end
			if bot.killedBy then
				feed(bot.killedBy.DisplayName .. " сбил " ..
					(bot.kind == "flyer" and "дрона-бота" or "бота"), Color3.fromRGB(255, 236, 180))
			end
		end
	else
		bot.killedBy = attacker
	end
end

-- наносит урон тому, во что попал луч; возвращает true, если кто-то получил урон
local function applyHit(hit, amount, attacker, origin)
	if not hit then
		return false
	end
	local part = hit
	if not part:IsA("BasePart") then
		part = hit.Parent
	end
	if not part or not part:IsA("BasePart") then
		return false
	end
	if part:GetAttribute("Built") then
		damageBuiltPart(part, amount, attacker)
		return true
	end
	local model = part:FindFirstAncestorOfClass("Model")
	local char = part:FindFirstAncestorOfClass("Model")
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			-- в прятках дрон не «ранит», а «находит»: одного попадания достаточно
			if Game.Mode == "hide" and attacker and drones[attacker.UserId] then
				hum.Health = 0
				feed(attacker.DisplayName .. " нашёл " .. char.Name, Color3.fromRGB(255, 200, 120))
				Rem.Hitmark:FireClient(attacker)
				return true
			end
			hum:TakeDamage(amount)
			if attacker then
				Rem.Hitmark:FireClient(attacker)
				if hum.Health &lt;= 0 then
					registerKill(attacker, char.Name)
				end
			end
			return true
		end
	end
	if model and model:GetAttribute("IsDrone") then
		local ownerId = model:GetAttribute("OwnerUserId")
		local owner = ownerId and playerByUserId(ownerId)
		if owner and owner ~= attacker then
			local victimCfg = Config.getDrone(model:GetAttribute("DroneId"))
			damageDrone(owner, amount / (victimCfg.Armor or 1),
				attacker and attacker.DisplayName or "дрон", attacker)
			if attacker then
				Rem.Hitmark:FireClient(attacker)
			end
			return true
		elseif owner == attacker then
			return false
		end
		return false
	end
	if model and model:GetAttribute("Bot") then
		for _, b in ipairs(bots) do
			if b.model == model then
				damageBot(b, amount, attacker)
				if attacker then
					Rem.Hitmark:FireClient(attacker)
				end
				return true
			end
		end
	end
	return true
end

local function filteredRaycast(origin, dir, dist, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclusions = {}
	for _, inst in ipairs(ignore or {}) do
		if inst then
			table.insert(exclusions, inst)
		end
	end
	local fx = Workspace:FindFirstChild("ClientFX")
	if fx then
		table.insert(exclusions, fx)
	end
	params.FilterDescendantsInstances = exclusions
	return Workspace:Raycast(origin, dir * dist, params)
end

-- --------------------------------------------------------------------------- --
-- ИИ-боты
-- --------------------------------------------------------------------------- --
local function buildBotModel(kind)
	local model = Instance.new("Model")
	model.Name = kind == "flyer" and "FlyerBot" or "WalkerBot"
	model:SetAttribute("Bot", true)

	local hullColor = kind == "flyer" and Color3.fromRGB(90, 96, 120) or Color3.fromRGB(104, 100, 96)
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Size = kind == "flyer" and Vector3.new(9, 3.4, 12) or Vector3.new(6, 7, 6)
	core.Color = hullColor
	core.Material = Enum.Material.Metal
	core.Anchored = true
	core.CanCollide = false
	core.Parent = model

	local eye = Instance.new("Part")
	eye.Name = "Eye"
	eye.Size = Vector3.new(2.2, 2.2, 2.2)
	eye.Shape = Enum.PartType.Ball
	eye.Color = Color3.fromRGB(255, 90, 70)
	eye.Material = Enum.Material.Neon
	eye.Anchored = true
	eye.CanCollide = false
	eye.CFrame = core.CFrame * CFrame.new(0, 0, -core.Size.Z / 2)
	eye.Parent = model
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 80, 60)
	light.Brightness = 3
	light.Range = 26
	light.Parent = eye

	local wings = {}
	if kind == "flyer" then
		for i = 1, 2 do
			local sign = i == 1 and -1 or 1
			local wing = Instance.new("Part")
			wing.Name = "Wing"
			wing.Size = Vector3.new(16, 0.8, 5)
			wing.Color = hullColor
			wing.Material = Enum.Material.DiamondPlate
			wing.Anchored = true
			wing.CanCollide = false
			wing.CFrame = core.CFrame * CFrame.new(sign * 11, 0, 0)
			wing.Parent = model
			local tip = Instance.new("Part")
			tip.Name = "Tip"
			tip.Size = Vector3.new(1.4, 1.4, 1.4)
			tip.Color = Color3.fromRGB(120, 220, 255)
			tip.Material = Enum.Material.Neon
			tip.Anchored = true
			tip.CanCollide = false
			tip.CFrame = wing.CFrame * CFrame.new(sign * 7, 0, 0)
			tip.Parent = model
			table.insert(wings, wing)
			table.insert(wings, tip)
		end
	end

	local allParts = { core, eye }
	for _, w in ipairs(wings) do
		table.insert(allParts, w)
	end
	for _, part in ipairs(allParts) do
		if part ~= core then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = core
			weld.Part1 = part
			weld.Parent = part
		end
	end
	for _, part in ipairs(allParts) do
		part.Anchored = false
	end
	return model, core
end

local function botTarget(bot)
	local best, bestDist = nil, math.huge
	local pos = bot.model and bot.model:GetPivot().Position
	if not pos then
		return nil
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local s = ps(p)
		if bot.team and s.team == bot.team then
			continue
		end
		local target = nil
		local d = drones[p.UserId]
		if d and d.alive and d.model then
			target = d.model:GetPivot().Position
		elseif survivors[p.UserId] and survivors[p.UserId].character then
			target = survivors[p.UserId].character:GetPivot().Position
		end
		if target then
			local dist = (target - pos).Magnitude
			if dist &lt; bestDist then
				best, bestDist = p, dist
			end
		end
	end
	if best then
		local d = drones[best.UserId]
		if d and d.model then
			return best, d.model:GetPivot().Position
		end
		local sv = survivors[best.UserId]
		if sv and sv.character then
			return best, sv.character:GetPivot().Position
		end
	end
	return nil
end

local function spawnBot(kind, spawnCF)
	local cfg = kind == "flyer" and Config.Bots.Flyer or Config.Bots.Walker
	local model, core = buildBotModel(kind)
	model:PivotTo(spawnCF)
	model.Parent = Workspace

	local att = Instance.new("Attachment")
	att.Name = "BotRoot"
	att.Parent = core

	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.RigidityEnabled = true
	align.MaxTorque = 300000
	align.Parent = core

	local pos = Instance.new("AlignPosition")
	pos.Mode = Enum.PositionAlignmentMode.OneAttachment
	pos.Attachment0 = att
	pos.ApplyAtCenterOfMass = true
	pos.MaxForce = 900000
	pos.Responsiveness = 28
	pos.MaxVelocity = cfg.Speed
	pos.RigidityEnabled = false
	pos.Position = spawnCF.Position
	pos.Parent = core

	local bot = {
		kind = kind,
		model = model,
		core = core,
		align = align,
		pos = pos,
		health = cfg.Health,
		nextShot = now() + math.random(10, 30) / 10,
		deathAt = now() + 240,
		cfg = cfg,
	}
	table.insert(bots, bot)
	return bot
end

local function updateBots(dt)
	for i = #bots, 1, -1 do
		local bot = bots[i]
		if bot.dead or not bot.model or not bot.model.Parent then
			table.remove(bots, i)
		else
			local target, targetPos = botTarget(bot)
			local myPos = bot.model:GetPivot().Position
			local hover = bot.kind == "flyer" and 18 or 5
			if target and targetPos then
				local dir = (targetPos - myPos)
				local dist = dir.Magnitude
				local want = targetPos + Vector3.new(0, hover, 0)
				if dist &gt; (bot.kind == "flyer" and 60 or 26) then
					bot.pos.Position = want
					bot.align.CFrame = CFrame.lookAt(myPos, Vector3.new(targetPos.X, myPos.Y, targetPos.Z))
				else
					bot.pos.Position = myPos
					bot.align.CFrame = CFrame.lookAt(myPos, targetPos)
				end
				-- стрельба
				if now() &gt;= bot.nextShot and dist &lt;= bot.cfg.Range then
					bot.nextShot = now() + bot.cfg.FireInterval * (0.8 + math.random() * 0.6)
					local origin = myPos
					local aim = (targetPos - origin).Unit
					local spread = Vector3.new(math.random() - 0.5, math.random() - 0.5,
						math.random() - 0.5) * 0.06
					local dir2 = (aim + spread).Unit
					local hit = filteredRaycast(origin, dir2, bot.cfg.Range, { bot.model })
					local endpoint = hit and hit.Position or (origin + dir2 * bot.cfg.Range)
					Rem.FireFX:FireAllClients(origin, endpoint, Color3.fromRGB(255, 110, 90))
					if hit then
						local victim = nil
						local ownerId = nil
						local m = hit.Instance:FindFirstAncestorOfClass("Model")
						if m then
							ownerId = m:GetAttribute("OwnerUserId")
						end
						if ownerId then
							victim = playerByUserId(ownerId)
						end
						if victim then
							local s = ps(victim)
							if droneHealth(victim) &gt; 0 then
								damageDrone(victim, bot.cfg.Damage, "бот")
							elseif survivors[victim.UserId] then
								local sv = survivors[victim.UserId]
								sv.humanoid:TakeDamage(bot.cfg.Damage)
								Rem.DamageFX:FireClient(victim, bot.cfg.Damage, "бот")
							end
							if s and s.role == "drone" then
								-- попадание по нам: тряска/вспышка уже ушли через DamageFX
							end
						end
					end
				end
			else
				bot.pos.Position = myPos + Vector3.new(0, math.sin(now() * 0.7 + i) * 3, 0)
			end
			-- таймаут: боты не живут вечно
			if now() &gt; bot.deathAt then
				if bot.model then
					bot.model:Destroy()
				end
				bot.dead = true
				table.remove(bots, i)
			end
		end
	end
end

-- --------------------------------------------------------------------------- --
-- Оружие дрона: миниган и бомба
-- --------------------------------------------------------------------------- --
Rem.Fire.OnServerEvent:Connect(function(player, dir)
	local d = drones[player.UserId]
	if not d or not d.alive or not d.model or not d.primary.Parent then
		return
	end
	if typeof(dir) ~= "Vector3" or dir.Magnitude &lt; 0.01 then
		return
	end
	local s = ps(player)
	if now() - s.lastFire &lt; W.Minigun.Interval * 0.9 then
		return
	end
	s.lastFire = now()

	local origin = d.primary.Position
	local aim = dir.Unit
	local spread = W.Minigun.Spread / 57.3
	local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5,
		math.random() - 0.5) * spread
	local rayDir = (aim + jitter).Unit
	local hit = filteredRaycast(origin, rayDir, W.Minigun.Range, { d.model })
	local endpoint = hit and hit.Position or (origin + rayDir * W.Minigun.Range)
	Rem.FireFX:FireAllClients(origin, endpoint, W.Minigun.Tracer)
	if hit then
		applyHit(hit.Instance, W.Minigun.Damage, player, origin)
	end
end)

local function explodeAt(position, damage, radius, attacker)
	Rem.ExplosionFX:FireAllClients(position, radius, Color3.fromRGB(255, 160, 70))
	for _, p in ipairs(Players:GetPlayers()) do
		local d = drones[p.UserId]
		if d and d.alive and d.model then
			local dist = (d.model:GetPivot().Position - position).Magnitude
			if dist &lt;= radius and p ~= attacker then
				damageDrone(p, damage * (1 - dist / radius), "бомба")
			end
		end
		local sv = survivors[p.UserId]
		if sv and sv.character then
			local dist = (sv.character:GetPivot().Position - position).Magnitude
			if dist &lt;= radius then
				sv.humanoid:TakeDamage(Config.Infantry.DroneBombDamageToSurvivor * (1 - dist / radius))
				Rem.DamageFX:FireClient(p, 40, "бомба")
			end
		end
	end
	for i = #bots, 1, -1 do
		local bot = bots[i]
		if bot.model and bot.model.Parent then
			local dist = (bot.model:GetPivot().Position - position).Magnitude
			if dist &lt;= radius then
				damageBot(bot, damage, attacker)
			end
		end
	end
	local model = Workspace:FindFirstChild("CurrentMap")
	if model then
		local geo = model:FindFirstChild("Geometry")
		if geo then
			for _, part in ipairs(geo:GetDescendants()) do
				if part:IsA("BasePart") and part:GetAttribute("Built") then
					local dist = (part.Position - position).Magnitude
					if dist &lt;= radius then
						damageBuiltPart(part, damage, attacker)
					end
				end
			end
		end
	end
	for _, list in pairs(builtParts) do
		for i = #list, 1, -1 do
			local part = list[i]
			if part.Parent and (part.Position - position).Magnitude &lt;= radius then
				damageBuiltPart(part, damage, attacker)
			end
		end
	end
end

Rem.Bomb.OnServerEvent:Connect(function(player)
	local d = drones[player.UserId]
	if not d or not d.alive or not d.cfg.Bomb or not d.model then
		return
	end
	local s = ps(player)
	if s.lastBomb and now() - s.lastBomb &lt; W.Bomb.Cooldown then
		return
	end
	s.lastBomb = now()

	local startPos = d.primary.Position + Vector3.new(0, -6, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { d.model }
	local down = Workspace:Raycast(startPos, Vector3.new(0, -600, 0), params)
	local impact = down and down.Position or (startPos - Vector3.new(0, 400, 0))

	local bomb = Instance.new("Part")
	bomb.Name = "Bomb"
	bomb.Shape = Enum.PartType.Ball
	bomb.Size = Vector3.new(3, 3, 3)
	bomb.Color = d.cfg.Tint
	bomb.Material = Enum.Material.Neon
	bomb.Anchored = true
	bomb.CanCollide = false
	bomb.CFrame = CFrame.new(startPos)
	bomb.Parent = Workspace
	Rem.BombFX:FireAllClients(startPos)

	task.spawn(function()
		local dist = (impact - startPos).Magnitude
		local duration = math.clamp(dist / 220, 0.25, 2.6)
		local t = 0
		while t &lt; duration and bomb.Parent do
			t += task.wait()
			bomb.CFrame = CFrame.new(startPos:Lerp(impact, math.clamp(t / duration, 0, 1)))
		end
		if bomb.Parent then
			bomb:Destroy()
		end
		explodeAt(impact, W.Bomb.Damage, W.Bomb.Radius, player)
	end)
end)

-- --------------------------------------------------------------------------- --
-- Оружие выживших
-- --------------------------------------------------------------------------- --
local function survivorRoot(player)
	local sv = survivors[player.UserId]
	if not sv or not sv.character or not sv.humanoid or sv.humanoid.Health &lt;= 0 then
		return nil
	end
	return sv.humanoid.RootPart, sv.humanoid
end

Rem.GunFire.OnServerEvent:Connect(function(player, dir)
	local root, hum = survivorRoot(player)
	if not root or typeof(dir) ~= "Vector3" then
		return
	end
	local s = ps(player)
	if s.reloading or now() - s.lastFire &lt; INF.Rifle.Interval * 0.9 then
		return
	end
	if (s.ammo or 0) &lt;= 0 then
		return
	end
	s.lastFire = now()
	s.ammo -= 1
	if s.ammo &lt;= 0 then
		s.reloading = true
		task.delay(INF.Rifle.Reload, function()
			s.ammo = INF.Rifle.Magazine
			s.reloading = false
			broadcast()
		end)
	end

	local origin = root.Position + Vector3.new(0, 1.6, 0)
	local spread = INF.Rifle.Spread / 57.3
	local aim = dir.Unit
	local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5,
		math.random() - 0.5) * spread
	local rayDir = (aim + jitter).Unit
	local hit = filteredRaycast(origin, rayDir, INF.Rifle.Range, { player.Character })
	local endpoint = hit and hit.Position or (origin + rayDir * INF.Rifle.Range)
	Rem.FireFX:FireAllClients(origin, endpoint, Color3.fromRGB(255, 240, 190))
	if hit then
		applyHit(hit.Instance, INF.Rifle.Damage * INF.SurvivorDamageToDrone, player, origin)
	end
end)

Rem.Reload.OnServerEvent:Connect(function(player)
	local s = ps(player)
	if s.reloading then
		return
	end
	s.reloading = true
	task.delay(INF.Rifle.Reload, function()
		s.ammo = INF.Rifle.Magazine
		s.reloading = false
		broadcast()
	end)
end)

Rem.Melee.OnServerEvent:Connect(function(player)
	local root, hum = survivorRoot(player)
	if not root then
		return
	end
	local s = ps(player)
	if now() - s.lastMelee &lt; INF.Melee.Cooldown then
		return
	end
	s.lastMelee = now()
	local origin = root.Position + Vector3.new(0, 1.2, 0)
	local dir = root.CFrame.LookVector
	Rem.MeleeFX:FireAllClients(player.UserId, origin, dir)
	local hit = filteredRaycast(origin, dir, INF.Melee.Range, { player.Character })
	if hit then
		applyHit(hit.Instance, INF.Melee.Damage, player, origin)
	end
end)

-- --------------------------------------------------------------------------- --
-- Строительство из досок
-- --------------------------------------------------------------------------- --
Rem.Build.OnServerEvent:Connect(function(player, plankId, targetCF)
	local root, hum = survivorRoot(player)
	if not root or typeof(targetCF) ~= "CFrame" then
		return
	end
	local s = ps(player)
	if now() - s.lastBuild &lt; BUILD.Cooldown then
		return
	end
	if (targetCF.Position - root.Position).Magnitude &gt; BUILD.Range then
		return
	end
	if targetCF.Position.Y &lt; Config.KillY + 10 then
		return
	end
	s.lastBuild = now()

	local plank = Config.getPlank(tostring(plankId))
	local list = builtParts[player.UserId]
	if not list then
		list = {}
		builtParts[player.UserId] = list
	end
	if #list &gt;= BUILD.MaxParts then
		local oldest = table.remove(list, 1)
		if oldest and oldest.Parent then
			oldest:Destroy()
		end
	end

	local part = Instance.new("Part")
	part.Name = "Plank"
	part.Size = plank.Size
	part.CFrame = targetCF
	part.Anchored = true
	part.Color = plank.Color
	part.Material = BUILD.Material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("Built", true)
	part:SetAttribute("Health", BUILD.Health)
	part:SetAttribute("OwnerUserId", player.UserId)
	part.Parent = Workspace
	table.insert(list, part)
	Rem.Placed:FireAllClients(part, plank.Color)
end)

Rem.Crash.OnServerEvent:Connect(function(player, amount)
	if typeof(amount) ~= "number" then
		return
	end
	local d = drones[player.UserId]
	if not d or not d.alive then
		return
	end
	damageDrone(player, math.clamp(amount, 0, 40), "crash")
end)

Rem.RequestDrone.OnServerEvent:Connect(function(player, droneId)
	if typeof(droneId) ~= "string" then
		return
	end
	local s = ps(player)
	if s.role ~= "drone" then
		return
	end
	for _, d in ipairs(Config.Drones) do
		if d.Id == droneId then
			spawnDrone(player, droneId)
			return
		end
	end
end)

-- --------------------------------------------------------------------------- --
-- Маяки для соло-пряток
-- --------------------------------------------------------------------------- --
local function spawnBeacons(count)
	for i = 1, count do
		local cf = pickSpawn("BotSpawns", Vector3.new(0, 30, 0))
		local beacon = Instance.new("Part")
		beacon.Name = "Beacon" .. i
		beacon.Shape = Enum.PartType.Ball
		beacon.Size = Vector3.new(6, 6, 6)
		beacon.Color = Color3.fromRGB(150, 255, 190)
		beacon.Material = Enum.Material.Neon
		beacon.Anchored = true
		beacon.CanCollide = false
		beacon.CanQuery = false
		beacon.CFrame = cf + Vector3.new(0, 6, 0)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(150, 255, 190)
		light.Brightness = 4
		light.Range = 40
		light.Parent = beacon
		beacon.Parent = Workspace
		table.insert(Game.Beacons, beacon)
	end
end

-- --------------------------------------------------------------------------- --
-- Единый Heartbeat: маяки, боты, бездна
-- --------------------------------------------------------------------------- --
local botTimer = 0

local function topUpBots(dt)
	botTimer += dt
	if botTimer &lt; 5 or Game.Phase ~= "Round" then
		return
	end
	botTimer = 0
	local mode = Game.Mode
	if #bots &gt;= Config.Bots.MaxAlive then
		return
	end
	if mode == "teams" then
		local red, blue = teamAlive("red"), teamAlive("blue")
		if red &lt; blue then
			spawnBotAt("flyer", "red")
		elseif blue &lt; red then
			spawnBotAt("flyer", "blue")
		elseif #bots &lt; 2 then
			spawnBotAt("flyer", (math.random(2) == 1) and "red" or "blue")
		end
	elseif mode == "free" then
		if #bots &lt; 4 then
			spawnBotAt("flyer", nil)
		end
	elseif mode == "survivors" then
		local target = math.max(3, aliveSurvivors() + 2)
		if #bots &lt; target then
			spawnBotAt((math.random(2) == 1) and "walker" or "flyer", nil)
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	updateBots(dt)
	topUpBots(dt)

	-- бездна и лава
	for userId, d in pairs(drones) do
		if d.alive and d.primary and d.primary.Parent and d.primary.Position.Y &lt; Config.KillY then
			local p = playerByUserId(userId)
			if p then
				killDrone(p, "бездна")
			end
		end
	end

	-- сбор маяков
	if #Game.Beacons &gt; 0 then
		for i = #Game.Beacons, 1, -1 do
			local beacon = Game.Beacons[i]
			if not beacon.Parent then
				table.remove(Game.Beacons, i)
			else
				for userId, d in pairs(drones) do
					if d.alive and d.primary and (d.primary.Position - beacon.Position).Magnitude &lt; Config.BeaconRadius then
						local p = playerByUserId(userId)
						beacon:Destroy()
						table.remove(Game.Beacons, i)
						Rem.ExplosionFX:FireAllClients(beacon.Position, 10, Color3.fromRGB(150, 255, 190))
						if p then
							feed(string.format("%s нашёл маяк! Осталось: %d", p.DisplayName,
								#Game.Beacons), Color3.fromRGB(150, 255, 190))
						end
						break
					end
				end
			end
		end
	end
end)

-- --------------------------------------------------------------------------- --
-- Подсчёт живых
-- --------------------------------------------------------------------------- --
function aliveDrones()
	local n = 0
	for _, d in pairs(drones) do
		if d.alive then
			n += 1
		end
	end
	return n
end

function aliveSurvivors()
	local n = 0
	for _, sv in pairs(survivors) do
		if sv.character and sv.character.Parent and sv.humanoid and sv.humanoid.Health &gt; 0 then
			n += 1
		end
	end
	return n
end

function teamAlive(team)
	local n = 0
	for _, p in ipairs(Players:GetPlayers()) do
		local s = ps(p)
		if s.ready and s.team == team then
			local d = drones[p.UserId]
			if d and d.alive then
				n += 1
			end
		end
	end
	return n
end

function chooseDroneId(s)
	if s and s.droneId then
		for _, d in ipairs(Config.Drones) do
			if d.Id == s.droneId then
				return d.Id
			end
		end
	end
	return Config.Drones[math.random(1, #Config.Drones)].Id
end

-- --------------------------------------------------------------------------- --
-- Раздача ролей
-- --------------------------------------------------------------------------- --
local function assignRoles(mode, list)
	for _, p in ipairs(list) do
		local s = ps(p)
		s.role = nil
		s.team = nil
		s.outRound = nil
	end
	if #list == 0 then
		return
	end

	if mode.Id == "free" then
		for _, p in ipairs(list) do
			ps(p).role = "drone"
		end
	elseif mode.Id == "hide" then
		local droneCount = math.max(1, math.floor(#list / 6))
		if #list &gt;= 2 then
			droneCount = math.max(1, droneCount)
		end
		local sorted = table.clone(list)
		table.sort(sorted, function(a, b)
			local aw = ps(a).rolePref == "drone" and 0 or 1
			local bw = ps(b).rolePref == "drone" and 0 or 1
			return aw &lt; bw
		end)
		for i, p in ipairs(sorted) do
			ps(p).role = (i &lt;= droneCount) and "drone" or "survivor"
		end
	elseif mode.Id == "teams" then
		for i, p in ipairs(list) do
			local s = ps(p)
			s.role = "drone"
			s.team = (i % 2 == 1) and "red" or "blue"
		end
	elseif mode.Id == "survivors" then
		local droneCount = 0
		for _, p in ipairs(list) do
			if ps(p).rolePref == "drone" then
				droneCount += 1
			end
		end
		if #list &gt;= 2 and droneCount == 0 then
			droneCount = 1
		elseif #list == 1 then
			droneCount = (ps(list[1]).rolePref == "survivor") and 0 or 1
		end
		local assigned = 0
		-- сначала тем, кто просил дрона
		for _, p in ipairs(list) do
			if assigned &lt; droneCount and ps(p).rolePref == "drone" then
				ps(p).role = "drone"
				assigned += 1
			end
		end
		for _, p in ipairs(list) do
			local s = ps(p)
			if not s.role then
				if assigned &lt; droneCount then
					s.role = "drone"
					assigned += 1
				else
					s.role = "survivor"
				end
			end
		end
	end

	-- наблюдатели для невыбравших
	for _, p in ipairs(list) do
		local s = ps(p)
		if not s.role then
			s.role = "spectator"
		end
	end
end

-- --------------------------------------------------------------------------- --
-- Спавн всех и наполнение ботами
-- --------------------------------------------------------------------------- --
local function spawnEveryone(mode)
	for _, p in ipairs(Players:GetPlayers()) do
		local s = ps(p)
		if s.ready then
			if s.role == "drone" then
				spawnDrone(p, chooseDroneId(s))
			elseif s.role == "survivor" then
				spawnSurvivor(p, pickSpawn("SurvivorSpawns", Vector3.new(0, 10, 0)))
			else
				s.role = "spectator"
				destroyDrone(p, "spectator")
				releaseSurvivor(p)
			end
		else
			s.role = "spectator"
		end
	end
end

function spawnBotAt(kind, team)
	local cf = pickSpawn("BotSpawns", Vector3.new(0, 40, 0))
	local bot = spawnBot(kind, cf + Vector3.new(0, 12, 0))
	bot.team = team
	return bot
end

local function fillBots(mode)
	local players = readyPlayers()
	local n = #players
	if mode.Id == "hide" then
		if n &lt;= 1 then
			spawnBeacons(Config.BeaconCount)
			announce("ОДИН ДРОН И " .. Config.BeaconCount .. " МАЯКОВ: НАЙДИ ВСЕ", 5)
		end
	elseif mode.Id == "teams" then
		local red, blue = teamAlive("red"), teamAlive("blue")
		local guard = 0
		while red ~= blue and guard &lt; 6 do
			guard += 1
			if red &lt; blue then
				spawnBotAt("flyer", "red")
				red += 1
			else
				spawnBotAt("flyer", "blue")
				blue += 1
			end
		end
	elseif mode.Id == "free" then
		for i = 1, math.clamp(3 - n, 1, 3) do
			spawnBotAt("flyer", nil)
		end
	elseif mode.Id == "survivors" then
		local dcount = aliveDrones()
		if dcount == 0 then
			for i = 1, 2 do
				spawnBotAt("flyer", nil)
			end
		end
		local walkers = math.max(2, aliveSurvivors())
		for i = 1, walkers do
			spawnBotAt("walker", nil)
		end
	end
end

-- --------------------------------------------------------------------------- --
-- Условия победы
-- --------------------------------------------------------------------------- --
local function checkWin(mode)
	if mode.Id == "hide" then
		local hiders = aliveSurvivors()
		local beaconsLeft = #Game.Beacons
		local droneAlive = aliveDrones()
		if droneAlive == 0 and (hiders &gt; 0 or beaconsLeft &gt; 0) then
			return true, "ПРЯЧУЩИЕСЯ ВЫЖИЛИ"
		end
		if hiders == 0 and beaconsLeft == 0 then
			return true, "ДРОНЫ НАШЛИ ВСЕХ"
		end
	elseif mode.Id == "teams" then
		local red = (Game.TeamScore and Game.TeamScore.red) or 0
		local blue = (Game.TeamScore and Game.TeamScore.blue) or 0
		if red &gt;= R.WinScore then
			return true, "КРАСНЫЕ ПОБЕДИЛИ"
		end
		if blue &gt;= R.WinScore then
			return true, "СИНИЕ ПОБЕДИЛИ"
		end
	elseif mode.Id == "survivors" then
		local hiders = aliveSurvivors()
		local dronesAlive = aliveDrones()
		if hiders == 0 and dronesAlive &gt; 0 then
			return true, "ДРОНЫ ВЫИГРАЛИ"
		end
		if dronesAlive == 0 and hiders &gt; 0 then
			return true, "ВЫЖИВШИЕ ОТБИЛИСЬ"
		end
	end
	return false
end

local function timeUpResult(mode)
	if mode.Id == "hide" then
		if #Game.Beacons &gt; 0 then
			return "ПРЯЧУЩИЕСЯ ВЫЖИЛИ"
		end
		return "ВРЕМЯ ВЫШЛО"
	elseif mode.Id == "teams" then
		local red = (Game.TeamScore and Game.TeamScore.red) or 0
		local blue = (Game.TeamScore and Game.TeamScore.blue) or 0
		if red &gt; blue then
			return "КРАСНЫЕ ПОБЕДИЛИ"
		elseif blue &gt; red then
			return "СИНИЕ ПОБЕДИЛИ"
		end
		return "НИЧЬЯ"
	elseif mode.Id == "survivors" then
		if aliveSurvivors() &gt; 0 then
			return "ВЫЖИВШИЕ ПОБЕДИЛИ"
		end
		return "ДРОНЫ ВЫИГРАЛИ"
	end
	return "ЗАЕЗД ОКОНЧЕН"
end

-- --------------------------------------------------------------------------- --
-- Фазы игры
-- --------------------------------------------------------------------------- --
local startVote  -- forward

local function finishRound(text, serial)
	if Game.Serial ~= serial then
		return
	end
	Game.Winner = text
	Game.ResultText = text
	Game.Phase = "End"
	Game.TimeLeft = R.EndDelay
	broadcast()
	announce(text, 5)
	feed("ИТОГ: " .. text, Color3.fromRGB(255, 236, 180))

	-- всем показать результат, затем -- новая карта и голосование
	task.delay(R.EndDelay, function()
		if Game.Serial == serial then
			startVote()
		end
	end)
end

local function startRound(modeId, mapId)
	local ready = readyPlayers()
	if #ready == 0 then
		Game.Phase = "Vote"
		Game.TimeLeft = R.VoteTime
		Game.Votes = {}
		broadcast()
		return
	end

	local mode = GameData.getMode(modeId)
	Game.Mode = mode.Id
	Game.Serial += 1
	local serial = Game.Serial
	Game.Winner = nil
	Game.ResultText = ""
	Game.TeamScore = { red = 0, blue = 0 }
	Game.Votes = {}

	loadMap(mapId)
	assignRoles(mode, ready)
	spawnEveryone(mode)
	fillBots(mode)

	Game.Phase = "Round"
	Game.TimeLeft = mode.Timer or R.RoundTime
	broadcast()
	announce(GameData.getMap(Game.MapId).Title .. "  •  " .. mode.Title, 5)
	log("раунд", mode.Id, "на карте", Game.MapId, "игроков", #ready)

	local roundStart = now()
	while Game.Serial == serial and Game.Phase == "Round" do
		task.wait(0.4)
		local done, text = checkWin(mode)
		if done then
			finishRound(text, serial)
			return
		end
	end
end

local function votesWinner()
	local counts = {}
	local best, bestCount = nil, -1
	for _, modeId in pairs(Game.Votes) do
		counts[modeId] = (counts[modeId] or 0) + 1
	end
	local list = {}
	for modeId, c in pairs(counts) do
		table.insert(list, modeId)
		if c &gt; bestCount then
			best, bestCount = modeId, c
		end
	end
	if not best then
		return GameData.randomMode().Id
	end
	-- ничья -- случайный из лидеров
	local leaders = {}
	for _, modeId in ipairs(list) do
		if counts[modeId] == bestCount then
			table.insert(leaders, modeId)
		end
	end
	return leaders[math.random(1, #leaders)]
end

function startVote()
	Game.Phase = "Vote"
	Game.Serial += 1
	Game.Votes = {}
	Game.Winner = nil
	Game.ResultText = ""
	Game.TimeLeft = R.VoteTime
	Game.TeamScore = { red = 0, blue = 0 }

	for _, p in ipairs(Players:GetPlayers()) do
		local s = ps(p)
		s.role = "spectator"
		destroyDrone(p, "vote")
		releaseSurvivor(p)
		if p.Character then
			p.Character:Destroy()
			pcall(function()
				p.Character = nil
			end)
		end
	end
	unloadMap()
	broadcast()
	log("голосование")
end

-- --------------------------------------------------------------------------- --
-- Ремоуты игрока
-- --------------------------------------------------------------------------- --
local function joinMidRound(player)
	local s = ps(player)
	if s.outRound == Game.Serial then
		Rem.Banner:FireClient(player, "ВЫ ВЫБЫЛИ В ЭТОМ РАУНДЕ", 3)
		return
	end
	local mode = GameData.getMode(Game.Mode)
	if mode.Id == "free" then
		s.role = "drone"
	elseif mode.Id == "hide" then
		s.role = (s.rolePref == "drone" and aliveDrones() == 0) and "drone" or "survivor"
	elseif mode.Id == "teams" then
		s.role = "drone"
		s.team = (teamAlive("red") &lt;= teamAlive("blue")) and "red" or "blue"
	elseif mode.Id == "survivors" then
		s.role = (s.rolePref == "survivor") and "survivor" or "drone"
	end
	if s.role == "drone" then
		spawnDrone(player, chooseDroneId(s))
	elseif s.role == "survivor" then
		spawnSurvivor(player, pickSpawn("SurvivorSpawns", Vector3.new(0, 10, 0)))
	end
	broadcast()
end

local function validateRolePref(rolePref)
	if typeof(rolePref) ~= "string" then
		return "auto"
	end
	for _, r in ipairs(Config.Roles) do
		if r.Id == rolePref then
			if rolePref == "random" then
				return (math.random(2) == 1) and "drone" or "survivor"
			end
			return rolePref
		end
	end
	return "auto"
end

Rem.Join.OnServerEvent:Connect(function(player, rolePref)
	local s = ps(player)
	s.rolePref = validateRolePref(rolePref)
	s.ready = true
	feed(string.format("%s в игре", player.DisplayName), Color3.fromRGB(150, 255, 190))
	if Game.Phase == "Round" and (not s.role or s.role == "spectator") then
		joinMidRound(player)
	end
	broadcast()
end)

Rem.SetRole.OnServerEvent:Connect(function(player, rolePref)
	local s = ps(player)
	s.rolePref = validateRolePref(rolePref)
	if Game.Phase == "Round" then
		destroyDrone(player, "switch")
		releaseSurvivor(player)
		s.role = nil
		joinMidRound(player)
	end
	broadcast()
end)

Rem.Vote.OnServerEvent:Connect(function(player, modeId)
	if Game.Phase ~= "Vote" then
		return
	end
	if typeof(modeId) ~= "string" then
		return
	end
	local valid = false
	for _, m in ipairs(GameData.Modes) do
		if m.Id == modeId then
			valid = true
		end
	end
	if not valid then
		return
	end
	Game.Votes[player.UserId] = modeId
	broadcast()
end)

-- --------------------------------------------------------------------------- --
-- Жизненный цикл игроков
-- --------------------------------------------------------------------------- --
local function onPlayerAdded(player)
	local s = ps(player)
	s.ready = false
	player.CharacterAdded:Connect(function(char)
		-- страховка: если режим не про выживших, персонаж не нужен
		local st = ps(player)
		if st.role ~= "survivor" then
			task.defer(function()
				if char.Parent and ps(player).role ~= "survivor" then
					char:Destroy()
					pcall(function()
						player.Character = nil
					end)
				end
			end)
		end
	end)
	task.delay(0.6, function()
		if player.Parent then
			broadcast()
		end
	end)
	log("игрок", player.Name, "зашёл")
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	onPlayerAdded(p)
end

Players.PlayerRemoving:Connect(function(player)
	destroyDrone(player, "выход")
	releaseSurvivor(player)
	Game.Votes[player.UserId] = nil
	PState[player.UserId] = nil
	broadcast()
end)

-- --------------------------------------------------------------------------- --
-- Часы игры
-- --------------------------------------------------------------------------- --
task.spawn(function()
	while true do
		task.wait(1)
		if Game.Phase == "Vote" or Game.Phase == "Round" or Game.Phase == "End" then
			Game.TimeLeft = math.max(0, Game.TimeLeft - 1)
			broadcast()
			if Game.Phase == "Vote" and Game.TimeLeft &lt;= 0 then
				local map = GameData.randomMap()
				local modeId = votesWinner()
				-- раунд живёт в своём потоке, иначе он остановит эти часы
				task.spawn(function()
					startRound(modeId, map.Id)
				end)
			end
		end
	end
end)

log("сервер готов, режимы:", #GameData.Modes, "карты:", #GameData.Maps)
task.delay(4, function()
	startVote()
end)
</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX3589">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX3590">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX3591">
        <Properties>
          <string name="Name">DroneClient</string>
          <string name="Source">--!nonstrict
--[[
	DroneClient -- клиент игры «ДРОНЫ».

	Отвечает за:
	  * меню и голосование (MenuUI);
	  * настоящую физику полёта дрона (AlignOrientation + VectorForce + аэродинамика);
	  * камеру: погоня, от первого лица, вид наблюдателя;
	  * оружие выжившего от первого лица, нож, строительство досками;
	  * HUD, эффекты, тряску, хитмаркеры и ленту убийств.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("DroneConfig"))
local GameData = require(ReplicatedStorage:WaitForChild("GameData"))
local P = Config.Physics
local W = Config.Weapons

local DroneUI = require(script.Parent:WaitForChild("DroneUI"))
local MenuUI = require(script.Parent:WaitForChild("MenuUI"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local FpsWeapon = require(script.Parent:WaitForChild("FpsWeapon"))
local BuilderModule = require(script.Parent:WaitForChild("Builder"))

local remotes = ReplicatedStorage:WaitForChild("DroneRemotes")
local Rem = {}
for _, name in ipairs({ "Sync", "Join", "Vote", "SetRole", "SetDrone", "DroneLost", "Fire",
	"FireFX", "Bomb", "BombFX", "ExplosionFX", "Banner", "Crash", "DamageFX",
	"RequestDrone", "GunFire", "GunFX", "Melee", "MeleeFX", "Build", "Placed", "Health",
	"Hitmark", "Feed", "Reload", "PickupBeacon" }) do
	Rem[name] = remotes:WaitForChild(name)
end

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

-- Roblox может подменить камеру (например, при респавне персонажа)
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if Workspace.CurrentCamera then
		camera = Workspace.CurrentCamera
	end
end)

-- --------------------------------------------------------------------------- --
-- Состояние клиента
-- --------------------------------------------------------------------------- --
local State = {
	phase = "Menu",
	mode = "free",
	role = nil,
	alive = false,
	drone = nil,
	health = 100,
	maxHealth = 100,
	heat = 0,
	overheated = false,
	ammo = Config.Infantry.Rifle.Magazine,
	magazine = Config.Infantry.Rifle.Magazine,
	reloading = false,
	buildMode = false,
	buildCount = 0,
	plankTitle = "СТЕНА",
	camMode = "chase",
	camYaw = 0,
	camPitch = -14,
	camDist = 40,
	lastFire = 0,
	lastCrash = 0,
	buildCountLocal = 0,
	lastPlace = 0,
	velocityPrev = Vector3.zero,
	collective = P.CollectiveIdle,
	tiltX = 0,
	tiltZ = 0,
	yaw = 0,
	snap = nil,
	mine = nil,
}

local input = {
	forward = 0, right = 0, up = 0, yaw = 0, fire = false, melee = false,
}

local keys = {}

-- --------------------------------------------------------------------------- --
-- Модули UI
-- --------------------------------------------------------------------------- --
local toggleBuild

local ui
ui = DroneUI.new({
	onSwitchDrone = function(id)
		if State.role == "drone" then
			Rem.RequestDrone:FireServer(id)
		end
	end,
	onBomb = function()
		if State.role == "drone" and State.drone and State.drone.cfg.Bomb then
			Rem.Bomb:FireServer()
		end
	end,
	onToggleCamera = function()
		State.camMode = (State.camMode == "chase") and "fpv" or "chase"
		ui:banner(State.camMode == "fpv" and "ВИД ОТ ПЕРВОГО ЛИЦА" or "ВИД ПОГОНИ", 1.4)
	end,
	onBuildToggle = function()
		toggleBuild()
	end,
})

local menu
menu = MenuUI.new({
	onJoin = function(rolePref)
		Rem.Join:FireServer(rolePref)
	end,
	onVote = function(modeId)
		Rem.Vote:FireServer(modeId)
	end,
})

local weapon = FpsWeapon.new(Config.Infantry.Rifle, {
	GunFire = Rem.GunFire,
	Melee = Rem.Melee,
	Reload = Rem.Reload,
}, {
	getCharacter = function()
		return player.Character
	end,
	onAmmo = function(ammo, magazine, reloading)
		State.ammo = ammo
		State.magazine = magazine
		State.reloading = reloading
	end,
})

local builder = BuilderModule.new(Config.Building, {
	getCharacter = function()
		return player.Character
	end,
	place = function(plankId, cf)
		Rem.Build:FireServer(plankId, cf)
	end,
})

function toggleBuild()
	if State.role ~= "survivor" then
		return
	end
	State.buildMode = not State.buildMode
	builder:setEnabled(State.buildMode)
	ui:banner(State.buildMode and "РЕЖИМ СТРОЙКИ" or "СТРОЙКА ВЫКЛЮЧЕНА", 1.6)
end

-- --------------------------------------------------------------------------- --
-- Мелкие помощники
-- --------------------------------------------------------------------------- --
local function lerp(a, b, t)
	return a + (b - a) * math.clamp(t, 0, 1)
end

local function lerpAngle(a, b, t)
	local diff = (b - a + 540) % 360 - 180
	return a + diff * math.clamp(t, 0, 1)
end

local function normName(name)
	return (string.gsub(string.lower(name), "[%s_%-]", ""))
end

local function findNamed(root, wanted)
	local w = normName(wanted)
	for _, d in ipairs(root:GetDescendants()) do
		if normName(d.Name) == w then
			return d
		end
	end
	return nil
end

local function lockMouse()
	if not UserInputService.TouchEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
end

-- --------------------------------------------------------------------------- --
-- Ремоуты сервера
-- --------------------------------------------------------------------------- --
Rem.FireFX.OnClientEvent:Connect(function(origin, target, color)
	Effects.tracer(origin, target, color)
end)

Rem.ExplosionFX.OnClientEvent:Connect(function(position, radius, color)
	Effects.explosion(position, radius, color)
end)

Rem.BombFX.OnClientEvent:Connect(function(position)
	Effects.muzzle(position, Color3.fromRGB(255, 120, 40))
end)

Rem.Banner.OnClientEvent:Connect(function(text, duration)
	ui:banner(text, duration)
end)

Rem.Feed.OnClientEvent:Connect(function(text, color)
	ui:feed(text, color)
end)

Rem.Hitmark.OnClientEvent:Connect(function()
	ui:hitmarker()
end)

Rem.DamageFX.OnClientEvent:Connect(function(amount, reason)
	if amount and amount &gt; 0 then
		ui:damageFlash(false)
		Effects.addShake(0.014 + math.min(amount / 160, 0.045))
		if reason == "crash" then
			ui:toast("ЖЁСТКОЕ СТОЛКНОВЕНИЕ", Color3.fromRGB(255, 190, 90))
		end
	else
		ui:damageFlash(true)
	end
end)

Rem.Health.OnClientEvent:Connect(function(health, maxHealth)
	State.health = health or 0
	State.maxHealth = maxHealth or 100
end)

Rem.Placed.OnClientEvent:Connect(function(part, color)
	if part and part:IsA("BasePart") then
		Effects.impact(part.Position, Vector3.yAxis, color)
		if part:GetAttribute("OwnerUserId") == player.UserId then
			State.buildCountLocal += 1
			State.buildCount = State.buildCountLocal
		end
	end
end)

Rem.MeleeFX.OnClientEvent:Connect(function(userId, origin, dir)
	if userId == player.UserId then
		return
	end
	Effects.tracer(origin + dir * 3, origin + dir * 8, Color3.fromRGB(255, 220, 220), 0.1)
end)

-- --------------------------------------------------------------------------- --
-- Эффекты дрона: выхлоп, след, подсветка
-- --------------------------------------------------------------------------- --
local function addDroneFX(model, primary, cfg)
	local trailA0 = Instance.new("Attachment")
	trailA0.Name = "TrailA"
	trailA0.Position = Vector3.new(-2.4, 0, 3.4)
	trailA0.Parent = primary
	local trailA1 = Instance.new("Attachment")
	trailA1.Name = "TrailB"
	trailA1.Position = Vector3.new(2.4, 0, 3.4)
	trailA1.Parent = primary

	local trail = Instance.new("Trail")
	trail.Attachment0 = trailA0
	trail.Attachment1 = trailA1
	trail.Lifetime = 0.5
	trail.MinLength = 0.1
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Color = ColorSequence.new(cfg.Tint, Color3.fromRGB(20, 20, 24))
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.LightEmission = 0.8
	trail.Parent = primary

	-- «сопла»: неоновые конусы, которые растягиваются от тяги
	local nozzles = {}
	for i = 1, 2 do
		local sign = (i == 1) and -1 or 1
		local cone = Instance.new("Part")
		cone.Name = "Nozzle"
		cone.Shape = Enum.PartType.Cylinder
		cone.Size = Vector3.new(1.4, 1.1, 1.1)
		cone.Color = cfg.Tint
		cone.Material = Enum.Material.Neon
		cone.Transparency = 0.25
		cone.Anchored = false
		cone.CanCollide = false
		cone.CanQuery = false
		cone.CastShadow = false
		cone.Massless = true
		cone.CFrame = primary.CFrame * CFrame.new(sign * 2.2, -1.0, 2.6)
			* CFrame.Angles(0, 0, math.rad(90))
		cone.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = primary
		weld.Part1 = cone
		weld.Parent = cone
		table.insert(nozzles, cone)
	end

	local light = Instance.new("PointLight")
	light.Color = cfg.Tint
	light.Brightness = 3
	light.Range = 30
	light.Parent = primary

	-- навигационные огни
	for i = 1, 2 do
		local sign = (i == 1) and -1 or 1
		local nav = Instance.new("Part")
		nav.Name = "Nav"
		nav.Shape = Enum.PartType.Ball
		nav.Size = Vector3.new(0.7, 0.7, 0.7)
		nav.Color = (sign &lt; 0) and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(70, 255, 140)
		nav.Material = Enum.Material.Neon
		nav.CanCollide = false
		nav.CanQuery = false
		nav.CastShadow = false
		nav.Massless = true
		nav.CFrame = primary.CFrame * CFrame.new(sign * 3.4, 0.4, -2.0)
		nav.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = primary
		weld.Part1 = nav
		weld.Parent = nav
	end

	return { nozzles = nozzles, trail = trail, light = light }
end

-- --------------------------------------------------------------------------- --
-- Контроллер дрона
-- --------------------------------------------------------------------------- --
local function teardownDrone()
	local d = State.drone
	State.drone = nil
	State.alive = false
	State.heat = 0
	State.overheated = false
	if d then
		if d.fx then
			if d.fx.trail then
				d.fx.trail:Destroy()
			end
		end
		if d.primary and d.primary.Parent then
			for _, name in ipairs({ "DroneAlign", "DroneThrust", "DroneDrag", "DroneBody",
				"DroneThrustDir", "Downwash" }) do
				local inst = d.primary:FindFirstChild(name)
				if inst then
					inst:Destroy()
				end
			end
		end
	end
	ui:setDrone(nil)
	ui:setVisible(false)
end

local function buildDrone(model, droneId)
	teardownDrone()
	local cfg = Config.getDrone(droneId)
	local primary = model.PrimaryPart
	if not primary then
		local bestVol = -1
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				local v = d.Size.X * d.Size.Y * d.Size.Z
				if v &gt; bestVol then
					bestVol = v
					primary = d
				end
			end
		end
		model.PrimaryPart = primary
	end
	if not primary then
		return
	end

	local bodyAtt = Instance.new("Attachment")
	bodyAtt.Name = "DroneBody"
	bodyAtt.Parent = primary

	local align = Instance.new("AlignOrientation")
	align.Name = "DroneAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = bodyAtt
	align.RigidityEnabled = false
	align.ReactionTorqueEnabled = true
	align.MaxTorque = math.clamp(primary.AssemblyMass * 3200, 150000, 4500000)
	align.Responsiveness = P.TiltResponsiveness * cfg.Agility
	align.CFrame = primary.CFrame
	align.Parent = primary

	local thrustAtt = Instance.new("Attachment")
	thrustAtt.Name = "DroneThrustDir"
	thrustAtt.Parent = primary

	local thrust = Instance.new("VectorForce")
	thrust.Name = "DroneThrust"
	thrust.Attachment0 = thrustAtt
	thrust.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	thrust.ApplyAtCenterOfMass = true
	thrust.Force = Vector3.zero
	thrust.Parent = primary

	local drag = Instance.new("VectorForce")
	drag.Name = "DroneDrag"
	drag.ApplyAtCenterOfMass = true
	drag.Force = Vector3.zero
	drag.Parent = primary

	local guns = {}
	for _, n in ipairs({ "minigan one", "minigan two" }) do
		local g = findNamed(model, n)
		if g and g:IsA("BasePart") then
			table.insert(guns, g)
		end
	end
	if #guns == 0 then
		guns = { primary }
	end

	local camPart = findNamed(model, "camera")

	local dust = Instance.new("ParticleEmitter")
	dust.Name = "Downwash"
	dust.Rate = 0
	dust.Lifetime = NumberRange.new(0.5, 1.1)
	dust.Speed = NumberRange.new(18, 34)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.Size = NumberSequence.new(2.4, 0.2)
	dust.Color = ColorSequence.new(Color3.fromRGB(150, 120, 100), Color3.fromRGB(60, 44, 36))
	dust.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 1),
	})
	dust.Acceleration = Vector3.new(0, -14, 0)
	dust.EmissionDirection = Enum.NormalId.Bottom
	dust.Parent = primary

	local fx = addDroneFX(model, primary, cfg)

	State.drone = {
		model = model,
		primary = primary,
		cfg = cfg,
		guns = guns,
		cameraPart = camPart,
		dust = dust,
		align = align,
		thrust = thrust,
		drag = drag,
		fx = fx,
	}
	State.alive = true
	State.collective = P.CollectiveIdle
	State.tiltX = 0
	State.tiltZ = 0
	State.yaw = select(2, primary.CFrame:ToEulerAnglesYXZ())
	State.velocityPrev = primary.AssemblyLinearVelocity
	State.camYaw = State.yaw
	State.health = cfg.Health
	State.maxHealth = cfg.Health
	State.buildMode = false
	builder:setEnabled(false)

	camera.CameraType = Enum.CameraType.Scriptable
	player.CameraMode = Enum.CameraMode.Classic
	lockMouse()
	ui:setRole("drone")
	ui:setDrone(cfg)
	ui:setVisible(true)
	ui:banner(cfg.Title .. "  •  " .. GameData.getMode(State.mode).Short, 2.6)
end

Rem.SetDrone.OnClientEvent:Connect(function(model, droneId, health)
	if model and model:IsA("Model") then
		buildDrone(model, droneId or Config.DefaultDrone)
		if health then
			State.health = health
			State.maxHealth = Config.getDrone(droneId).Health
		end
	else
		teardownDrone()
	end
end)

Rem.DroneLost.OnClientEvent:Connect(function(reason)
	teardownDrone()
	local text = "ДРОН УНИЧТОЖЕН"
	if reason == "бездна" or reason == "лава" then
		text = "ПАДЕНИЕ В БЕЗДНУ"
	elseif reason == "crash" then
		text = "ЖЁСТКАЯ ПОСАДКА"
	elseif reason == "vote" then
		text = "ГОЛОСОВАНИЕ"
	elseif reason == "dead" then
		text = "ВЫ ВЫБЫЛИ"
	elseif reason == "бомба" then
		text = "НАКРЫЛО БОМБОЙ"
	end
	ui:banner(text, 3)
end)

-- --------------------------------------------------------------------------- --
-- Синхронизация состояния
-- --------------------------------------------------------------------------- --
local function applyRoleUI()
	local role = State.role
	local playing = (State.phase == "Round") and (role == "drone" or role == "survivor")
	ui:setVisible(playing)
	if role == "survivor" then
		ui:setRole("survivor")
	end
	if playing then
		ui:setMode(GameData.getMode(State.mode).Title .. "  •  " ..
			GameData.getMap(State.snap and State.snap.mapId or "lava").Title)
	else
		ui:setMode(nil)
	end
end

Rem.Sync.OnClientEvent:Connect(function(snap, mine)
	State.snap = snap
	State.mine = mine
	local prevPhase = State.phase
	local prevRole = State.role
	State.phase = snap.phase
	State.mode = snap.mode
	State.role = mine and mine.role or nil

	menu:update(snap, mine)
	applyRoleUI()

	-- смена роли
	if prevPhase ~= snap.phase then
		State.buildCountLocal = 0
		State.buildCount = 0
	end
	if State.role ~= prevRole or prevPhase ~= snap.phase then
		if State.role == "survivor" then
			teardownDrone()
			if player.Character then
				player.CameraMode = Enum.CameraMode.LockFirstPerson
				camera.CameraType = Enum.CameraType.Custom
				weapon:attach()
				lockMouse()
				ui:setVisible(true)
				ui:banner("ВЫЖИВШИЙ  •  ВИНТОВКА  •  [B] СТРОЙКА", 3)
			end
		elseif State.role == "drone" then
			weapon:detach()
			player.CameraMode = Enum.CameraMode.Classic
		else
			weapon:detach()
			builder:setEnabled(false)
			State.buildMode = false
		end
	end
end)

-- --------------------------------------------------------------------------- --
-- Физика полёта
-- --------------------------------------------------------------------------- --
local windPhase = 0
local function windVector(dt)
	windPhase += dt * 0.35
	local t = os.clock() * 0.5
	return Vector3.new(
		math.noise(windPhase, t) * P.WindStrength,
		math.noise(windPhase + 10, t * 0.7) * P.WindStrength * 0.35,
		math.noise(windPhase + 20, t * 0.9) * P.WindStrength)
end

local downRay = RaycastParams.new()
downRay.FilterType = Enum.RaycastFilterType.Exclude
downRay.FilterDescendantsInstances = { Effects.folder() }

local groundTimer = 0
local groundFt = 0

local function readInput(dt)
	local f = 0
	local r = 0
	local u = 0
	local y = 0
	if keys[Enum.KeyCode.W] then f += 1 end
	if keys[Enum.KeyCode.S] then f -= 1 end
	if keys[Enum.KeyCode.A] then r -= 1 end
	if keys[Enum.KeyCode.D] then r += 1 end
	if keys[Enum.KeyCode.Space] then u += 1 end
	if keys[Enum.KeyCode.LeftShift] or keys[Enum.KeyCode.LeftControl] then u -= 1 end
	if keys[Enum.KeyCode.Q] then y -= 1 end
	if keys[Enum.KeyCode.E] then y += 1 end

	if not UserInputService.TouchEnabled then
		lockMouse()
		local delta = UserInputService:GetMouseDelta()
		State.camYaw -= delta.X * 0.22
		State.camPitch = math.clamp(State.camPitch - delta.Y * 0.18, -74, 36)
	end

	local virtual = ui:getVirtualInput()
	input.forward = math.clamp(f + (virtual.y or 0), -1, 1)
	input.right = math.clamp(r + (virtual.x or 0), -1, 1)
	input.up = math.clamp(u + (virtual.up or 0), -1, 1)
	input.yaw = math.clamp(y + (virtual.yaw or 0), -1, 1)
	input.fire = (keys.fire == true) or (virtual.fire == true)
end

local function stepFlight(dt)
	local d = State.drone
	if not d or not d.primary or not d.primary.Parent then
		return
	end
	local primary = d.primary
	local cfg = d.cfg

	readInput(dt)

	local velocity = primary.AssemblyLinearVelocity
	local speed = velocity.Magnitude
	local mass = math.max(primary.AssemblyMass, 1)
	local hover = mass * Workspace.Gravity

	-- курс
	local hasStick = math.abs(input.forward) + math.abs(input.right) &gt; 0.08
	if input.yaw ~= 0 then
		State.yaw += input.yaw * P.YawRate * cfg.Agility * dt
		State.camYaw = lerpAngle(State.camYaw, State.yaw, dt * 3.4)
	elseif hasStick then
		State.yaw = lerpAngle(State.yaw, State.camYaw, dt * P.YawFollowLerp * cfg.Agility)
	end

	-- крен и тангаж
	local maxTilt = P.MaxTilt
	local targetPitch = -input.forward * maxTilt
	local targetRoll = input.right * maxTilt * 1.05 + math.clamp(input.yaw * 9, -9, 9)
	State.tiltX = lerp(State.tiltX, targetPitch, dt * P.TiltResponsiveness * cfg.Agility)
	State.tiltZ = lerp(State.tiltZ, targetRoll, dt * P.TiltResponsiveness * cfg.Agility)

	local desired = CFrame.fromEulerAnglesYXZ(
		math.rad(State.tiltX), math.rad(State.yaw), math.rad(State.tiltZ))
	if d.align then
		d.align.CFrame = CFrame.new(primary.Position) * desired
	end

	-- общая тяга
	local targetCollective = P.CollectiveIdle
	if input.up &gt; 0.05 then
		targetCollective = P.CollectiveUp
	elseif input.up &lt; -0.05 then
		targetCollective = P.CollectiveDown
	end
	-- разряженный воздух на большой высоте: тяга слабее
	local altitudePenalty = 1
	if primary.Position.Y &gt; P.MaxHealthDroneAlt then
		altitudePenalty = math.clamp(1 - (primary.Position.Y - P.MaxHealthDroneAlt) / 900, 0.55, 1)
	end
	State.collective = lerp(State.collective, targetCollective, dt * P.CollectiveLerp)

	-- эффект экрана земли
	groundTimer += dt
	if groundTimer &gt; 0.08 then
		groundTimer = 0
		local res = Workspace:Raycast(primary.Position, Vector3.new(0, -P.GroundEffectHeight, 0), downRay)
		groundFt = res and 1 or 0
	end
	local collective = State.collective * (groundFt &gt; 0 and (1 + P.GroundEffectBoost) or 1)

	if d.thrust then
		d.thrust.Force = Vector3.new(0, hover * collective * cfg.Thrust * altitudePenalty, 0)
	end

	-- аэродинамика
	local air = velocity - windVector(dt)
	local airSpeed = air.Magnitude
	if d.drag then
		if airSpeed &gt; 0.05 then
			local coef = mass * (P.LinearDrag * airSpeed + P.QuadDrag * airSpeed * airSpeed)
			d.drag.Force = -(air.Unit * coef)
		else
			d.drag.Force = Vector3.zero
		end
	end

	-- сопла
	if d.fx and d.fx.nozzles then
		local stretch = math.clamp(State.collective / P.CollectiveUp, 0.3, 1.6)
		for _, cone in ipairs(d.fx.nozzles) do
			if cone.Parent then
				cone.Size = Vector3.new(1.2 + stretch * 2.4, 1.0 + stretch * 0.6, 1.0 + stretch * 0.6)
				cone.Transparency = 0.45 - stretch * 0.25
			end
		end
	end

	if d.dust then
		d.dust.Rate = (State.collective &gt; 1.02 and speed &lt; 70) and 26 or 0
	end

	-- столкновения
	local deltaV = (velocity - State.velocityPrev).Magnitude
	local prevSpeed = State.velocityPrev.Magnitude
	if deltaV &gt; 34 and prevSpeed &gt; 42 and os.clock() - State.lastCrash &gt; 0.75 then
		State.lastCrash = os.clock()
		local dmg = math.clamp((deltaV - 34) * P.CrashDamageScale, 0, 34)
		if dmg &gt; 1 then
			Rem.Crash:FireServer(dmg)
			Effects.addShake(math.min(dmg / 90, 0.06))
		end
	end
	State.velocityPrev = velocity

	-- стрельба
	if input.fire and not State.overheated then
		local clock = os.clock()
		if clock - State.lastFire &gt;= W.Minigun.Interval then
			State.lastFire = clock
			Rem.Fire:FireServer(camera.CFrame.LookVector)
			State.heat = math.min(1, State.heat + W.Minigun.HeatPerShot)
			Effects.addShake(0.004)
			local gun = d.guns[math.random(1, #d.guns)]
			if gun then
				Effects.muzzle(gun.Position, W.Minigun.Tracer)
			end
		end
	end
	State.heat = math.max(0, State.heat - W.Minigun.CoolRate * dt)
	if State.heat &gt;= 1 then
		State.overheated = true
	end
	if State.overheated and State.heat &lt; 0.35 then
		State.overheated = false
	end

	ui:update({
		health = State.health,
		maxHealth = State.maxHealth,
		heat = State.heat,
		overheated = State.overheated,
		speed = speed,
		altitude = primary.Position.Y,
		bombLabel = cfg.Bomb and "[X] БОМБА" or "БЕЗ БОМБЫ",
	})
end

-- --------------------------------------------------------------------------- --
-- Камера
-- --------------------------------------------------------------------------- --
local camPos = Vector3.new(0, 160, 260)
local camLook = Vector3.new(0, 40, 0)

local function updateCamera(dt)
	local d = State.drone
	if d and d.primary and d.primary.Parent then
		camera.CameraType = Enum.CameraType.Scriptable
		local primary = d.primary
		local velocity = primary.AssemblyLinearVelocity
		local speed = velocity.Magnitude
		if State.camMode == "fpv" then
			local base = primary.CFrame
			if d.cameraPart then
				base = d.cameraPart.CFrame
			end
			local pos = base.Position + base.LookVector * 2.6
			camera.CFrame = CFrame.lookAt(pos, pos + base.LookVector * 100, base.UpVector)
				* Effects.shakeCFrame(dt)
			camera.FieldOfView = 90
		else
			local dist = State.camDist * (1 + math.clamp(speed / 900, 0, 0.16))
			local rot = CFrame.fromEulerAnglesYXZ(math.rad(State.camPitch), math.rad(State.camYaw), 0)
			local targetPos = primary.Position + (rot * Vector3.new(0, 2.4, dist))
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { d.model, Effects.folder() }
			local res = Workspace:Raycast(primary.Position, targetPos - primary.Position, params)
			if res then
				targetPos = res.Position + res.Normal * 2.2
			end
			camPos = camPos:Lerp(targetPos, math.clamp(dt * 6.5, 0, 1))
			local lookAt = primary.Position + velocity * 0.08 + Vector3.new(0, 1.4, 0)
			camLook = camLook:Lerp(lookAt, math.clamp(dt * 9, 0, 1))
			camera.CFrame = CFrame.lookAt(camPos, camLook) * Effects.shakeCFrame(dt)
			camera.FieldOfView = lerp(camera.FieldOfView, 76 + math.clamp(speed / 9, 0, 13), dt * 3)
		end
		return
	end

	if State.role == "survivor" then
		camera.CameraType = Enum.CameraType.Custom
		return
	end

	-- наблюдатель: медленный облёт
	camera.CameraType = Enum.CameraType.Scriptable
	State.camYaw += dt * 5
	local radius = 320
	local pos = Vector3.new(math.sin(math.rad(State.camYaw)) * radius, 180,
		math.cos(math.rad(State.camYaw)) * radius)
	camPos = camPos:Lerp(pos, math.clamp(dt * 1.2, 0, 1))
	camLook = camLook:Lerp(Vector3.new(0, 40, 0), math.clamp(dt * 1.2, 0, 1))
	camera.CFrame = CFrame.lookAt(camPos, camLook) * Effects.shakeCFrame(dt)
	camera.FieldOfView = 76
end

-- --------------------------------------------------------------------------- --
-- Ввод
-- --------------------------------------------------------------------------- --
UserInputService.InputBegan:Connect(function(inp, processed)
	if inp.UserInputType == Enum.UserInputType.Keyboard then
		keys[inp.KeyCode] = true
		local code = inp.KeyCode
		if code == Enum.KeyCode.Tab then
			menu:toggleScoreboard()
			return
		end
		if processed then
			return
		end
		if State.role == "drone" then
			if code == Enum.KeyCode.F then
				ui:callToggleCamera()
			elseif code == Enum.KeyCode.X then
				ui:callBomb()
			elseif code == Enum.KeyCode.One then
				Rem.RequestDrone:FireServer("scout")
			elseif code == Enum.KeyCode.Two then
				Rem.RequestDrone:FireServer("gunship")
			end
		elseif State.role == "survivor" then
			if code == Enum.KeyCode.B then
				toggleBuild()
			elseif code == Enum.KeyCode.V then
				weapon:melee()
			elseif code == Enum.KeyCode.R then
				if State.buildMode then
					builder:rotate(45)
				else
					weapon:reload()
				end
			elseif State.buildMode then
				if code == Enum.KeyCode.One then
					State.plankTitle = builder:setPlank("wall").Title
				elseif code == Enum.KeyCode.Two then
					State.plankTitle = builder:setPlank("floor").Title
				elseif code == Enum.KeyCode.Three then
					State.plankTitle = builder:setPlank("ramp").Title
				end
			end
		end
	elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
		keys.fire = true
	elseif inp.UserInputType == Enum.UserInputType.MouseButton2 then
		if State.role == "survivor" and not State.buildMode then
			weapon:melee()
		end
	end
end)

UserInputService.InputEnded:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.Keyboard then
		keys[inp.KeyCode] = false
	elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
		keys.fire = false
	end
end)

UserInputService.InputChanged:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseWheel then
		State.camDist = math.clamp(State.camDist - inp.Position.Z * 3, 16, 84)
	end
end)

-- --------------------------------------------------------------------------- --
-- Главный цикл
-- --------------------------------------------------------------------------- --
local buildCountPrune = 0

RunService.RenderStepped:Connect(function(dt)
	if State.role == "drone" and State.alive then
		stepFlight(dt)
	end

	if State.role == "survivor" then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local alive = humanoid and humanoid.Health &gt; 0
		if alive then
			if player.CameraMode ~= Enum.CameraMode.LockFirstPerson then
				player.CameraMode = Enum.CameraMode.LockFirstPerson
			end
			if not weapon.enabled then
				weapon:attach()
			end
			if State.buildMode then
				builder:update(dt, camera)
				local wantsPlace = keys.fire == true or ui:getVirtualInput().fire == true
				if wantsPlace and builder.valid and os.clock() - State.lastPlace &gt; 0.18 then
					if builder:place() then
						State.lastPlace = os.clock()
						Effects.impact(builder.targetCF.Position, Vector3.yAxis,
							Color3.fromRGB(180, 150, 110))
					end
				end
			end
			local firing = (keys.fire == true or ui:getVirtualInput().fire == true)
				and not State.buildMode
			weapon:update(dt, firing)
			ui:update({
				health = humanoid.Health,
				maxHealth = humanoid.MaxHealth,
				ammo = State.ammo,
				magazine = State.magazine,
				reloading = State.reloading,
				buildMode = State.buildMode,
				buildCount = State.buildCount,
				buildMax = Config.Building.MaxParts,
				plankTitle = State.plankTitle,
			})
		elseif weapon.enabled then
			weapon:detach()
		end
	else
		State.buildMode = false
	end

	updateCamera(dt)
end)

-- --------------------------------------------------------------------------- --
-- Старт
-- --------------------------------------------------------------------------- --
camera.CameraType = Enum.CameraType.Scriptable
ui:setVisible(false)
ui:setRole("drone")
weapon:detach()
Effects.addShake(0)
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3592">
        <Properties>
          <string name="Name">DroneUI</string>
          <string name="Source">--!nonstrict
--[[
	DroneUI -- HUD игры: здоровье, миниган/перегрев, патроны выжившего,
	скорость и высота, прицел, хитмаркер, лента убийств, баннеры, вспышки
	урона, выбор дрона, подсказки строительства и сенсорное управление.

	Собирается целиком кодом -- ни одной картинки.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local DroneUI = {}
DroneUI.__index = DroneUI

local ACCENT = Color3.fromRGB(255, 138, 60)
local CYAN = Color3.fromRGB(120, 225, 255)
local RED = Color3.fromRGB(255, 92, 86)
local GREEN = Color3.fromRGB(126, 240, 160)
local AMBER = Color3.fromRGB(255, 200, 90)
local PANEL = Color3.fromRGB(12, 12, 18)
local TEXT = Color3.fromRGB(240, 240, 246)
local MUTED = Color3.fromRGB(150, 152, 168)

-- --------------------------------------------------------------------------- --
local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or ACCENT
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0.2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function label(parent, text, size, position, color, font, scaled)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = position or UDim2.fromScale(0, 0)
	l.Text = text
	l.TextColor3 = color or TEXT
	l.Font = font or Enum.Font.GothamBold
	l.TextScaled = scaled ~= false
	l.TextStrokeTransparency = 0.65
	l.Parent = parent
	return l
end

local function bar(parent, size, position, color)
	local holder = Instance.new("Frame")
	holder.Size = size
	holder.Position = position
	holder.BackgroundColor3 = Color3.fromRGB(26, 28, 36)
	holder.BackgroundTransparency = 0.2
	holder.BorderSizePixel = 0
	holder.Parent = parent
	corner(holder, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = holder
	corner(fill, 6)

	local grad = Instance.new("UIGradient")
	grad.Rotation = 0
	grad.Color = ColorSequence.new(color, Color3.fromRGB(
		math.floor(color.R * 255 * 0.55),
		math.floor(color.G * 255 * 0.55),
		math.floor(color.B * 255 * 0.55)))
	grad.Parent = fill

	return fill, holder
end

-- --------------------------------------------------------------------------- --
function DroneUI.new(callbacks)
	local self = setmetatable({}, DroneUI)
	self.callbacks = callbacks or {}
	self.drone = nil
	self.role = "drone"
	self.virtual = { x = 0, y = 0, yaw = 0, up = 0, fire = false }
	self.heat = 0
	self.hitmarkerUntil = 0
	self.bannerToken = 0
	self.feedLines = {}

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "DroneHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 30
	gui.Enabled = true
	gui.Parent = playerGui
	self.gui = gui

	-- ------------------------------------------------------------- прицел
	local cross = Instance.new("Frame")
	cross.Name = "Crosshair"
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(120, 120)
	cross.BackgroundTransparency = 1
	cross.Parent = gui
	self.cross = cross

	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(4, 4)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.BackgroundColor3 = CYAN
	dot.BorderSizePixel = 0
	dot.Parent = cross
	corner(dot, 2)

	self.crossTicks = {}
	for i = 1, 4 do
		local tick = Instance.new("Frame")
		tick.BackgroundColor3 = TEXT
		tick.BorderSizePixel = 0
		tick.AnchorPoint = Vector2.new(0.5, 0.5)
		tick.BackgroundTransparency = 0.15
		if i == 1 then
			tick.Size = UDim2.fromOffset(2, 14)
			tick.Position = UDim2.new(0.5, 0, 0.5, -20)
		elseif i == 2 then
			tick.Size = UDim2.fromOffset(2, 14)
			tick.Position = UDim2.new(0.5, 0, 0.5, 20)
		elseif i == 3 then
			tick.Size = UDim2.fromOffset(14, 2)
			tick.Position = UDim2.new(0.5, -20, 0.5, 0)
		else
			tick.Size = UDim2.fromOffset(14, 2)
			tick.Position = UDim2.new(0.5, 20, 0.5, 0)
		end
		tick.Parent = cross
		table.insert(self.crossTicks, tick)
	end

	-- хитмаркер
	local hit = Instance.new("Frame")
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Size = UDim2.fromOffset(46, 46)
	hit.BackgroundTransparency = 1
	hit.Parent = gui
	self.hitFrame = hit
	self.hitTicks = {}
	for i = 1, 4 do
		local t = Instance.new("Frame")
		t.BackgroundColor3 = Color3.fromRGB(255, 245, 220)
		t.BorderSizePixel = 0
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Size = UDim2.fromOffset(2, 10)
		t.BackgroundTransparency = 1
		local ax = (i % 2 == 1) and -1 or 1
		local ay = (i &lt;= 2) and -1 or 1
		t.Position = UDim2.new(0.5, ax * 14, 0.5, ay * 14)
		t.Rotation = (i % 2 == 1) and 45 or -45
		t.Parent = hit
		table.insert(self.hitTicks, t)
	end

	-- ------------------------------------------------------------- здоровье
	local healthPanel = Instance.new("Frame")
	healthPanel.Name = "Health"
	healthPanel.Size = UDim2.fromScale(0.26, 0.13)
	healthPanel.Position = UDim2.fromScale(0.018, 0.83)
	healthPanel.BackgroundColor3 = PANEL
	healthPanel.BackgroundTransparency = 0.25
	healthPanel.BorderSizePixel = 0
	healthPanel.Parent = gui
	corner(healthPanel, 12)
	stroke(healthPanel, RED, 1.5, 0.55)
	self.healthPanel = healthPanel

	self.roleChip = label(healthPanel, "ДРОН", UDim2.new(1, -20, 0, 20),
		UDim2.fromOffset(10, 8), CYAN, Enum.Font.GothamBlack)
	self.roleChip.TextXAlignment = Enum.TextXAlignment.Left

	self.healthFill, self.healthHolder = bar(healthPanel, UDim2.new(1, -20, 0, 16),
		UDim2.fromOffset(10, 30), GREEN)
	self.healthText = label(healthPanel, "100", UDim2.new(1, -20, 0, 22),
		UDim2.fromOffset(10, 50), TEXT, Enum.Font.GothamBlack)
	self.healthText.TextXAlignment = Enum.TextXAlignment.Left

	self.droneTitle = label(healthPanel, "РАЗВЕДЧИК", UDim2.new(1, -20, 0, 18),
		UDim2.new(0, 10, 1, -22), MUTED, Enum.Font.GothamMedium)
	self.droneTitle.TextXAlignment = Enum.TextXAlignment.Left

	-- ------------------------------------------------------------- оружие
	local weaponPanel = Instance.new("Frame")
	weaponPanel.Name = "Weapon"
	weaponPanel.Size = UDim2.fromScale(0.26, 0.13)
	weaponPanel.Position = UDim2.fromScale(0.722, 0.83)
	weaponPanel.BackgroundColor3 = PANEL
	weaponPanel.BackgroundTransparency = 0.25
	weaponPanel.BorderSizePixel = 0
	weaponPanel.Parent = gui
	corner(weaponPanel, 12)
	stroke(weaponPanel, ACCENT, 1.5, 0.55)
	self.weaponPanel = weaponPanel

	self.weaponName = label(weaponPanel, "МИНИГАН", UDim2.new(1, -20, 0, 20),
		UDim2.fromOffset(10, 8), TEXT, Enum.Font.GothamBlack)
	self.weaponName.TextXAlignment = Enum.TextXAlignment.Left

	self.heatFill = bar(weaponPanel, UDim2.new(1, -20, 0, 16), UDim2.fromOffset(10, 30), ACCENT)
	self.heatText = label(weaponPanel, "0%", UDim2.new(1, -20, 0, 22),
		UDim2.fromOffset(10, 50), TEXT, Enum.Font.GothamBlack)
	self.heatText.TextXAlignment = Enum.TextXAlignment.Left

	self.ammoText = label(weaponPanel, "", UDim2.new(1, -20, 0, 22),
		UDim2.new(0, 10, 1, -24), MUTED, Enum.Font.GothamBlack)
	self.ammoText.TextXAlignment = Enum.TextXAlignment.Right

	self.buildHint = label(weaponPanel, "", UDim2.new(1, -20, 0, 20),
		UDim2.new(0, 10, 1, -24), GREEN, Enum.Font.GothamMedium)
	self.buildHint.TextXAlignment = Enum.TextXAlignment.Left

	-- ------------------------------------------------------------- телеметрия
	local telemetry = Instance.new("Frame")
	telemetry.Name = "Telemetry"
	telemetry.Size = UDim2.fromScale(0.17, 0.1)
	telemetry.Position = UDim2.fromScale(0.815, 0.7)
	telemetry.BackgroundColor3 = PANEL
	telemetry.BackgroundTransparency = 0.35
	telemetry.BorderSizePixel = 0
	telemetry.Parent = gui
	corner(telemetry, 10)
	stroke(telemetry, CYAN, 1.2, 0.6)

	self.speedText = label(telemetry, "0", UDim2.new(0.5, -8, 0, 26),
		UDim2.fromOffset(8, 6), TEXT, Enum.Font.GothamBlack)
	self.speedText.TextXAlignment = Enum.TextXAlignment.Left
	self.speedUnit = label(telemetry, "СКОРОСТЬ", UDim2.new(0.5, -8, 0, 14),
		UDim2.new(0.5, 0, 0, 10), MUTED, Enum.Font.GothamMedium)
	self.speedUnit.TextXAlignment = Enum.TextXAlignment.Left
	self.altText = label(telemetry, "0", UDim2.new(0.5, -8, 0, 26),
		UDim2.new(0, 8, 0, 40), TEXT, Enum.Font.GothamBlack)
	self.altText.TextXAlignment = Enum.TextXAlignment.Left
	self.altUnit = label(telemetry, "ВЫСОТА", UDim2.new(0.5, -8, 0, 14),
		UDim2.new(0.5, 0, 0, 44), MUTED, Enum.Font.GothamMedium)
	self.altUnit.TextXAlignment = Enum.TextXAlignment.Left

	-- ------------------------------------------------------------- баннер
	self.banner = label(gui, "", UDim2.fromScale(0.7, 0.09), UDim2.fromScale(0.15, 0.14),
		TEXT, Enum.Font.GothamBlack)
	self.banner.TextTransparency = 1
	self.banner.TextStrokeTransparency = 1

	self.modeLine = label(gui, "", UDim2.fromScale(0.6, 0.035),
		UDim2.fromScale(0.2, 0.235), MUTED, Enum.Font.GothamMedium)
	self.modeLine.TextTransparency = 1

	-- ------------------------------------------------------------- лента убийств
	local feedFrame = Instance.new("Frame")
	feedFrame.Name = "Feed"
	feedFrame.Size = UDim2.fromScale(0.3, 0.2)
	feedFrame.Position = UDim2.fromScale(0.685, 0.02)
	feedFrame.BackgroundTransparency = 1
	feedFrame.Parent = gui
	self.feedFrame = feedFrame
	local feedLayout = Instance.new("UIListLayout")
	feedLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	feedLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	feedLayout.Padding = UDim.new(0, 4)
	feedLayout.Parent = feedFrame

	-- ------------------------------------------------------------- вспышка урона
	self.vignette = {}
	for i = 1, 4 do
		local side = Instance.new("Frame")
		side.BackgroundColor3 = RED
		side.BorderSizePixel = 0
		side.BackgroundTransparency = 1
		side.ZIndex = 2
		if i == 1 or i == 2 then
			side.Size = UDim2.fromScale(1, 0.16)
			side.Position = UDim2.fromScale(0, (i == 1) and 0 or 0.84)
		else
			side.Size = UDim2.fromScale(0.16, 1)
			side.Position = UDim2.fromScale((i == 3) and 0 or 0.84, 0)
		end
		local grad = Instance.new("UIGradient")
		grad.Rotation = (i == 1) and 90 or ((i == 2) and 270 or ((i == 3) and 0 or 180))
		grad.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		grad.Parent = side
		side.Parent = gui
		table.insert(self.vignette, side)
	end

	-- ------------------------------------------------------------- выбор дрона
	local picker = Instance.new("Frame")
	picker.Name = "DronePicker"
	picker.Size = UDim2.fromScale(0.26, 0.055)
	picker.Position = UDim2.fromScale(0.37, 0.93)
	picker.BackgroundTransparency = 1
	picker.Parent = gui
	local pickerLayout = Instance.new("UIListLayout")
	pickerLayout.FillDirection = Enum.FillDirection.Horizontal
	pickerLayout.Padding = UDim.new(0, 8)
	pickerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	pickerLayout.Parent = picker
	self.pickerButtons = {}
	self.pickerFrame = picker

	local drones = { { id = "scout", title = "1  РАЗВЕДЧИК" }, { id = "gunship", title = "2  ШТУРМОВИК" } }
	for _, info in ipairs(drones) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromScale(0.46, 1)
		b.BackgroundColor3 = PANEL
		b.BackgroundTransparency = 0.25
		b.Text = info.title
		b.TextColor3 = TEXT
		b.Font = Enum.Font.GothamBold
		b.TextScaled = true
		b.Parent = picker
		corner(b, 8)
		stroke(b, CYAN, 1.5, 0.6)
		b.MouseButton1Click:Connect(function()
			if self.callbacks.onSwitchDrone then
				self.callbacks.onSwitchDrone(info.id)
			end
		end)
		self.pickerButtons[info.id] = b
	end

	-- ------------------------------------------------------------- сенсор
	self.touchEnabled = UserInputService.TouchEnabled
	if self.touchEnabled then
		self:buildTouchControls(gui)
	end

	-- эмуляция «патронов» для выжившего: строка
	self.ammoValue = 30
	self.ammoMax = 30

	return self
end

-- --------------------------------------------------------------------------- --
-- сенсорное управление
-- --------------------------------------------------------------------------- --
function DroneUI:makeStick(parent, position, onMove)
	local base = Instance.new("Frame")
	base.AnchorPoint = Vector2.new(0.5, 0.5)
	base.Position = position
	base.Size = UDim2.fromOffset(170, 170)
	base.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	base.BackgroundTransparency = 0.45
	base.BorderSizePixel = 0
	base.Parent = parent
	corner(base, 85)
	stroke(base, CYAN, 2, 0.5)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.Size = UDim2.fromOffset(66, 66)
	knob.BackgroundColor3 = CYAN
	knob.BackgroundTransparency = 0.15
	knob.BorderSizePixel = 0
	knob.Parent = base
	corner(knob, 33)

	local active = false
	local center = Vector2.zero

	local function update(input)
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		local delta = pos - center
		local radius = 85
		if delta.Magnitude &gt; radius then
			delta = delta.Unit * radius
		end
		knob.Position = UDim2.fromScale(0.5 + delta.X / 170, 0.5 + delta.Y / 170)
		onMove(delta.X / radius, delta.Y / radius)
	end

	base.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			active = true
			local abs = base.AbsolutePosition
			center = Vector2.new(abs.X + base.AbsoluteSize.X / 2, abs.Y + base.AbsoluteSize.Y / 2)
			update(input)
		end
	end)
	base.InputChanged:Connect(function(input)
		if active and (input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement) then
			update(input)
		end
	end)
	base.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			active = false
			knob.Position = UDim2.fromScale(0.5, 0.5)
			onMove(0, 0)
		end
	end)
	return base
end

function DroneUI:buildTouchControls(gui)
	local self2 = self
	self:makeStick(gui, UDim2.new(0, 130, 1, -180), function(x, y)
		self2.virtual.x = x
		self2.virtual.y = -y
	end)
	self:makeStick(gui, UDim2.new(1, -130, 1, -180), function(x, y)
		self2.virtual.yaw = x
		self2.virtual.up = -y
	end)

	local fire = Instance.new("TextButton")
	fire.Size = UDim2.fromOffset(120, 120)
	fire.AnchorPoint = Vector2.new(0.5, 0.5)
	fire.Position = UDim2.new(1, -250, 1, -160)
	fire.BackgroundColor3 = ACCENT
	fire.BackgroundTransparency = 0.25
	fire.Text = "ОГОНЬ"
	fire.TextColor3 = Color3.fromRGB(24, 10, 6)
	fire.Font = Enum.Font.GothamBlack
	fire.TextScaled = true
	fire.Parent = gui
	corner(fire, 60)
	stroke(fire, Color3.fromRGB(255, 210, 160), 3, 0.2)

	fire.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			self.virtual.fire = true
		end
	end)
	fire.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			self.virtual.fire = false
		end
	end)

	local function smallButton(text, position, color, callback)
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(82, 82)
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = position
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.3
		b.Text = text
		b.TextColor3 = TEXT
		b.Font = Enum.Font.GothamBlack
		b.TextScaled = true
		b.Parent = gui
		corner(b, 41)
		stroke(b, TEXT, 2, 0.4)
		b.MouseButton1Click:Connect(callback)
		return b
	end

	self.touchBomb = smallButton("БОМБА", UDim2.new(1, -260, 1, -300), Color3.fromRGB(60, 30, 20),
		function()
			self:callBomb()
		end)
	self.touchBuild = smallButton("СТРОЙ", UDim2.new(1, -360, 1, -120), Color3.fromRGB(24, 60, 40),
		function()
			self:callBuild()
		end)
	self.touchCamera = smallButton("ВИД", UDim2.new(0, 250, 1, -110), Color3.fromRGB(28, 30, 42),
		function()
			self:callToggleCamera()
		end)
end

-- --------------------------------------------------------------------------- --
-- API
-- --------------------------------------------------------------------------- --
function DroneUI:setVisible(value)
	self.gui.Enabled = value
end

function DroneUI:setRole(role)
	self.role = role or "drone"
	local survivor = self.role == "survivor"
	self.roleChip.Text = survivor and "ВЫЖИВШИЙ" or "ДРОН"
	self.roleChip.TextColor3 = survivor and AMBER or CYAN
	self.weaponName.Text = survivor and "ВИНТОВКА" or "МИНИГАН"
	self.pickerFrame.Visible = not survivor
	if self.touchBomb then
		self.touchBomb.Visible = (not survivor) and self.touchEnabled or false
	end
	if self.touchBuild then
		self.touchBuild.Visible = survivor and self.touchEnabled or false
	end
	self.altText.Visible = not survivor
	self.altUnit.Visible = not survivor
end

function DroneUI:setDrone(cfg)
	self.drone = cfg
	if cfg then
		self.droneTitle.Text = cfg.Title
		for id, btn in pairs(self.pickerButtons) do
			local active = (id == cfg.Id)
			btn.BackgroundColor3 = active and Color3.fromRGB(30, 40, 52) or PANEL
			btn.TextColor3 = active and CYAN or MUTED
		end
	end
end

function DroneUI:setMode(text)
	self.modeLine.Text = text or ""
	self.modeLine.TextTransparency = text and 0.25 or 1
end

function DroneUI:banner(text, duration)
	self.bannerToken += 1
	local token = self.bannerToken
	self.banner.Text = text
	self.banner.TextTransparency = 0
	self.banner.TextStrokeTransparency = 0.4
	self.banner.Size = UDim2.fromScale(0.7, 0.06)
	TweenService:Create(self.banner, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
		Size = UDim2.fromScale(0.7, 0.09),
	}):Play()
	task.delay(duration or 3, function()
		if self.bannerToken == token then
			TweenService:Create(self.banner, TweenInfo.new(0.4), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			}):Play()
		end
	end)
end

function DroneUI:toast(text, color)
	local line = label(self.feedFrame, text, UDim2.fromScale(1, 0), UDim2.fromScale(0, 0),
		color or TEXT, Enum.Font.GothamMedium)
	line.AutomaticSize = Enum.AutomaticSize.Y
	line.Size = UDim2.fromScale(1, 0)
	line.TextYAlignment = Enum.TextYAlignment.Top
	TweenService:Create(line, TweenInfo.new(0.25), { TextTransparency = 0.2 }):Play()
	task.delay(3.2, function()
		TweenService:Create(line, TweenInfo.new(0.5), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
		task.delay(0.5, function()
			line:Destroy()
		end)
	end)
end

function DroneUI:feed(text, color)
	self:toast(text, color)
end

function DroneUI:damageFlash(heal)
	local color = heal and GREEN or RED
	for _, side in ipairs(self.vignette) do
		side.BackgroundColor3 = color
		side.BackgroundTransparency = 0.35
		TweenService:Create(side, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
	end
end

function DroneUI:hitmarker()
	for _, tick in ipairs(self.hitTicks) do
		tick.BackgroundTransparency = 0.05
		TweenService:Create(tick, TweenInfo.new(0.22), { BackgroundTransparency = 1 }):Play()
	end
end

function DroneUI:getVirtualInput()
	return self.virtual
end

function DroneUI:callBomb()
	if self.callbacks.onBomb then
		self.callbacks.onBomb()
	end
end

function DroneUI:callToggleCamera()
	if self.callbacks.onToggleCamera then
		self.callbacks.onToggleCamera()
	end
end

function DroneUI:callBuild()
	if self.callbacks.onBuildToggle then
		self.callbacks.onBuildToggle()
	end
end

-- --------------------------------------------------------------------------- --
function DroneUI:update(s)
	if not s then
		return
	end
	local hp = math.clamp(s.health or 0, 0, s.maxHealth or 100)
	local frac = hp / math.max(1, s.maxHealth or 100)
	self.healthFill.Size = UDim2.fromScale(frac, 1)
	self.healthFill.BackgroundColor3 = (frac &lt; 0.3) and RED or ((frac &lt; 0.6) and AMBER or GREEN)
	self.healthText.Text = string.format("%d / %d", math.floor(hp), math.floor(s.maxHealth or 100))

	if self.role == "survivor" then
		local ammo = s.ammo or 0
		local mag = s.magazine or 30
		self.heatFill.Size = UDim2.fromScale(ammo / math.max(1, mag), 1)
		self.heatFill.BackgroundColor3 = s.reloading and AMBER or CYAN
		self.heatText.Text = s.reloading and "ПЕРЕЗАРЯДКА"
			or string.format("%d / %d", math.floor(ammo), math.floor(mag))
		self.ammoText.Text = s.buildMode and
			string.format("ДОСКИ %d/%d   [%s]", s.buildCount or 0, s.buildMax or 0,
				s.plankTitle or "") or "[B] СТРОЙКА   [V] НОЖ"
		self.buildHint.Text = s.buildMode and "ЛКМ — поставить   R — повернуть   1-3 — тип" or ""
		self.altText.Text = ""
		self.speedText.Text = ""
	else
		local heat = math.clamp(s.heat or 0, 0, 1)
		self.heat = heat
		self.heatFill.Size = UDim2.fromScale(heat, 1)
		self.heatFill.BackgroundColor3 = heat &gt; 0.85 and RED
			or (s.overheated and AMBER or ACCENT)
		self.heatText.Text = s.overheated and "ПЕРЕГРЕВ"
			or string.format("НАГРЕВ %d%%", math.floor(heat * 100))
		self.ammoText.Text = s.bombLabel or "∞"
		self.buildHint.Text = ""
		local speed = s.speed or 0
		self.speedText.Text = tostring(math.floor(speed))
		self.altText.Text = tostring(math.floor(s.altitude or 0))
		-- прицел «дышит» от нагрева
		local spread = 18 + heat * 16
		for i, tick in ipairs(self.crossTicks) do
			local x = (i == 3) and -spread or ((i == 4) and spread or 0)
			local y = (i == 1) and -spread or ((i == 2) and spread or 0)
			tick.Position = UDim2.new(0.5, x, 0.5, y)
		end
	end
end

return DroneUI
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3593">
        <Properties>
          <string name="Name">MenuUI</string>
          <string name="Source">--!nonstrict
--[[
	MenuUI -- меню игры: стартовый экран, выбор стороны, голосование за режим,
	экран итогов, верхняя панель с таймером и таблица счёта (Tab).

	Всё собирается кодом, никаких ассетов.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("DroneConfig"))
local GameData = require(game:GetService("ReplicatedStorage"):WaitForChild("GameData"))

local MenuUI = {}
MenuUI.__index = MenuUI

local BG = Color3.fromRGB(10, 10, 14)
local PANEL = Color3.fromRGB(18, 19, 26)
local ACCENT = Color3.fromRGB(255, 120, 52)
local ACCENT2 = Color3.fromRGB(120, 225, 255)
local TEXT = Color3.fromRGB(238, 238, 244)
local MUTED = Color3.fromRGB(150, 152, 168)

-- --------------------------------------------------------------------------- --
-- помощники
-- --------------------------------------------------------------------------- --
local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or ACCENT
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function label(parent, text, size, color, font, scaled)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Text = text
	l.TextColor3 = color or TEXT
	l.Font = font or Enum.Font.GothamBold
	l.TextScaled = scaled ~= false
	l.TextStrokeTransparency = 0.6
	l.Parent = parent
	return l
end

local function button(parent, text, size, color)
	local b = Instance.new("TextButton")
	b.Size = size
	b.BackgroundColor3 = color or Color3.fromRGB(30, 32, 42)
	b.Text = text
	b.TextColor3 = TEXT
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.AutoButtonColor = true
	b.Parent = parent
	corner(b, 10)
	stroke(b, ACCENT, 2, 0.35)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = b
	return b
end

local function formatTime(sec)
	sec = math.max(0, math.floor(sec or 0))
	return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end

local function modeById(id)
	for _, m in ipairs(GameData.Modes) do
		if m.Id == id then
			return m
		end
	end
	return GameData.Modes[1]
end

local function mapById(id)
	for _, m in ipairs(GameData.Maps) do
		if m.Id == id then
			return m
		end
	end
	return GameData.Maps[1]
end

-- --------------------------------------------------------------------------- --
-- создание
-- --------------------------------------------------------------------------- --
function MenuUI.new(callbacks)
	local self = setmetatable({}, MenuUI)
	self.callbacks = callbacks or {}
	self.voteButtons = {}
	self.modeCards = {}
	self.roleCards = {}
	self.selectedRole = "auto"
	self.snapshot = nil
	self.mine = nil
	self.phase = "Menu"

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "DroneMenu"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 40
	gui.Enabled = true
	gui.Parent = playerGui
	self.gui = gui

	-- ------------------------------------------------------------- фон меню
	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = BG
	backdrop.BackgroundTransparency = 0.15
	backdrop.BorderSizePixel = 0
	backdrop.Visible = true
	backdrop.Parent = gui
	self.backdrop = backdrop

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(6, 8, 16)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(26, 14, 22)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 22, 14)),
	})
	gradient.Parent = backdrop

	-- неоновые линии для стиля
	for i = 1, 5 do
		local line = Instance.new("Frame")
		line.BackgroundColor3 = (i % 2 == 0) and ACCENT or ACCENT2
		line.BackgroundTransparency = 0.72
		line.BorderSizePixel = 0
		line.Size = UDim2.fromOffset(900, 2)
		line.Position = UDim2.fromScale(0.5, 0.16 + i * 0.13)
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Rotation = -8 + i * 3
		line.Parent = backdrop
	end

	-- ------------------------------------------------------------- заголовок
	local title = label(backdrop, "ДРОНЫ", UDim2.fromScale(1, 0.14), TEXT,
		Enum.Font.GothamBlack)
	title.Position = UDim2.fromScale(0, 0.09)
	title.TextScaled = true
	local tGrad = Instance.new("UIGradient")
	tGrad.Rotation = 90
	tGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 210)),
		ColorSequenceKeypoint.new(1, ACCENT),
	})
	tGrad.Parent = title

	local subtitle = label(backdrop, "АРЕНА НАД БЕЗДНОЙ  •  КООПЕРАТИВНЫЕ РЕЖИМЫ",
		UDim2.fromScale(0.8, 0.035), MUTED, Enum.Font.GothamMedium)
